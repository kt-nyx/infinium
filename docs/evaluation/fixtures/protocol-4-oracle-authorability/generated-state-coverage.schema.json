{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinium.local/schemas/protocol-4-generated-state-coverage.schema.json",
  "title": "Protocol /4 model-derived answer-free state coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_id", "artifact_version", "status", "work_id",
    "source_model", "generation", "state_space_proof", "state_cases",
    "admitted_state_mappings", "constraint_mappings", "pairwise_mappings",
    "family_mappings", "state_class_mappings", "rule_mappings",
    "disposition_mappings", "constructor_mappings", "atomic_boundary_mappings",
    "lexical_cases", "gap_exercises", "coverage_exercises",
    "transition_mappings", "higher_order_cases", "category_coverage",
    "existing_authorability_mutations", "wp3_mutations", "answer_isolation",
    "summary"
  ],
  "properties": {
    "$schema": { "const": "generated-state-coverage.schema.json" },
    "schema_id": { "const": "infinium.evaluation.protocol-4-model-derived-state-coverage/v1" },
    "artifact_version": { "const": "1.1.0" },
    "status": { "const": "answer-free-generated-coverage" },
    "work_id": { "const": "M1/S4.5/PRE-B2/WP3" },
    "source_model": { "$ref": "#/$defs/source_model" },
    "generation": { "$ref": "#/$defs/generation" },
    "state_space_proof": { "$ref": "#/$defs/state_space_proof" },
    "state_cases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/state_case" } },
    "admitted_state_mappings": { "type": "array", "minItems": 110, "maxItems": 110, "uniqueItems": true, "items": { "$ref": "#/$defs/admitted_state_mapping" } },
    "constraint_mappings": { "type": "array", "minItems": 236, "maxItems": 236, "uniqueItems": true, "items": { "$ref": "#/$defs/constraint_mapping" } },
    "pairwise_mappings": { "type": "array", "minItems": 1713, "maxItems": 1713, "uniqueItems": true, "items": { "$ref": "#/$defs/pairwise_mapping" } },
    "family_mappings": { "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": { "$ref": "#/$defs/family_mapping" } },
    "state_class_mappings": { "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": { "$ref": "#/$defs/state_class_mapping" } },
    "rule_mappings": { "type": "array", "minItems": 77, "maxItems": 77, "uniqueItems": true, "items": { "$ref": "#/$defs/rule_mapping" } },
    "disposition_mappings": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/disposition_mapping" } },
    "constructor_mappings": { "type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true, "items": { "$ref": "#/$defs/constructor_mapping" } },
    "atomic_boundary_mappings": { "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true, "items": { "$ref": "#/$defs/atomic_boundary_mapping" } },
    "lexical_cases": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/lexical_case" } },
    "gap_exercises": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/gap_exercise" } },
    "coverage_exercises": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/coverage_exercise" } },
    "transition_mappings": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/transition_mapping" } },
    "higher_order_cases": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/higher_order_case" } },
    "category_coverage": { "$ref": "#/$defs/category_coverage" },
    "existing_authorability_mutations": { "$ref": "#/$defs/existing_authorability_mutations" },
    "wp3_mutations": { "type": "array", "minItems": 33, "maxItems": 33, "uniqueItems": true, "items": { "$ref": "#/$defs/wp3_mutation" } },
    "answer_isolation": { "$ref": "#/$defs/answer_isolation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "case_id": { "type": "string", "pattern": "^P4-WP3-STATE-[A-Z0-9-]+-[0-9]{4}$" },
    "lexical_case_id": { "type": "string", "pattern": "^P4-WP3-LEX-[0-9]{2}$" },
    "family": { "enum": ["result", "plugins", "override_chains", "npc_contributions", "race_contributions", "placed_reference_contributions", "allowlisted_fields", "npcs", "races", "placed_references", "face_gen", "taxonomy", "coverage", "gaps", "result_gaps"] },
    "state_class": { "enum": ["not-observed", "observed-undecodable", "decoded-null", "decoded-unresolved", "resolved", "semantic-applicable", "unsupported", "not-applicable", "terminal-rejection"] },
    "disposition": { "enum": ["accepted_unknown", "exact_value", "mixed_by_constructor", "no_fact", "omit", "terminal_rejection"] },
    "atomic_boundary": { "enum": ["AB-RESULT", "AB-FORMKEY", "AB-RECORD-FRAMING", "AB-LINK", "AB-PLACEMENT", "AB-ASSET", "AB-COVERAGE", "AB-GAP", "AB-TAXONOMY", "AB-FACTSET", "AB-TYPED-VALUE"] },
    "case_id_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/case_id" } },
    "lexical_case_id_array": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/lexical_case_id" } },
    "source_model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_version", "model_status", "sha256", "protocol_id", "projection_version"],
      "properties": {
        "model_id": { "const": "infinium.m1-slice4.protocol-4-evidence-contract" },
        "model_version": { "const": "1.2.0" }, "model_status": { "const": "proposed" },
        "sha256": { "$ref": "#/$defs/sha256" }, "protocol_id": { "const": "infinium.evaluator-v2/4" },
        "projection_version": { "const": "3.0.0" }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["generator", "generator_version", "deterministic", "answer_bearing_outputs_tracked", "selection_strategy"],
      "properties": {
        "generator": { "const": "eng/generate-m1-slice4-protocol4-state-coverage.ps1" },
        "generator_version": { "const": "1.1.0" }, "deterministic": { "const": true },
        "answer_bearing_outputs_tracked": { "const": false }, "selection_strategy": { "type": "string", "minLength": 1 }
      }
    },
    "totals": {
      "type": "object", "additionalProperties": false,
      "required": ["raw", "admitted", "excluded", "invalid", "uncovered", "overlap"],
      "properties": {
        "raw": { "type": "integer", "minimum": 0 }, "admitted": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 }, "invalid": { "type": "integer", "minimum": 0 },
        "uncovered": { "const": 0 }, "overlap": { "const": 0 }
      }
    },
    "family_proof": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "raw", "admitted", "excluded", "invalid", "uncovered", "overlap", "state_digest_sha256"],
      "properties": {
        "family": { "$ref": "#/$defs/family" }, "raw": { "type": "integer", "minimum": 1 },
        "admitted": { "type": "integer", "minimum": 0 }, "excluded": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 }, "uncovered": { "const": 0 }, "overlap": { "const": 0 },
        "state_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "state_space_proof": {
      "type": "object", "additionalProperties": false,
      "required": ["totals", "aggregate_state_digest_sha256", "families"],
      "properties": {
        "totals": { "$ref": "#/$defs/totals" }, "aggregate_state_digest_sha256": { "$ref": "#/$defs/sha256" },
        "families": { "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": { "$ref": "#/$defs/family_proof" } }
      }
    },
    "state_case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "family", "classification", "constraint_id", "state_class", "rule_id", "atomic_boundary", "dimensions", "selection_reasons", "matched_negative_case_id"],
      "properties": {
        "case_id": { "$ref": "#/$defs/case_id" }, "family": { "$ref": "#/$defs/family" },
        "classification": { "enum": ["admitted", "invalid", "excluded"] },
        "constraint_id": { "type": "string", "pattern": "^SC-[A-Z0-9-]+$" },
        "state_class": { "oneOf": [{ "$ref": "#/$defs/state_class" }, { "type": "null" }] },
        "rule_id": { "type": ["string", "null"], "pattern": "^P4-[A-Z0-9-]+$" },
        "atomic_boundary": { "oneOf": [{ "$ref": "#/$defs/atomic_boundary" }, { "type": "null" }] },
        "dimensions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "selection_reasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["admitted-state", "constraint-representative", "matched-negative", "pairwise"] } },
        "matched_negative_case_id": { "oneOf": [{ "$ref": "#/$defs/case_id" }, { "type": "null" }] }
      }
    },
    "admitted_state_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "state_key", "constraint_id", "rule_id", "case_id", "matched_negative_case_id"],
      "properties": {
        "family": { "$ref": "#/$defs/family" }, "state_key": { "type": "string", "pattern": "^[a-z_]+=[^;]+(;[a-z_]+=[^;]+)*$" },
        "constraint_id": { "type": "string", "pattern": "^SC-[A-Z0-9-]+$" }, "rule_id": { "type": "string", "pattern": "^P4-[A-Z0-9-]+$" },
        "case_id": { "$ref": "#/$defs/case_id" }, "matched_negative_case_id": { "$ref": "#/$defs/case_id" }
      }
    },
    "constraint_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["constraint_id", "family", "classification", "state_class", "atomic_boundary", "state_count", "representative_case_id"],
      "properties": {
        "constraint_id": { "type": "string", "pattern": "^SC-[A-Z0-9-]+$" }, "family": { "$ref": "#/$defs/family" },
        "classification": { "enum": ["admitted", "invalid", "excluded"] },
        "state_class": { "oneOf": [{ "$ref": "#/$defs/state_class" }, { "type": "null" }] },
        "atomic_boundary": { "oneOf": [{ "$ref": "#/$defs/atomic_boundary" }, { "type": "null" }] },
        "state_count": { "type": "integer", "minimum": 1 }, "representative_case_id": { "$ref": "#/$defs/case_id" }
      }
    },
    "pairwise_mapping": {
      "type": "object", "additionalProperties": false, "required": ["pair", "case_id"],
      "properties": { "pair": { "type": "string", "pattern": "^[a-z_]+\\|[a-z_]+=[^|]+\\|[a-z_]+=[^|]+$" }, "case_id": { "$ref": "#/$defs/case_id" } }
    },
    "family_mapping": {
      "type": "object", "additionalProperties": false, "required": ["family", "case_ids"],
      "properties": { "family": { "$ref": "#/$defs/family" }, "case_ids": { "$ref": "#/$defs/case_id_array" } }
    },
    "state_class_mapping": {
      "type": "object", "additionalProperties": false, "required": ["state_class", "case_ids"],
      "properties": { "state_class": { "$ref": "#/$defs/state_class" }, "case_ids": { "$ref": "#/$defs/case_id_array" } }
    },
    "rule_mapping": {
      "type": "object", "additionalProperties": false, "required": ["rule_id", "family", "case_ids"],
      "properties": { "rule_id": { "type": "string", "pattern": "^P4-[A-Z0-9-]+$" }, "family": { "$ref": "#/$defs/family" }, "case_ids": { "$ref": "#/$defs/case_id_array" } }
    },
    "disposition_mapping": {
      "type": "object", "additionalProperties": false, "required": ["disposition", "case_ids"],
      "properties": { "disposition": { "$ref": "#/$defs/disposition" }, "case_ids": { "$ref": "#/$defs/case_id_array" } }
    },
    "constructor_mapping": {
      "type": "object", "additionalProperties": false, "required": ["constructor_id", "family", "case_ids"],
      "properties": { "constructor_id": { "type": "string", "pattern": "^FC-[A-Z0-9-]+$" }, "family": { "$ref": "#/$defs/family" }, "case_ids": { "$ref": "#/$defs/case_id_array" } }
    },
    "atomic_boundary_mapping": {
      "type": "object", "additionalProperties": false, "required": ["atomic_boundary", "state_case_ids", "lexical_case_ids"],
      "properties": { "atomic_boundary": { "$ref": "#/$defs/atomic_boundary" }, "state_case_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/case_id" } }, "lexical_case_ids": { "$ref": "#/$defs/lexical_case_id_array" } },
      "anyOf": [{ "properties": { "state_case_ids": { "minItems": 1 } } }, { "properties": { "lexical_case_ids": { "minItems": 1 } } }]
    },
    "lexical_case": {
      "oneOf": [
        { "$ref": "#/$defs/lexical_formkey" }, { "$ref": "#/$defs/lexical_segment" }, { "$ref": "#/$defs/lexical_order" },
        { "$ref": "#/$defs/lexical_case_normalization" }, { "$ref": "#/$defs/lexical_number" }, { "$ref": "#/$defs/lexical_contribution" },
        { "$ref": "#/$defs/lexical_link" }, { "$ref": "#/$defs/lexical_path" }, { "$ref": "#/$defs/lexical_taxonomy" }, { "$ref": "#/$defs/lexical_gap" }
      ]
    },
    "lexical_formkey": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-01" }, "rule_id": { "const": "P4-NORM-FORMKEY" }, "atomic_boundary": { "const": "AB-FORMKEY" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["values", "negative"], "properties": { "values": { "$ref": "#/$defs/nonempty_string_array" }, "negative": { "$ref": "#/$defs/nonempty_string_array" } } } } },
    "lexical_segment": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-02" }, "rule_id": { "const": "P4-NORM-SEGMENT" }, "atomic_boundary": { "const": "AB-FACTSET" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["values", "negative"], "properties": { "values": { "$ref": "#/$defs/nonempty_string_array" }, "negative": { "$ref": "#/$defs/nonempty_string_array" } } } } },
    "lexical_order": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-03" }, "rule_id": { "const": "P4-NORM-ORDER" }, "atomic_boundary": { "const": "AB-FACTSET" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["sequences", "set_order"], "properties": { "sequences": { "$ref": "#/$defs/nonempty_string_array" }, "set_order": { "const": "ordinal" } } } } },
    "lexical_case_normalization": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-04" }, "rule_id": { "const": "P4-NORM-CASE" }, "atomic_boundary": { "const": "AB-FACTSET" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["plugin", "provider", "signature", "path"], "properties": { "plugin": { "type": "string" }, "provider": { "type": "string" }, "signature": { "type": "string" }, "path": { "type": "string" } } } } },
    "lexical_number": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-05" }, "rule_id": { "const": "P4-NORM-NUMBER" }, "atomic_boundary": { "const": "AB-TYPED-VALUE" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["integers", "numbers", "negative"], "properties": { "integers": { "$ref": "#/$defs/nonempty_string_array" }, "numbers": { "$ref": "#/$defs/nonempty_string_array" }, "negative": { "$ref": "#/$defs/nonempty_string_array" } } } } },
    "lexical_contribution": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-06" }, "rule_id": { "const": "P4-NORM-CONTRIBUTION" }, "atomic_boundary": { "const": "AB-FACTSET" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["source", "order", "record", "signature", "flags", "deleted", "compressed"], "properties": { "source": { "type": "string" }, "order": { "type": "integer", "minimum": 0 }, "record": { "type": "string" }, "signature": { "type": "string" }, "flags": { "type": "string" }, "deleted": { "type": "boolean" }, "compressed": { "type": "boolean" } } } } },
    "lexical_link": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-07" }, "rule_id": { "const": "P4-NORM-LINK" }, "atomic_boundary": { "const": "AB-LINK" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["fields", "components", "ordinal", "states"], "properties": { "fields": { "$ref": "#/$defs/nonempty_string_array" }, "components": { "$ref": "#/$defs/nonempty_string_array" }, "ordinal": { "type": "integer", "minimum": 0 }, "states": { "$ref": "#/$defs/nonempty_string_array" } } } } },
    "lexical_path": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-08" }, "rule_id": { "const": "P4-NORM-PATH" }, "atomic_boundary": { "const": "AB-ASSET" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["values"], "properties": { "values": { "$ref": "#/$defs/nonempty_string_array" } } } } },
    "lexical_taxonomy": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-09" }, "rule_id": { "const": "P4-NORM-TAXONOMY" }, "atomic_boundary": { "const": "AB-TAXONOMY" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["subject", "subject_type", "code_states"], "properties": { "subject": { "type": "string" }, "subject_type": { "type": "string" }, "code_states": { "$ref": "#/$defs/nonempty_string_array" } } } } },
    "lexical_gap": { "type": "object", "additionalProperties": false, "required": ["case_id", "rule_id", "atomic_boundary", "generic_inputs"], "properties": { "case_id": { "const": "P4-WP3-LEX-10" }, "rule_id": { "const": "P4-NORM-GAP" }, "atomic_boundary": { "const": "AB-GAP" }, "generic_inputs": { "type": "object", "additionalProperties": false, "required": ["population", "missing_capability", "affected_counts"], "properties": { "population": { "type": "string" }, "missing_capability": { "type": "string" }, "affected_counts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } } } } } },
    "nonempty_string_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "gap_exercise": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "gap_rule_id", "population_template", "missing_capability", "scope", "generic_bindings"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^P4-WP3-GAP-[0-9]{2}$" },
        "gap_rule_id": { "enum": ["P4-GAP-UNSUPPORTED-RECORD", "P4-GAP-UNSUPPORTED-FIELD", "P4-GAP-UNSUPPORTED-SHAPE", "P4-GAP-LOCALIZED", "P4-GAP-ARCHIVE", "P4-GAP-DISCOVERY", "P4-GAP-TEMPLATE", "P4-GAP-RACE"] },
        "population_template": { "enum": ["unsupported-records:{signature_lower}", "unsupported-fields:{signature_lower}:{field_lower}", "unsupported-shapes:{signature_lower}:{field_lower}", "localized-strings", "face-gen-archive-assets", "automatic-environment-discovery", "face-gen-applicability:template", "face-gen-applicability:race"] },
        "missing_capability": { "enum": ["allowlisted-record-family-semantics", "allowlisted-record-field-semantics", "allowlisted-record-shape-semantics", "archive-activation-and-member-precedence", "automatic-environment-discovery", "complete-template-traits-decision", "localized-string-resolution", "resolved-winning-race"] },
        "scope": { "const": "snapshot-and-result" },
        "generic_bindings": { "type": "object", "additionalProperties": false, "properties": { "signature_lower": { "const": "genr" }, "field_lower": { "const": "data" } } }
      }
    },
    "coverage_exercise": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "population", "zero_case_id", "complete_case_id", "incomplete_case_id", "no_snapshot_case_id", "invalid_case_id"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^P4-WP3-COVERAGE-[0-9]{2}$" },
        "population": { "enum": ["plugins", "npc-records", "race-records", "placed-reference-records", "unsupported-records", "face-gen-loose-assets", "face-gen-archive-assets", "localized-strings", "automatic-environment-discovery", "taxonomy-subjects"] },
        "zero_case_id": { "$ref": "#/$defs/case_id" }, "complete_case_id": { "$ref": "#/$defs/case_id" },
        "incomplete_case_id": { "$ref": "#/$defs/case_id" }, "no_snapshot_case_id": { "$ref": "#/$defs/case_id" }, "invalid_case_id": { "$ref": "#/$defs/case_id" }
      }
    },
    "rule_case_binding": {
      "type": "object", "additionalProperties": false, "required": ["rule_id", "case_id"],
      "properties": { "rule_id": { "type": "string", "pattern": "^P4-[A-Z0-9-]+$" }, "case_id": { "$ref": "#/$defs/case_id" } }
    },
    "transition_mapping": {
      "type": "object", "additionalProperties": false, "required": ["trace_id", "boundary", "rule_cases"],
      "properties": {
        "trace_id": { "enum": ["TRACE-STRUCTURAL-OBSERVED", "TRACE-OBSERVED-DECODED", "TRACE-DECODED-RESOLVED", "TRACE-RESOLVED-SEMANTIC", "TRACE-PARTIAL-RACE-DATA", "TRACE-ATOMIC-REJECTION"] },
        "boundary": { "enum": ["structural-to-observed", "observed-to-decoded", "decoded-to-resolved", "resolved-to-semantic", "partial-race-data", "atomic-rejection"] },
        "rule_cases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/rule_case_binding" } }
      }
    },
    "higher_order_case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "invariant_id", "trace_id", "rule_cases", "gap_owner_ids", "obligations"],
      "properties": {
        "case_id": { "const": "P4-WP3-HIGHER-ORDER-PARTIAL-RACE-DATA" }, "invariant_id": { "const": "INV-PARTIAL-RACE-DATA" },
        "trace_id": { "const": "TRACE-PARTIAL-RACE-DATA" },
        "rule_cases": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/rule_case_binding" } },
