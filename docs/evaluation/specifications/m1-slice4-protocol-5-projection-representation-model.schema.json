{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.m1-slice4.protocol-5-projection-representation-model.schema/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "model_id",
    "version",
    "status",
    "work_id",
    "semantic_authority",
    "composition_authority",
    "rule_ledger_authority",
    "protocol",
    "projection_object_policy",
    "source_inventory",
    "family_order",
    "state_class_representation",
    "family_contracts",
    "constructor_bindings",
    "rejection_classes",
    "invariants"
  ],
  "properties": {
    "schema_id": {
      "const": "infinium.m1-slice4.protocol-5-projection-representation-model.schema/v3"
    },
    "model_id": {
      "const": "infinium.m1-slice4.protocol-5-projection-representation"
    },
    "version": { "const": "1.2.0" },
    "status": { "const": "accepted" },
    "work_id": { "const": "M1/S4.5/PRE-B2/V5/WP1V" },
    "semantic_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "version", "sha256", "path", "immutable"],
      "properties": {
        "model_id": { "const": "infinium.m1-slice4.protocol-5-evidence-contract" },
        "version": { "const": "1.0.1" },
        "sha256": { "const": "3f375adcc59e436a75f14f8e46afcf0286bb202cb05fe256af6b679a726bab66" },
        "path": { "const": "docs/evaluation/specifications/m1-slice4-protocol-5-successor-model.json" },
        "immutable": { "const": true }
      }
    },
    "composition_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "path", "sha256", "composition_digest", "mandatory"],
      "properties": {
        "schema_id": { "const": "infinium.m1-slice4.protocol-5-global-composition-summary/1.2.0" },
        "path": { "const": "docs/evaluation/specifications/m1-slice4-protocol-5-global-composition-summary.json" },
        "sha256": { "const": "f137c39302db01a4d348f4ca5a8b9626cc38e604012d353fe4c25cc2e9e38b95" },
        "composition_digest": { "const": "cbea94aaed2dc20a329187a4ace76a2679605530613bdf647aac9018232795ee" },
        "mandatory": { "const": true }
      }
    },
    "rule_ledger_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "path", "sha256", "rules", "mandatory"],
      "properties": {
        "schema_id": { "const": "infinium.m1-slice4.protocol-5-rule-coverage-ledger/1.0.0" },
        "path": { "const": "docs/evaluation/specifications/m1-slice4-protocol-5-rule-coverage-ledger.json" },
        "sha256": { "const": "8d88061dbcd7d206533c2ed245861c3c823f6576cd9ade727050d75bb8e22904" },
        "rules": { "const": 77 },
        "mandatory": { "const": true }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "projection_id", "projection_version", "document_schema_id", "document_schema_path"],
      "properties": {
        "protocol_id": { "const": "infinium.evaluator-v2/5" },
        "projection_id": { "const": "infinium.evaluator-v2.slice4-semantic-projection" },
        "projection_version": { "const": "5.1.0" },
        "document_schema_id": { "const": "infinium.evaluator-v2.slice4-projection-document.schema/v5.2" },
        "document_schema_path": { "const": "docs/evaluation/specifications/m1-slice4-protocol-5-projection-document.schema.json" }
      }
    },
    "projection_object_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_provenance", "facegen_common_owner",
        "semantic_cardinality_ceiling", "override_contributions",
        "canonical_path_encoding", "published_coverage_rows",
        "no_snapshot_snapshot_families"
      ],
      "properties": {
        "rule_provenance": { "const": "exact-unique-ordinal-property-source-rule-set" },
        "facegen_common_owner": { "const": "mesh-before-tint-ordinal-first-applicable-path-rule" },
        "semantic_cardinality_ceiling": { "const": "none" },
        "override_contributions": { "const": "one-or-more-with-exactly-one-matching-winner" },
        "canonical_path_encoding": { "const": "literal-unreserved-ascii-or-uppercase-reserved-ascii-or-complete-uppercase-nonascii-utf8" },
        "published_coverage_rows": { "const": 10 },
        "no_snapshot_snapshot_families": { "const": "all-empty" }
      }
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["families", "state_classes", "dimensions", "publication_rules", "constructor_groups", "normalization_rules", "atomic_boundaries", "gap_rules", "coverage_populations", "admitted_states"],
      "properties": {
        "families": { "const": 15 },
        "state_classes": { "const": 9 },
        "dimensions": { "const": 21 },
        "publication_rules": { "const": 77 },
        "constructor_groups": { "const": 24 },
        "normalization_rules": { "const": 10 },
        "atomic_boundaries": { "const": 11 },
        "gap_rules": { "const": 9 },
        "coverage_populations": { "const": 10 },
        "admitted_states": { "const": 110 }
      }
    },
    "family_order": {
      "const": [
        "result", "plugins", "override_chains", "npc_contributions",
        "race_contributions", "placed_reference_contributions",
        "allowlisted_fields", "npcs", "races", "placed_references",
        "face_gen", "taxonomy", "coverage", "gaps", "result_gaps"
      ]
    },
    "state_class_representation": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/state_mapping" }
    },
    "family_contracts": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/family_contract" }
    },
    "constructor_bindings": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/constructor_binding" }
    },
    "rejection_classes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": ["schema", "identity", "constructor", "dependency", "normalization", "duplicate", "coverage", "gap", "atomic"]
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/invariant" }
    }
  },
  "$defs": {
    "family": {
      "enum": [
        "result", "plugins", "override_chains", "npc_contributions",
        "race_contributions", "placed_reference_contributions",
        "allowlisted_fields", "npcs", "races", "placed_references",
        "face_gen", "taxonomy", "coverage", "gaps", "result_gaps"
      ]
    },
    "state_class": {
      "enum": [
        "not-observed", "observed-undecodable", "decoded-null",
        "decoded-unresolved", "resolved", "semantic-applicable",
        "unsupported", "not-applicable", "terminal-rejection"
      ]
    },
    "state_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_class", "object_presence", "property_presence", "null_semantics", "canonical_outcome"],
      "properties": {
        "state_class": { "$ref": "#/$defs/state_class" },
        "object_presence": { "enum": ["absent", "retained_if_earlier_fact", "present", "rejected"] },
        "property_presence": { "enum": ["none", "earlier_only", "exact", "typed_null", "rejected", "family_specific"] },
        "null_semantics": { "type": "string", "minLength": 1 },
        "canonical_outcome": { "type": "string", "minLength": 1 }
      }
    },
    "family_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "container_presence", "empty_semantics", "object_presence", "source_rules", "required_base_groups", "conditional_groups", "atomic_groups", "allowed_fact_types", "coverage_populations", "gap_rules"],
      "properties": {
        "family": { "$ref": "#/$defs/family" },
        "container_presence": { "const": "required" },
        "empty_semantics": { "type": "string", "minLength": 1 },
        "object_presence": { "type": "string", "minLength": 1 },
        "source_rules": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^P[45]-[A-Z0-9-]+$" }
        },
        "required_base_groups": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^FC-[A-Z0-9-]+$" }
        },
        "conditional_groups": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^FC-[A-Z0-9-]+$" }
        },
        "atomic_groups": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^AB-[A-Z0-9-]+$" }
        },
        "allowed_fact_types": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "coverage_populations": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "gap_rules": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^P[45]-GAP-[A-Z0-9-]+$" }
        }
      }
    },
    "constructor_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constructor_group", "family", "presence", "source_templates", "absence_semantics", "null_semantics", "completion"],
      "properties": {
        "constructor_group": { "type": "string", "pattern": "^FC-[A-Z0-9-]+$" },
        "family": { "$ref": "#/$defs/family" },
        "presence": { "enum": ["required-base", "conditional", "atomic-conditional", "repeatable-conditional"] },
        "source_templates": { "const": "exact-constructor-group-from-semantic-authority" },
        "absence_semantics": { "type": "string", "minLength": 1 },
        "null_semantics": { "type": "string", "minLength": 1 },
        "completion": { "enum": ["all-or-nothing", "repeatable-zero-or-more", "repeatable-one-or-more", "constructor-defined-mixed"] }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "source", "requirement"],
      "properties": {
        "invariant_id": { "type": "string", "pattern": "^V5-INV-[A-Z0-9-]+$" },
        "source": { "type": "string", "minLength": 1 },
        "requirement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
