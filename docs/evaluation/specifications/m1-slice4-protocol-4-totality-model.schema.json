{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.m1-slice4.protocol-4-totality-model.schema/v1",
  "title": "Infinium M1 Slice 4 protocol /4 evidence-contract totality model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "model_id",
    "version",
    "status",
    "work_id",
    "protocol",
    "authorities",
    "evidence_layers",
    "state_classes",
    "dimensions",
    "vocabularies",
    "normalization_rules",
    "atomic_boundaries",
    "gap_rules",
    "coverage_registry",
    "cross_family_invariants",
    "fact_families",
    "manual_traces"
  ],
  "properties": {
    "schema_id": { "const": "infinium.m1-slice4.protocol-4-totality-model/v1" },
    "model_id": { "const": "infinium.m1-slice4.protocol-4-evidence-contract" },
    "version": { "const": "1.2.0" },
    "status": { "const": "proposed" },
    "work_id": { "const": "M1/S4.5/PRE-B2/WP1" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "authorities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/authority" }
    },
    "evidence_layers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/structural_layer" },
        { "$ref": "#/$defs/observed_layer" },
        { "$ref": "#/$defs/decoded_layer" },
        { "$ref": "#/$defs/resolved_layer" },
        { "$ref": "#/$defs/semantic_layer" }
      ],
      "items": false
    },
    "state_classes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "$ref": "#/$defs/not_observed_state" },
        { "$ref": "#/$defs/observed_undecodable_state" },
        { "$ref": "#/$defs/decoded_null_state" },
        { "$ref": "#/$defs/decoded_unresolved_state" },
        { "$ref": "#/$defs/resolved_state" },
        { "$ref": "#/$defs/semantic_applicable_state" },
        { "$ref": "#/$defs/unsupported_state" },
        { "$ref": "#/$defs/not_applicable_state" },
        { "$ref": "#/$defs/terminal_rejection_state" }
      ],
      "items": false
    },
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/dimension" }
    },
    "vocabularies": { "$ref": "#/$defs/vocabularies" },
    "normalization_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/norm_rule" }
    },
    "atomic_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/atomic_boundary" }
    },
    "gap_rules": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/gap_rule" }
    },
    "coverage_registry": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        { "$ref": "#/$defs/coverage_plugins" },
        { "$ref": "#/$defs/coverage_npc" },
        { "$ref": "#/$defs/coverage_race" },
        { "$ref": "#/$defs/coverage_refr" },
        { "$ref": "#/$defs/coverage_unsupported" },
        { "$ref": "#/$defs/coverage_facegen_loose" },
        { "$ref": "#/$defs/coverage_facegen_archive" },
        { "$ref": "#/$defs/coverage_localized" },
        { "$ref": "#/$defs/coverage_discovery" },
        { "$ref": "#/$defs/coverage_taxonomy" }
      ],
      "items": false
    },
    "cross_family_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partial_race_data"],
      "properties": {
        "partial_race_data": { "$ref": "#/$defs/partial_race_data_invariant" }
      }
    },
    "fact_families": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "prefixItems": [
        { "$ref": "#/$defs/family_result" },
        { "$ref": "#/$defs/family_plugins" },
        { "$ref": "#/$defs/family_override_chains" },
        { "$ref": "#/$defs/family_npc_contributions" },
        { "$ref": "#/$defs/family_race_contributions" },
        { "$ref": "#/$defs/family_placed_reference_contributions" },
        { "$ref": "#/$defs/family_allowlisted_fields" },
        { "$ref": "#/$defs/family_npcs" },
        { "$ref": "#/$defs/family_races" },
        { "$ref": "#/$defs/family_placed_references" },
        { "$ref": "#/$defs/family_face_gen" },
        { "$ref": "#/$defs/family_taxonomy" },
        { "$ref": "#/$defs/family_coverage" },
        { "$ref": "#/$defs/family_gaps" },
        { "$ref": "#/$defs/family_result_gaps" }
      ],
      "items": false
    },
    "manual_traces": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/manual_trace" }
    }
  },
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_commit", "protocol_id", "protocol_version", "projection_id", "projection_version", "candidate_commit"],
      "properties": {
        "evaluator_commit": { "const": "3693d19563c636cd2879804633ca4ce52448d2c1" },
        "protocol_id": { "const": "infinium.evaluator-v2/4" },
        "protocol_version": { "const": "4.0.0" },
        "projection_id": { "const": "infinium.evaluator-v2.slice4-semantic-projection" },
        "projection_version": { "const": "3.0.0" },
        "candidate_commit": { "const": "a98d648bd0adb2751ee0c09828e0227b1583950f" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "scope"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["accepted", "frozen-mechanics", "historical-input"] },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "definition", "prerequisites", "proves", "does_not_prove", "authorities"],
      "properties": {
        "id": { "enum": ["structural", "observed", "decoded", "resolved", "semantic"] },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 5 },
        "definition": { "type": "string", "minLength": 1 },
        "prerequisites": { "type": "array", "uniqueItems": true, "items": { "enum": ["structural", "observed", "decoded", "resolved", "semantic"] } },
        "proves": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "does_not_prove": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "structural_layer": { "allOf": [{ "$ref": "#/$defs/layer" }, { "properties": { "id": { "const": "structural" }, "ordinal": { "const": 1 } } }] },
    "observed_layer": { "allOf": [{ "$ref": "#/$defs/layer" }, { "properties": { "id": { "const": "observed" }, "ordinal": { "const": 2 } } }] },
    "decoded_layer": { "allOf": [{ "$ref": "#/$defs/layer" }, { "properties": { "id": { "const": "decoded" }, "ordinal": { "const": 3 } } }] },
    "resolved_layer": { "allOf": [{ "$ref": "#/$defs/layer" }, { "properties": { "id": { "const": "resolved" }, "ordinal": { "const": 4 } } }] },
    "semantic_layer": { "allOf": [{ "$ref": "#/$defs/layer" }, { "properties": { "id": { "const": "semantic" }, "ordinal": { "const": 5 } } }] },
    "state_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definition", "minimum_layer", "required_disposition"],
      "properties": {
        "id": { "$ref": "#/$defs/state_class_id" },
        "definition": { "type": "string", "minLength": 1 },
        "minimum_layer": { "enum": ["none", "structural", "observed", "decoded", "resolved", "semantic"] },
        "required_disposition": { "enum": ["no_fact", "exact_value", "typed_null", "accepted_unknown", "omission_plus_gap", "terminal_rejection", "family_specific"] }
      }
    },
    "state_class_id": { "enum": ["not-observed", "observed-undecodable", "decoded-null", "decoded-unresolved", "resolved", "semantic-applicable", "unsupported", "not-applicable", "terminal-rejection"] },
    "not_observed_state": { "allOf": [{ "$ref": "#/$defs/state_class" }, { "properties": { "id": { "const": "not-observed" } } }] },
    "observed_undecodable_state": { "allOf": [{ "$ref": "#/$defs/state_class" }, { "properties": { "id": { "const": "observed-undecodable" } } }] },
    "decoded_null_state": { "allOf": [{ "$ref": "#/$defs/state_class" }, { "properties": { "id": { "const": "decoded-null" } } }] },
    "decoded_unresolved_state": { "allOf": [{ "$ref": "#/$defs/state_class" }, { "properties": { "id": { "const": "decoded-unresolved" } } }] },
    "resolved_state": { "allOf": [{ "$ref": "#/$defs/state_class" }, { "properties": { "id": { "const": "resolved" } } }] },
    "semantic_applicable_state": { "allOf": [{ "$ref": "#/$defs/state_class" }, { "properties": { "id": { "const": "semantic-applicable" } } }] },
    "unsupported_state": { "allOf": [{ "$ref": "#/$defs/state_class" }, { "properties": { "id": { "const": "unsupported" } } }] },
    "not_applicable_state": { "allOf": [{ "$ref": "#/$defs/state_class" }, { "properties": { "id": { "const": "not-applicable" } } }] },
    "terminal_rejection_state": { "allOf": [{ "$ref": "#/$defs/state_class" }, { "properties": { "id": { "const": "terminal-rejection" } } }] },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "values"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_families", "fact_types", "value_types", "result_states", "link_states", "link_fields", "link_components", "face_gen_applicability", "asset_availability", "coverage_states", "taxonomy_applicability", "taxonomy_roles", "taxonomy_axis_facets", "taxonomy_subject_types", "semantic_suffixes", "coverage_populations", "countable_fields"],
      "properties": {
        "fact_families": { "$ref": "#/$defs/string_set" },
        "fact_types": { "$ref": "#/$defs/string_set" },
        "value_types": { "$ref": "#/$defs/string_set" },
        "result_states": { "$ref": "#/$defs/string_set" },
        "link_states": { "$ref": "#/$defs/string_set" },
        "link_fields": { "$ref": "#/$defs/string_set" },
        "link_components": { "$ref": "#/$defs/string_set" },
        "face_gen_applicability": { "$ref": "#/$defs/string_set" },
        "asset_availability": { "$ref": "#/$defs/string_set" },
        "coverage_states": { "$ref": "#/$defs/string_set" },
        "taxonomy_applicability": { "$ref": "#/$defs/string_set" },
        "taxonomy_roles": { "$ref": "#/$defs/string_set" },
        "taxonomy_axis_facets": { "type": "array", "minItems": 9, "uniqueItems": true, "items": { "$ref": "#/$defs/axis_facet" } },
        "taxonomy_subject_types": { "$ref": "#/$defs/string_set" },
        "semantic_suffixes": { "$ref": "#/$defs/string_set" },
        "coverage_populations": { "$ref": "#/$defs/string_set" },
        "countable_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["NPC_", "RACE", "REFR"],
          "properties": {
            "NPC_": { "$ref": "#/$defs/string_set" },
            "RACE": { "$ref": "#/$defs/string_set" },
            "REFR": { "$ref": "#/$defs/string_set" }
          }
        }
      }
    },
    "string_set": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "axis_facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "facet"],
      "properties": { "axis": { "type": "string", "minLength": 1 }, "facet": { "type": "string", "minLength": 1 } }
    },
    "norm_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "subject", "rule", "atomic_boundary", "authorities"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/rule_id" },
        "subject": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "atomic_boundary": { "type": "string", "minLength": 1 },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "atomic_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "reject_when", "retained_lower_layers", "result_effect", "authorities"],
      "properties": {
        "id": { "type": "string", "pattern": "^AB-[A-Z0-9-]+$" },
        "scope": { "type": "string", "minLength": 1 },
        "reject_when": { "type": "string", "minLength": 1 },
        "retained_lower_layers": { "type": "string", "minLength": 1 },
        "result_effect": { "type": "string", "minLength": 1 },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "gap_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "condition", "population_template", "missing_capability", "aggregation_key", "affected_count", "scope", "authorities"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/rule_id" },
        "condition": { "type": "string", "minLength": 1 },
        "population_template": { "type": "string", "minLength": 1 },
        "missing_capability": { "type": "string", "minLength": 1 },
        "aggregation_key": { "const": "population+missing_capability" },
        "affected_count": { "const": "exact independently identified affected members" },
        "scope": { "enum": ["snapshot", "result", "snapshot-and-result"] },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "coverage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "denominator_rule", "completion_rule", "zero_denominator", "incomplete_state_rule", "authorities"],
      "properties": {
        "population": { "type": "string", "minLength": 1 },
        "denominator_rule": { "type": "string", "minLength": 1 },
        "completion_rule": { "type": "string", "minLength": 1 },
        "zero_denominator": { "const": "0/0/completed" },
        "incomplete_state_rule": { "type": "string", "minLength": 1 },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "coverage_plugins": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "plugins" } } }] },
    "coverage_npc": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "npc-records" } } }] },
    "coverage_race": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "race-records" } } }] },
    "coverage_refr": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "placed-reference-records" } } }] },
    "coverage_unsupported": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "unsupported-records" } } }] },
    "coverage_facegen_loose": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "face-gen-loose-assets" } } }] },
    "coverage_facegen_archive": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "face-gen-archive-assets" } } }] },
    "coverage_localized": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "localized-strings" } } }] },
    "coverage_discovery": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "automatic-environment-discovery" } } }] },
    "coverage_taxonomy": { "allOf": [{ "$ref": "#/$defs/coverage_row" }, { "properties": { "population": { "const": "taxonomy-subjects" } } }] },
    "constructor_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fact_id_templates", "fact_type", "value_types", "minimum_layer", "value_source", "authorities"],
      "properties": {
        "id": { "type": "string", "pattern": "^FC-[A-Z0-9-]+$" },
        "fact_id_templates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "fact_type": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "value_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["string", "integer", "number", "boolean", "null"] } },
        "minimum_layer": { "enum": ["structural", "observed", "decoded", "resolved", "semantic"] },
        "value_source": { "type": "string", "minLength": 1 },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "dimensions_used", "constructor_groups", "admissible_state_classes", "inadmissible_state_classes", "state_space", "rules", "unstated_default"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "dimensions_used": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "constructor_groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/constructor_group" } },
        "admissible_state_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/state_class_id" } },
        "inadmissible_state_classes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/state_class_id" } },
        "state_space": { "$ref": "#/$defs/state_space" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/family_rule" } },
        "unstated_default": { "const": "prohibited" }
      }
    },
    "state_space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted_regions", "invalid_regions", "excluded_regions"],
      "properties": {
        "admitted_regions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/admitted_region" } },
        "invalid_regions": { "type": "array", "items": { "$ref": "#/$defs/invalid_region" } },
        "excluded_regions": { "type": "array", "items": { "$ref": "#/$defs/excluded_region" } }
      }
    },
    "admitted_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "state_class", "when", "reason", "required_gap_rule_ids", "authorities"],
      "properties": {
        "constraint_id": { "$ref": "#/$defs/constraint_id" },
        "state_class": { "$ref": "#/$defs/state_class_id" },
        "when": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "reason": { "type": "string", "minLength": 1 },
        "required_gap_rule_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/rule_id" } },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "invalid_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "when", "reason", "atomic_boundary", "authorities"],
      "properties": {
        "constraint_id": { "$ref": "#/$defs/constraint_id" },
        "when": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "reason": { "type": "string", "minLength": 1 },
        "atomic_boundary": { "type": "string", "pattern": "^AB-[A-Z0-9-]+$" },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "excluded_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "when", "reason", "authorities"],
      "properties": {
        "constraint_id": { "$ref": "#/$defs/constraint_id" },
        "when": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "reason": { "type": "string", "minLength": 1 },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "family_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "state_class", "when", "minimum_layer", "prerequisites", "outcomes", "coverage_effect", "gap_effects", "atomic_boundary", "authorities"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/rule_id" },
        "state_class": { "$ref": "#/$defs/state_class_id" },
        "when": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "minimum_layer": { "enum": ["none", "structural", "observed", "decoded", "resolved", "semantic"] },
        "prerequisites": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outcome" } },
        "coverage_effect": { "$ref": "#/$defs/coverage_effect" },
        "gap_effects": { "type": "array", "items": { "$ref": "#/$defs/gap_effect" } },
        "atomic_boundary": { "type": "string", "pattern": "^AB-[A-Z0-9-]+$" },
        "authorities": { "$ref": "#/$defs/authority_refs" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "operator", "values"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["equals", "in", "not-in"] },
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constructor_groups", "disposition", "value_rule"],
      "properties": {
        "constructor_groups": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^FC-[A-Z0-9-]+$" } },
        "disposition": { "enum": ["exact_value", "typed_null", "accepted_unknown", "mixed_by_constructor", "omit", "no_fact", "terminal_rejection"] },
        "value_rule": { "type": "string", "minLength": 1 }
      }
    },
    "coverage_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "denominator", "completion", "state_effect"],
      "properties": {
        "population": { "type": ["string", "null"] },
        "denominator": { "enum": ["none", "increment-one", "increment-two", "fixed-registry", "exact-affected-count"] },
        "completion": { "enum": ["none", "increment-one", "increment-two", "no-increment", "derived", "terminal"] },
        "state_effect": { "type": "string", "minLength": 1 },
        "additional_population_effects": { "type": "array", "items": { "$ref": "#/$defs/coverage_population_effect" } }
      }
    },
    "coverage_population_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "denominator", "completion", "state_effect"],
      "properties": {
        "population": { "type": "string", "minLength": 1 },
        "denominator": { "enum": ["none", "increment-one", "increment-two", "fixed-registry", "exact-affected-count"] },
        "completion": { "enum": ["none", "increment-one", "increment-two", "no-increment", "derived", "terminal"] },
        "state_effect": { "type": "string", "minLength": 1 }
      }
    },
    "gap_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_rule_id", "owner_id", "affected_count", "scope"],
      "properties": {
        "gap_rule_id": { "$ref": "#/$defs/rule_id" },
        "owner_id": { "type": "string", "pattern": "^GO-[A-Z0-9-]+$" },
        "affected_count": { "type": "string", "minLength": 1 },
        "affected_count_value": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["snapshot", "result", "snapshot-and-result"] }
      }
    },
    "authority_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rule_id": { "type": "string", "pattern": "^P4-[A-Z0-9-]+$" },
    "constraint_id": { "type": "string", "pattern": "^SC-[A-Z0-9-]+$" },
    "partial_race_data_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "authorities", "contribution", "allowlisted_field", "resolved_race", "taxonomy", "gap"],
      "properties": {
        "invariant_id": { "const": "INV-PARTIAL-RACE-DATA" },
        "authorities": { "$ref": "#/$defs/authority_refs" },
        "contribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "rule_id", "common_constructor", "common_disposition", "face_gen_constructor", "face_gen_disposition", "coverage_population", "coverage_denominator", "coverage_completion", "gap_rule_id", "gap_owner_id", "gap_scope", "affected_count"],
          "properties": {
            "family": { "const": "race_contributions" },
            "rule_id": { "const": "P4-RACECONTRIB-PARTIAL-DATA" },
            "common_constructor": { "const": "FC-RACECONTRIB-COMMON" },
            "common_disposition": { "const": "exact_value" },
            "face_gen_constructor": { "const": "FC-RACECONTRIB-FACEGEN" },
            "face_gen_disposition": { "const": "omit" },
            "coverage_population": { "const": "race-records" },
            "coverage_denominator": { "const": "increment-one" },
            "coverage_completion": { "const": "no-increment" },
            "gap_rule_id": { "const": "P4-GAP-UNSUPPORTED-SHAPE" },
            "gap_owner_id": { "const": "GO-RACECONTRIB-PARTIAL-DATA" },
            "gap_scope": { "const": "snapshot-and-result" },
            "affected_count": { "const": 1 }
          }
        },
        "allowlisted_field": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "rule_id", "constructor", "disposition", "field", "occurrence_state", "count_publication"],
          "properties": {
            "family": { "const": "allowlisted_fields" },
            "rule_id": { "const": "P4-FIELDS-STRUCTURAL-ONLY" },
            "constructor": { "const": "FC-ALLOWLISTED-FIELD" },
            "disposition": { "const": "omit" },
            "field": { "const": "DATA" },
            "occurrence_state": { "const": "structural-only" },
            "count_publication": { "const": "omitted" }
          }
        },
        "resolved_race": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "rule_id", "constructor", "disposition"],
          "properties": {
            "family": { "const": "races" },
            "rule_id": { "const": "P4-RACES-PARTIAL-DATA" },
            "constructor": { "const": "FC-RACES-RESOLVED" },
            "disposition": { "const": "omit" }
          }
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "rule_id", "subject_count", "coverage_population", "coverage_denominator", "coverage_completion", "assignments", "forbidden_semantic_source"],
          "properties": {
            "family": { "const": "taxonomy" },
            "rule_id": { "const": "P4-TAXONOMY-PARTIAL-RACE" },
            "subject_count": { "const": 1 },
            "coverage_population": { "const": "taxonomy-subjects" },
            "coverage_denominator": { "const": "increment-one" },
            "coverage_completion": { "const": "increment-one" },
            "assignments": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "type": "object", "additionalProperties": false, "required": ["axis", "facet", "code"], "properties": { "axis": { "const": "technical-modification-surface" }, "facet": { "const": "semantic-mechanism" }, "code": { "const": "surface.plugin-data" } } },
                { "type": "object", "additionalProperties": false, "required": ["axis", "facet", "code"], "properties": { "axis": { "const": "technical-modification-surface" }, "facet": { "const": "realization-and-delivery" }, "code": { "const": "delivery.plugin-container" } } }
              ],
              "items": false
            },
            "forbidden_semantic_source": { "const": "DATA" }
          }
        },
        "gap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["population", "missing_capability", "scope", "affected_count", "owner_id", "aggregation_count"],
          "properties": {
            "population": { "const": "unsupported-shapes:race:data" },
            "missing_capability": { "const": "allowlisted-record-shape-semantics" },
            "scope": { "const": "snapshot-and-result" },
            "affected_count": { "const": 1 },
            "owner_id": { "const": "GO-RACECONTRIB-PARTIAL-DATA" },
            "aggregation_count": { "const": 1 }
          }
        }
      }
    },
    "manual_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "boundary", "input_state", "rules", "result"],
      "properties": {
        "trace_id": { "type": "string", "pattern": "^TRACE-[A-Z0-9-]+$" },
        "boundary": { "enum": ["structural-to-observed", "observed-to-decoded", "decoded-to-resolved", "resolved-to-semantic", "partial-race-data", "atomic-rejection"] },
        "input_state": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/rule_id" } },
        "result": { "type": "string", "minLength": 1 }
      }
    },
    "family_result": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "result" } } }] },
    "family_plugins": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "plugins" } } }] },
    "family_override_chains": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "override_chains" } } }] },
    "family_npc_contributions": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "npc_contributions" } } }] },
    "family_race_contributions": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "race_contributions" } } }] },
    "family_placed_reference_contributions": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "placed_reference_contributions" } } }] },
    "family_allowlisted_fields": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "allowlisted_fields" } } }] },
    "family_npcs": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "npcs" } } }] },
    "family_races": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "races" } } }] },
    "family_placed_references": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "placed_references" } } }] },
    "family_face_gen": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "face_gen" } } }] },
    "family_taxonomy": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "taxonomy" } } }] },
    "family_coverage": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "coverage" } } }] },
    "family_gaps": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "gaps" } } }] },
    "family_result_gaps": { "allOf": [{ "$ref": "#/$defs/family" }, { "properties": { "family": { "const": "result_gaps" } } }] }
  }
}
