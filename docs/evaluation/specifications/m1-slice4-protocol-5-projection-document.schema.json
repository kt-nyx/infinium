{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.evaluator-v2.slice4-projection-document.schema/v5.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "protocol_id",
    "projection_id",
    "projection_version",
    "semantic_model",
    "representation_model",
    "state",
    "families"
  ],
  "properties": {
    "schema_id": { "const": "infinium.evaluator-v2.slice4-projection-document/v5.2" },
    "protocol_id": { "const": "infinium.evaluator-v2/5" },
    "projection_id": { "const": "infinium.evaluator-v2.slice4-semantic-projection" },
    "projection_version": { "const": "5.1.0" },
    "semantic_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "version", "sha256"],
      "properties": {
        "model_id": { "const": "infinium.m1-slice4.protocol-5-evidence-contract" },
        "version": { "const": "1.0.1" },
        "sha256": { "const": "3f375adcc59e436a75f14f8e46afcf0286bb202cb05fe256af6b679a726bab66" }
      }
    },
    "representation_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "version", "sha256"],
      "properties": {
        "model_id": { "const": "infinium.m1-slice4.protocol-5-projection-representation" },
        "version": { "const": "1.2.0" },
        "sha256": { "const": "fe5261983b7328fbe6bc092885cb9183c9a9da9ab80e63508706a6a4398ac896" }
      }
    },
    "state": {
      "enum": ["completed", "completed_with_gaps", "invalid_input", "changed_during_read", "failed"]
    },
    "families": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result", "plugins", "override_chains", "npc_contributions",
        "race_contributions", "placed_reference_contributions",
        "allowlisted_fields", "npcs", "races", "placed_references",
        "face_gen", "taxonomy", "coverage", "gaps", "result_gaps"
      ],
      "properties": {
        "result": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/projection_object" },
              {
                "properties": {
                  "object_id": { "const": "root" },
                  "rule_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": { "enum": ["P4-RESULT-PUBLISHED", "P4-RESULT-NO-SNAPSHOT"] }
                  },
                  "constructor_groups": { "const": ["FC-RESULT-STATE"] }
                }
              }
            ]
          }
        },
        "plugins": { "$ref": "#/$defs/family_array" },
        "override_chains": { "$ref": "#/$defs/family_array" },
        "npc_contributions": { "$ref": "#/$defs/family_array" },
        "race_contributions": { "$ref": "#/$defs/family_array" },
        "placed_reference_contributions": { "$ref": "#/$defs/family_array" },
        "allowlisted_fields": { "$ref": "#/$defs/family_array" },
        "npcs": { "$ref": "#/$defs/family_array" },
        "races": { "$ref": "#/$defs/family_array" },
        "placed_references": { "$ref": "#/$defs/family_array" },
        "face_gen": { "$ref": "#/$defs/family_array" },
        "taxonomy": { "$ref": "#/$defs/family_array" },
        "coverage": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/projection_object" }
        },
        "gaps": { "$ref": "#/$defs/family_array" },
        "result_gaps": { "$ref": "#/$defs/family_array" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "families": {
            "properties": {
              "result": {
                "contains": {
                  "properties": { "rule_ids": { "const": ["P4-RESULT-NO-SNAPSHOT"] } },
                  "required": ["rule_ids"]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "families": {
            "properties": {
              "plugins": { "maxItems": 0 },
              "override_chains": { "maxItems": 0 },
              "npc_contributions": { "maxItems": 0 },
              "race_contributions": { "maxItems": 0 },
              "placed_reference_contributions": { "maxItems": 0 },
              "allowlisted_fields": { "maxItems": 0 },
              "npcs": { "maxItems": 0 },
              "races": { "maxItems": 0 },
              "placed_references": { "maxItems": 0 },
              "face_gen": { "maxItems": 0 },
              "taxonomy": { "maxItems": 0 },
              "coverage": { "maxItems": 0 },
              "gaps": { "maxItems": 0 }
            }
          }
        }
      },
      "else": {
        "properties": {
          "families": {
            "properties": {
              "coverage": { "minItems": 10, "maxItems": 10 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "canonical_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:(?!\\.{1,2}(?:/|$))(?:[-A-Za-z0-9._~]|%(?:21|23|24|25|26|27|28|29|2A|2B|2C|3A|3B|3D|3F|40|5B|5D)|%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E[1-CEF]%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F]|%F[1-3]%[89AB][0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F]|%F4%8[0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F])+)(?:/(?!(?:\\.{1,2})(?:/|$))(?:[-A-Za-z0-9._~]|%(?:21|23|24|25|26|27|28|29|2A|2B|2C|3A|3B|3D|3F|40|5B|5D)|%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E[1-CEF]%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F]|%F[1-3]%[89AB][0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F]|%F4%8[0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F])+)*$"
    },
    "family_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/projection_object" }
    },
    "projection_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "rule_ids", "constructor_groups", "properties"],
      "properties": {
        "object_id": { "$ref": "#/$defs/canonical_path" },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^P[45]-[A-Z0-9-]+$" }
        },
        "constructor_groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^FC-[A-Z0-9-]+$" }
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projection_property" }
        }
      }
    },
    "projection_property": {
      "oneOf": [
        { "$ref": "#/$defs/string_property" },
        { "$ref": "#/$defs/integer_property" },
        { "$ref": "#/$defs/number_property" },
        { "$ref": "#/$defs/boolean_property" },
        { "$ref": "#/$defs/null_property" }
      ]
    },
    "property_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_id", "source_rule_id", "fact_type", "value_type", "value"],
      "properties": {
        "property_id": { "$ref": "#/$defs/canonical_path" },
        "source_rule_id": { "type": "string", "pattern": "^P[45]-[A-Z0-9-]+$" },
        "fact_type": {
          "enum": [
            "state", "plugin", "winner", "override_chain", "contribution",
            "record_identity", "form_key", "link", "ownership", "placement",
            "field", "npc", "race", "reference", "face_gen", "taxonomy",
            "coverage", "gap", "failure"
          ]
        },
        "value_type": { "enum": ["string", "integer", "number", "boolean", "null"] },
        "value": {}
      }
    },
    "string_property": {
      "allOf": [
        { "$ref": "#/$defs/property_base" },
        { "properties": { "value_type": { "const": "string" }, "value": { "type": "string" } } }
      ]
    },
    "integer_property": {
      "allOf": [
        { "$ref": "#/$defs/property_base" },
        { "properties": { "value_type": { "const": "integer" }, "value": { "type": "integer" } } }
      ]
    },
    "number_property": {
      "allOf": [
        { "$ref": "#/$defs/property_base" },
        { "properties": { "value_type": { "const": "number" }, "value": { "type": "number" } } }
      ]
    },
    "boolean_property": {
      "allOf": [
        { "$ref": "#/$defs/property_base" },
        { "properties": { "value_type": { "const": "boolean" }, "value": { "type": "boolean" } } }
      ]
    },
    "null_property": {
      "allOf": [
        { "$ref": "#/$defs/property_base" },
        { "properties": { "value_type": { "const": "null" }, "value": { "type": "null" } } }
      ]
    }
  }
}
