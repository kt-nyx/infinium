{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/planning/frontend-foundation-acceptance.v1.schema.json",
  "title": "Infinium frontend foundation integrated acceptance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_identity",
    "status",
    "last_reviewed",
    "plan_id",
    "checkpoint_d_commit",
    "m2_state",
    "claim_boundary",
    "evaluation_ids",
    "workflow"
  ],
  "properties": {
    "$schema": {
      "const": "frontend-foundation-acceptance.v1.schema.json"
    },
    "schema_identity": {
      "const": "infinium.planning.frontend-foundation-acceptance/1.0.0"
    },
    "status": {
      "enum": [
        "implementation-active",
        "accepted-transition-closeout"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "plan_id": {
      "const": "TRANSITION/M1-TO-M2/FRONTEND-APPLICATION-FOUNDATION"
    },
    "checkpoint_d_commit": {
      "$ref": "#/$defs/git_commit"
    },
    "m2_state": {
      "const": "inactive"
    },
    "claim_boundary": {
      "$ref": "#/$defs/text"
    },
    "evaluation_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EVAL-0090",
          "EVAL-0091",
          "EVAL-0092",
          "EVAL-0093",
          "EVAL-0094"
        ]
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/workflow_step"
      }
    }
  },
  "$defs": {
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "proof": {
      "oneOf": [
        {
          "$ref": "#/$defs/executable_test_proof"
        },
        {
          "$ref": "#/$defs/desktop_test_proof"
        },
        {
          "$ref": "#/$defs/machine_evidence_proof"
        },
        {
          "$ref": "#/$defs/reference_proof"
        }
      ]
    },
    "proof_identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,95}$"
    },
    "project_path": {
      "type": "string",
      "pattern": "^tests/[A-Za-z0-9.]+/[A-Za-z0-9.]+\\.csproj$"
    },
    "fully_qualified_test_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]+$",
      "maxLength": 512
    },
    "executable_test_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "kind",
        "required",
        "batch",
        "project",
        "fully_qualified_name"
      ],
      "properties": {
        "proof_id": { "$ref": "#/$defs/proof_identity" },
        "kind": { "const": "executable-test" },
        "required": { "const": true },
        "batch": { "enum": ["contract-authority", "native-integrated-workflow"] },
        "project": { "$ref": "#/$defs/project_path" },
        "fully_qualified_name": { "$ref": "#/$defs/fully_qualified_test_name" }
      }
    },
    "desktop_test_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "kind",
        "required",
        "batch",
        "project",
        "fully_qualified_name",
        "receipt_assertions"
      ],
      "properties": {
        "proof_id": { "$ref": "#/$defs/proof_identity" },
        "kind": { "const": "desktop-qualification-test" },
        "required": { "const": true },
        "batch": {
          "enum": [
            "ordinary-desktop",
            "desktop-state-preparation",
            "live-desktop",
            "desktop-lifecycle"
          ]
        },
        "project": { "$ref": "#/$defs/project_path" },
        "fully_qualified_name": { "$ref": "#/$defs/fully_qualified_test_name" },
        "receipt_assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_assertion" }
        }
      }
    },
    "machine_evidence_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "kind",
        "required",
        "path",
        "json_pointer",
        "predicate"
      ],
      "properties": {
        "proof_id": { "$ref": "#/$defs/proof_identity" },
        "kind": { "const": "machine-evidence" },
        "required": { "const": true },
        "path": {
          "type": "string",
          "pattern": "^artifacts/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "json_pointer": { "$ref": "#/$defs/json_pointer" },
        "predicate": { "$ref": "#/$defs/evidence_predicate" }
      }
    },
    "reference_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "kind",
        "required",
        "path",
        "selector"
      ],
      "properties": {
        "proof_id": { "$ref": "#/$defs/proof_identity" },
        "kind": { "const": "reference" },
        "required": { "const": false },
        "path": {
          "type": "string",
          "pattern": "^docs/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "selector": { "$ref": "#/$defs/short_text" }
      }
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
      "maxLength": 512
    },
    "evidence_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_pointer", "predicate"],
      "properties": {
        "json_pointer": { "$ref": "#/$defs/json_pointer" },
        "predicate": { "$ref": "#/$defs/evidence_predicate" }
      }
    },
    "evidence_predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "expected"],
          "properties": {
            "operator": { "enum": ["equals", "at-least", "at-most", "matches"] },
            "expected": { "type": ["string", "number", "integer", "boolean"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator"],
          "properties": {
            "operator": { "const": "nonempty" }
          }
        }
      ]
    },
    "workflow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "action",
        "consumer",
        "authority",
        "surface_maturity",
        "evaluation_ids",
        "proofs",
        "failure_boundary"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "action": {
          "$ref": "#/$defs/text"
        },
        "consumer": {
          "enum": [
            "native-generated-client",
            "desktop-diagnostic",
            "native-and-desktop"
          ]
        },
        "authority": {
          "enum": [
            "native-application",
            "desktop-read-only",
            "native-and-desktop"
          ]
        },
        "surface_maturity": {
          "enum": [
            "producer-consumer-validated",
            "implementation-active"
          ]
        },
        "evaluation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "EVAL-0090",
              "EVAL-0091",
              "EVAL-0092",
              "EVAL-0093",
              "EVAL-0094"
            ]
          }
        },
        "proofs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/proof"
          }
        },
        "failure_boundary": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
