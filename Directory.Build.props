<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>

    <Authors>Infinium contributors</Authors>
    <Company>Infinium contributors</Company>
    <Product>Infinium</Product>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/kt-nyx/infinium</RepositoryUrl>
    <InfiniumLicensePosture>GNU General Public License version 3 family; operative SPDX selector deferred</InfiniumLicensePosture>
    <Description>Infinium is intended to use the GPLv3 family. No operative GPL-3.0-only or GPL-3.0-or-later selector has been chosen.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
