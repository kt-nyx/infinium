* text=auto eol=lf

*.dll binary
*.exe binary
*.pdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.7z binary
*.nupkg binary

# Public fixtures are byte-exact retained artifacts whose SHA-256 values are
# transitively bound by package manifests. Never rewrite or text-merge them.
fixtures/public/** -text -diff -merge -eol

# Slice 6 credential-replacement evidence is immutable byte-exact effect
# evidence. Preserve its original JSON byte stream, including line endings.
artifacts/m1-slice6/successor-credential-replacement/** -text -diff -merge -eol
artifacts/m1-slice6/successor-credential-replacement-recovery/** -text -diff -merge -eol
artifacts/m1-slice6/successor-credential-replacement-cleanup-recovery/** -text -diff -merge -eol
artifacts/m1-slice6/successor-credential-replacement-typed-failure-recovery/** -text -diff -merge -eol
artifacts/m1-slice6/successor-credential-replacement-foreground-recovery/** -text -diff -merge -eol
artifacts/m1-slice6/successor-product-state/staging/m1s6-credential-replacement-*/** -text -diff -merge -eol
