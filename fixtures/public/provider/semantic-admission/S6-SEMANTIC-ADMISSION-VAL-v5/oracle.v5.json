  "designation": "validation",
  "authority_date": "2026-08-22",
  "purpose": "Independent expected truth for effect-free Slice 6 source-claim and candidate semantic admission.",
  "answer_isolation": {
    "raw_inputs_are_self_contained": true,
    "expected_truth_is_separate_from_raw_input": true,
    "product_output_used_to_author_truth": false,
    "product_implementation_or_tests_inspected": false,
    "prior_semantic_admission_packages_inspected": false,
    "private_or_retained_live_material_inspected": false
  },
  "scope": {
    "requirements": [
      "EVID-001",
      "EVID-004",
      "EVID-007",
      "OPS-002",
      "OPS-003",
      "RQ-031"
    ],
    "evaluation_cases": [
      "EVAL-0067",
      "EVAL-0083"
    ],
    "covers": [
      "source producer extraction and citation binding",
      "source consumer support, applicability, and host decision",
      "candidate producer proposal and explicit abstention",
      "candidate consumer support, applicability, and host decision",
      "complete current-eligible support by applicability matrix",
      "lifecycle unavailable and deleted audit-only retention",
      "structural and policy rejection",
      "direct opposing-evidence retention",
      "exactly-one host decision link cardinality"
    ],
    "does_not_cover": [
      "provider transport quality",
      "live response selection or reinterpretation",
      "finding or case promotion",
      "private held-out evaluation",
      "Slice 7 generalization"
    ]
  },
  "vocabularies": {
    "proposal_or_extraction_state": [
      "faithful-extraction",
      "unbound-citation",
      "candidate-proposal",
      "explicit-abstention"
    ],
    "support_state": [
      "supported",
      "unsupported",
      "contradicted",
      "unavailable",
      "not-evaluated"
    ],
    "applicability_state": [
      "applicable",
      "conditional-unestablished",
      "not-applicable",
      "unknown",
      "not-evaluated"
    ],
    "host_decision_state": [
      "admitted",
      "rejected",
      "abstained",
      "audit-only"
    ],
    "citation_binding_state": [
      "exact",
      "unknown",
      "invalid",
      "not-applicable"
    ],
    "retention_state": [
      "current",
      "unavailable",
      "deleted"
    ]
  },
  "decision_policy": {
    "axis_independence": "Proposal or extraction, support, applicability, and host decision are four independent facts.",
    "admit_rule": "A structurally valid, policy-allowed, current proposal is admitted only when support is supported and applicability is applicable.",
    "current_non_admit_rule": "Every other support/applicability combination for a structurally valid, policy-allowed, current proposal abstains; unsupported is not false and contradicted requires retained direct opposing evidence.",
    "explicit_provider_abstention_rule": "An explicit provider abstention remains proposal state explicit-abstention, both downstream axes are not-evaluated, and the host decision is abstained.",
    "lifecycle_rule": "A proposal whose required source or evidence artifact is unavailable or deleted is retained audit-only and cannot support a current conclusion.",
    "rejection_rule": "Structural invalidity or policy disallowance produces rejected; it is not relabeled as unsupported, contradicted, or abstained.",
    "citation_rule": "A source claim citation is exact only when source identity, revision, span identity, offsets, and quoted bytes agree. Missing citation information is unknown rather than fabricated.",
    "opposition_rule": "Contradicted requires at least one visible direct opposing-evidence identity.",
    "link_rule": "Every retained proposal has exactly one host decision link; zero and multiple links invalidate the containing semantic-admission document atomically."
  },
