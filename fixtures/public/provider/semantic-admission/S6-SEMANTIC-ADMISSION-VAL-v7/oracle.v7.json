  "semantic_boundaries": {
    "source_producer": {
      "owns": [
        "source-bound claim extraction",
        "source-bound conditions",
        "source-bound applicable-version wording",
        "citation identifiers carried by the provider transcript",
        "explicit provider abstention"
      ],
      "never_owns": [
        "evidence support adjudication",
        "local applicability adjudication",
        "host admission decision",
        "finding or case authority"
      ]
    },
    "source_consumer": {
      "owns": [
        "faithfulness of extraction to the retained source",
        "bounded evidence support",
        "local applicability",
        "exactly one host decision link for every retained proposal"
      ],
      "separation_rule": "A generic extraction artifact remains source-bound. Each localized application is a distinct object with its own local context, support, applicability, and decision link."
    },
    "candidate_producer": {
      "owns": [
        "bounded hypothesis proposal",
        "bounded contradiction references",
        "bounded missing-information proposal",
        "explicit provider abstention"
      ],
      "never_owns": [
        "local observation truth",
        "support adjudication",
        "local applicability adjudication",
        "host admission decision",
        "finding or case authority"
      ]
    },
    "citation_seam": {
      "producer_reachable": "The provider transcript carries citation identifiers only.",
      "consumer_only_abstract_premise": "The source consumer resolves each citation identifier against the exact retained source revision and checks that the cited passage supports the extracted wording in context.",
      "explicitly_not_in_provider_transcript": [
        "source revision",
        "UTF-8 start offset",
        "UTF-8 end offset",
        "copied span text"
      ],
      "reason": "Those exact-source facts are host-retained inputs or consumer premises, not fields on the accepted provider transcript seam."
    }
  },
