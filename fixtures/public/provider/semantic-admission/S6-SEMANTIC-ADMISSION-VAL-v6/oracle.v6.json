  "semanticRules": [
    {
      "ruleId": "S6SA6-RULE-001",
      "statement": "A current, structurally valid, policy-valid proposition is admitted if and only if support is SUPPORTED and applicability is APPLICABLE."
    },
    {
      "ruleId": "S6SA6-RULE-002",
      "statement": "Every other current-eligible allowed support and applicability pair, including every pair containing NOT_EVALUATED, yields ABSTAINED; it does not yield REJECTED or AUDIT_ONLY."
    },
    {
      "ruleId": "S6SA6-RULE-003",
      "statement": "UNSUPPORTED means insufficient support and does not assert falsehood; CONTRADICTED requires at least one direct opposing-evidence link."
    },
    {
      "ruleId": "S6SA6-RULE-004",
      "statement": "An explicit provider abstention has proposal state PROVIDER_ABSTAINED and requires both downstream axes to be NOT_EVALUATED; the resulting NOT_EVALUATED by NOT_EVALUATED matrix cell has host decision ABSTAINED."
    },
    {
      "ruleId": "S6SA6-RULE-005",
      "statement": "A temporarily unavailable required input yields unresolved availability and host decision ABSTAINED; AUDIT_ONLY is reserved here for retained proposals whose source or evidence was deliberately deleted."
    },
    {
      "ruleId": "S6SA6-RULE-006",
      "statement": "A source extraction must bind the exact source revision, UTF-8 byte span, and exact span text, and that span must support the extracted proposition in context. Missing, unknown, mismatched, or out-of-context citation binding fails producer structural validation and cannot enter local consumer application."
    },
    {
      "ruleId": "S6SA6-RULE-007",
      "statement": "Policy attempts to grant the provider host-decision, finding, tool, or operation authority fail producer policy validation before downstream semantic evaluation."
    },
    {
      "ruleId": "S6SA6-RULE-008",
      "statement": "Every retained proposal that reaches consumer application has exactly one host-decision link; zero or multiple links make the consumer semantic artifact invalid."
    }
  ],
