    { "passage_id": "relay-activation-rule", "source_revision_id": "relay-guidance-revision-4", "start_byte": 0, "end_byte": 77, "text": "When the activation mark is present, the relay enables the declared exchange.", "text_sha256": "09b6e7649ed3e8ce0abe09911bf635144876b804901a61a7eefc0bf081ece236", "deleted": false },
