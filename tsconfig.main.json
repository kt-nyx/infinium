{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "outDir": "dist/main",
    "rootDir": "./",
    "types": ["node"],
    "lib": ["ES2021"],
    "allowJs": false,
    "noEmit": false,
    "composite": true,
    "sourceMap": true
  },
  "include": ["src/main/**/*", "src/shared/**/*", "src/main/rules/rulesData.json"],
  "exclude": ["src/renderer"]
}





