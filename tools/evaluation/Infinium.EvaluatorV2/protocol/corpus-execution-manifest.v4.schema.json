{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "infinium.evaluator-v2.corpus-execution-manifest/v4",
  "type": "object", "additionalProperties": false, "required": ["schema_id", "protocol_id", "candidate", "evaluator", "corpus", "members"],
  "properties": {
    "schema_id": { "const": "infinium.evaluator-v2.corpus-execution-manifest/v4" }, "protocol_id": { "const": "infinium.evaluator-v2/4" },
    "candidate": { "$ref": "evaluator-v2-common.v4.schema.json#/$defs/candidate_identity" }, "evaluator": { "$ref": "evaluator-v2-common.v4.schema.json#/$defs/evaluator_identity" },
    "corpus": { "$ref": "evaluator-v2-common.v4.schema.json#/$defs/corpus_identity" },
    "members": { "type": "array", "minItems": 1, "maxItems": 128, "items": {
      "type": "object", "additionalProperties": false, "required": ["member_id", "execution", "oracle_path"],
      "properties": { "member_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "execution": { "$ref": "evaluator-v2-common.v4.schema.json#/$defs/execution" }, "oracle_path": { "type": "string", "minLength": 1, "maxLength": 32767 } }
    } }
  }
}
