{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "infinium.evaluator-v2.expected-semantic-output/v4",
  "type": "object", "additionalProperties": false, "required": ["schema_id", "protocol_id", "projection_id", "projection_version", "corpus_id", "corpus_version", "state", "facts"],
  "properties": {
    "schema_id": { "const": "infinium.evaluator-v2.expected-semantic-output/v4" }, "protocol_id": { "const": "infinium.evaluator-v2/4" },
    "projection_id": { "const": "infinium.evaluator-v2.slice4-semantic-projection" }, "projection_version": { "const": "3.0.0" },
    "corpus_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "corpus_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "state": { "enum": ["completed", "completed_with_gaps", "invalid_input", "changed_during_read", "failed"] },
    "facts": { "type": "array", "maxItems": 200000, "items": { "$ref": "evaluator-v2-common.v4.schema.json#/$defs/fact" } }
  }
}
