{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "infinium.evaluator-v2.calibration-results/v3",
  "type": "object", "additionalProperties": false, "required": ["schema_id", "protocol_id", "suite_id", "cases", "passed"],
  "properties": {
    "schema_id": { "const": "infinium.evaluator-v2.calibration-results/v3" }, "protocol_id": { "const": "infinium.evaluator-v2/3" }, "suite_id": { "const": "infinium.evaluator-v2.public-calibration/3" },
    "cases": { "type": "array", "minItems": 16, "maxItems": 96, "items": {
      "type": "object", "additionalProperties": false, "required": ["case_id", "expected_terminal", "actual_terminal", "intended_failure_category", "observed_failure_categories", "passed"],
      "properties": { "case_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "expected_terminal": { "enum": ["PASS", "FAIL", "EVALUATOR_ERROR"] }, "actual_terminal": { "enum": ["PASS", "FAIL", "EVALUATOR_ERROR"] }, "intended_failure_category": { "type": ["string", "null"], "maxLength": 64 }, "observed_failure_categories": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }, "passed": { "type": "boolean" } }
    } }, "passed": { "type": "boolean" }
  }
}
