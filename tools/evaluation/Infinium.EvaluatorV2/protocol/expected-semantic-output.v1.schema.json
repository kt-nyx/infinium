{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.evaluator-v2.expected-semantic-output/v1",
  "title": "Infinium evaluator-v2 expected semantic output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "protocol_id", "corpus_id", "corpus_version", "corpus_sha256", "state", "facts"],
  "properties": {
    "schema_id": { "const": "infinium.evaluator-v2.expected-semantic-output/v1" },
    "protocol_id": { "const": "infinium.evaluator-v2/1" },
    "corpus_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "corpus_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "corpus_sha256": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/sha256" },
    "state": {
      "type": "string",
      "enum": ["completed", "completed_with_gaps", "invalid_input", "changed_during_read", "failed"]
    },
    "facts": {
      "type": "array",
      "maxItems": 200000,
      "uniqueItems": true,
      "items": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/fact" }
    }
  }
}
