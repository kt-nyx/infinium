{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.evaluator-v2.common/v1",
  "title": "Infinium evaluator-v2 common types",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_length", "sha256"],
      "properties": {
        "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fact_value": {
      "anyOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "fact_type", "value_type", "value"],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "fact_type": {
          "type": "string",
          "enum": [
            "state",
            "plugin",
            "winner",
            "override_chain",
            "form_key",
            "link",
            "ownership",
            "placement",
            "field",
            "face_gen",
            "taxonomy",
            "coverage",
            "gap",
            "failure",
            "semantic"
          ]
        },
        "value_type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "null"]
        },
        "value": { "$ref": "#/$defs/fact_value" }
      }
    }
  }
}
