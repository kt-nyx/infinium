{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.evaluator-v2.execution-manifest/v1",
  "title": "Infinium evaluator-v2 answer-free execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "protocol_id", "candidate", "evaluator", "corpus", "execution"],
  "properties": {
    "schema_id": { "const": "infinium.evaluator-v2.execution-manifest/v1" },
    "protocol_id": { "const": "infinium.evaluator-v2/1" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "assembly_path", "artifact", "root", "files"],
      "properties": {
        "commit": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/commit" },
        "assembly_path": { "type": "string", "minLength": 1, "maxLength": 32767 },
        "artifact": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/artifact_identity" },
        "root": { "type": "string", "minLength": 1, "maxLength": 32767 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/file_identity" }
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "protocol_id", "scorer_id", "scorer_version", "adapter_id", "adapter_version", "root", "files"],
      "properties": {
        "commit": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/commit" },
        "protocol_id": { "const": "infinium.evaluator-v2/1" },
        "scorer_id": { "const": "infinium.evaluator-v2.scorer" },
        "scorer_version": { "const": "1.0.0" },
        "adapter_id": { "const": "infinium.evaluator-v2.slice4-reflection-adapter" },
        "adapter_version": { "const": "1.0.0" },
        "root": { "type": "string", "minLength": 1, "maxLength": 32767 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "evaluator-v2-common.v1.schema.json#/$defs/file_identity"
          }
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "version", "sha256", "qualification_state", "contamination_state"],
      "properties": {
        "corpus_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sha256": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/sha256" },
        "qualification_state": { "const": "frozen" },
        "contamination_state": { "const": "clean" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugins", "unsupported_capabilities"],
      "properties": {
        "plugins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plugin_name", "load_order", "local_installed_entity_id", "path", "byte_length", "sha256"],
            "properties": {
              "plugin_name": { "type": "string", "pattern": "^[^/\\\\]+\\.(esm|esp|esl)$" },
              "load_order": { "type": "integer", "minimum": 0, "maximum": 4095 },
              "local_installed_entity_id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "path": { "type": "string", "minLength": 1, "maxLength": 32767 },
              "byte_length": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/sha256" }
            }
          }
        },
        "unsupported_capabilities": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["archive_member_read", "localized_string_resolution", "automatic_environment_discovery"]
          }
        }
      }
    }
  }
}
