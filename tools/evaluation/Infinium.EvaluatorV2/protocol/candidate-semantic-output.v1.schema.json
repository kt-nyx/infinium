{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.evaluator-v2.candidate-semantic-output/v1",
  "title": "Infinium evaluator-v2 candidate semantic output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "protocol_id", "candidate_commit", "candidate_artifact", "state", "facts"],
  "properties": {
    "schema_id": { "const": "infinium.evaluator-v2.candidate-semantic-output/v1" },
    "protocol_id": { "const": "infinium.evaluator-v2/1" },
    "candidate_commit": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/commit" },
    "candidate_artifact": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/artifact_identity" },
    "state": {
      "type": "string",
      "enum": ["completed", "completed_with_gaps", "invalid_input", "changed_during_read", "failed"]
    },
    "facts": {
      "type": "array",
      "maxItems": 200000,
      "uniqueItems": true,
      "items": { "$ref": "evaluator-v2-common.v1.schema.json#/$defs/fact" }
    }
  }
}
