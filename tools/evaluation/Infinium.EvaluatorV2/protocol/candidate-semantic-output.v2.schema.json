{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "infinium.evaluator-v2.candidate-semantic-output/v2",
  "type": "object", "additionalProperties": false, "required": ["schema_id", "protocol_id", "projection_id", "projection_version", "candidate_commit", "candidate_artifact", "state", "facts"],
  "properties": {
    "schema_id": { "const": "infinium.evaluator-v2.candidate-semantic-output/v2" }, "protocol_id": { "const": "infinium.evaluator-v2/2" },
    "projection_id": { "const": "infinium.evaluator-v2.slice4-semantic-projection" }, "projection_version": { "const": "2.0.0" },
    "candidate_commit": { "$ref": "evaluator-v2-common.v2.schema.json#/$defs/commit" }, "candidate_artifact": { "$ref": "evaluator-v2-common.v2.schema.json#/$defs/artifact_identity" },
    "state": { "enum": ["completed", "completed_with_gaps", "invalid_input", "changed_during_read", "failed"] },
    "facts": { "type": "array", "maxItems": 200000, "items": { "$ref": "evaluator-v2-common.v2.schema.json#/$defs/fact" } }
  }
}
