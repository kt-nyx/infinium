{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2022",
    "types": ["vite/client"],
    "allowJs": false,
    "noEmit": true,
    "composite": true
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"],
  "exclude": ["src/main"]
}





