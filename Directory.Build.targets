<Project>
  <Target Name="PinCanonicalSourceRevisionInSourceRoots"
          AfterTargets="InitializeSourceControlInformationFromSourceControlManager"
          BeforeTargets="GenerateAssemblyInfo">
    <PropertyGroup>
      <InfiniumCanonicalSourceRevisionId Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevisionId)', '^[0-9a-f]{40}$'))">$(SourceRevisionId)</InfiniumCanonicalSourceRevisionId>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(InfiniumCanonicalSourceRevisionId)', '^[0-9a-f]{40}$'))"
           Text="Infinium builds require one exact Git SourceRevisionId." />
    <ItemGroup>
      <SourceRoot Update="@(SourceRoot)" RevisionId="$(InfiniumCanonicalSourceRevisionId)" />
    </ItemGroup>
  </Target>
</Project>
