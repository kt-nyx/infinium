{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/analysis-execution-input.v1.schema.json",
  "title": "Infinium Slice 5 answer-free analysis execution input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "execution_input_id", "run_id",
    "installation_snapshot", "bethesda_semantic_input", "source_inputs",
    "analyzer_declarations", "effective_configuration", "resolved_input_manifest",
    "mode", "seed", "limits", "boundaries"
  ],
  "properties": {
    "schema_id": { "const": "infinium.analysis.execution-input/v1" },
    "schema_version": { "const": "1.0.0" },
    "execution_input_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "installation_snapshot": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "bethesda_semantic_input": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "source_inputs": { "$ref": "#/$defs/artifactReferences" },
    "analyzer_declarations": { "$ref": "#/$defs/artifactReferences" },
    "effective_configuration": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "resolved_input_manifest": { "$ref": "common.v1.schema.json#/$defs/artifactReference" },
    "mode": { "enum": ["clean", "incremental", "retained-downstream-replay"] },
    "prior_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "seed": { "type": "integer", "minimum": 0 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_entities", "maximum_edges", "maximum_truth_rows", "maximum_output_items", "maximum_wall_time_milliseconds"],
      "properties": {
        "maximum_entities": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximum_edges": { "type": "integer", "minimum": 1, "maximum": 2000000 },
        "maximum_truth_rows": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maximum_output_items": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maximum_wall_time_milliseconds": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boundary" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "enum": ["incremental", "retained-downstream-replay"] } }, "required": ["mode"] },
      "then": { "required": ["prior_run_id"] },
      "else": { "not": { "required": ["prior_run_id"] } }
    }
  ],
  "$defs": {
    "artifactReferences": {
      "type": "array", "maxItems": 128, "items": { "$ref": "common.v1.schema.json#/$defs/artifactReference" }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "state", "reason"],
      "properties": {
        "boundary_id": { "enum": ["provider", "hosted-search", "nexus", "loot"] },
        "state": { "enum": ["used", "not-used", "unsupported"] },
        "reason": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" }
      }
    }
  }
}
