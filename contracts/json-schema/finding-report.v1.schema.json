{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/finding-report.v1.schema.json",
  "title": "Infinium finding report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "contract_maturity",
    "report_id",
    "state",
    "run_id",
    "analyzer_id",
    "subject_id",
    "title",
    "conclusion",
    "what_happened",
    "why_it_matters",
    "affected_subjects",
    "taxonomy_assignments",
    "assessment",
    "supporting_evidence_ids",
    "contradicting_evidence_ids",
    "assumptions",
    "applicability_conditions",
    "uncertainty",
    "unresolved_questions",
    "coverage",
    "failures",
    "exclusions",
    "gaps",
    "recommended_action",
    "validation_steps",
    "provenance",
    "unsupported_or_not_established"
  ],
  "properties": {
    "schema_id": { "const": "infinium.presentation.finding-report/v1" },
    "schema_version": { "const": "1.0.0" },
    "contract_maturity": { "const": "implementation-active" },
    "report_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "state": {
      "enum": [
        "supported-finding",
        "resolved-negative",
        "abstention",
        "failure",
        "limited",
        "coverage-gap"
      ]
    },
    "run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "analyzer_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "finding_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "case_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "subject_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "title": { "$ref": "#/$defs/short_text" },
    "conclusion": { "$ref": "#/$defs/text" },
    "what_happened": { "$ref": "#/$defs/text" },
    "why_it_matters": { "$ref": "#/$defs/text" },
    "affected_subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/subject" }
    },
    "taxonomy_assignments": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/taxonomy" }
    },
    "assessment": { "$ref": "#/$defs/assessment" },
    "supporting_evidence_ids": { "$ref": "#/$defs/identifiers" },
    "contradicting_evidence_ids": { "$ref": "#/$defs/identifiers" },
    "assumptions": { "$ref": "#/$defs/texts" },
    "applicability_conditions": { "$ref": "#/$defs/texts" },
    "uncertainty": { "$ref": "#/$defs/texts" },
    "unresolved_questions": { "$ref": "#/$defs/texts" },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/coverage" }
    },
    "failures": { "$ref": "#/$defs/texts" },
    "exclusions": { "$ref": "#/$defs/texts" },
    "gaps": { "$ref": "#/$defs/texts" },
    "recommended_action": { "$ref": "#/$defs/text" },
    "validation_steps": { "$ref": "#/$defs/text" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "unsupported_or_not_established": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "short_text": { "type": "string", "minLength": 1, "maxLength": 256 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "texts": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/text" }
    },
    "identifiers": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "common.v1.schema.json#/$defs/identifier" }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject_id", "detail"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
        "subject_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "detail": { "$ref": "#/$defs/text" }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "applicability", "basis"],
      "properties": {
        "axis": { "type": "string", "minLength": 1, "maxLength": 160 },
        "code": { "type": "string", "minLength": 1, "maxLength": 200 },
        "applicability": { "type": "string", "minLength": 1, "maxLength": 80 },
        "basis": { "$ref": "#/$defs/text" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "severity_basis",
        "confidence",
        "confidence_basis",
        "analyzer_maturity",
        "maturity_basis",
        "calibration_boundary"
      ],
      "properties": {
        "severity": {
          "enum": ["unspecified", "advisory", "minor", "moderate", "major", "blocker"]
        },
        "severity_basis": { "$ref": "#/$defs/text" },
        "confidence": {
          "enum": [
            "unspecified",
            "speculative-lead",
            "plausible",
            "strongly-supported",
            "confirmed"
          ]
        },
        "confidence_basis": { "$ref": "#/$defs/text" },
        "analyzer_maturity": { "const": "experimental" },
        "maturity_basis": { "$ref": "#/$defs/text" },
        "calibration_boundary": { "$ref": "#/$defs/text" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "denominator",
        "completed",
        "completed_with_gaps",
        "failed",
        "skipped_or_unsupported"
      ],
      "properties": {
        "population_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "denominator": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "completed_with_gaps": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped_or_unsupported": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_schema_id",
        "source_schema_version",
        "source_payload_id",
        "source_input_fingerprint",
        "source_assignment_id",
        "replay_equivalent",
        "canonical_artifact_role"
      ],
      "properties": {
        "source_schema_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source_payload_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "source_input_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "source_assignment_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "replay_equivalent": { "const": true },
        "canonical_artifact_role": { "const": "raw-run-output-is-canonical" }
      }
    }
  }
}
