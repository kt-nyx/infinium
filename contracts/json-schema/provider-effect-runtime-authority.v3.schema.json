{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/provider-effect-runtime-authority.v3.schema.json",
  "title": "infinium.provider.effect-runtime-authority/v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_identity", "authority_id", "scope", "kind", "status", "subject_manifest", "campaign", "predecessor", "attempt", "credential_access", "candidate_binding", "review", "owner_decision", "owner_amendment", "not_before_utc", "expires_at_utc", "execution", "limits"],
  "properties": {
    "schema_identity": { "const": "infinium.provider.effect-runtime-authority/v3" }, "authority_id": { "$ref": "#/$defs/id" }, "scope": { "const": "external-effect" },
    "kind": { "enum": ["transport-qualification", "source-claim-extraction", "candidate-investigation"] }, "status": { "const": "reviewed-and-owner-accepted" },
    "subject_manifest": { "$ref": "#/$defs/binding" }, "campaign": { "$ref": "#/$defs/binding" }, "predecessor": { "$ref": "#/$defs/predecessor" }, "attempt": { "$ref": "#/$defs/attempt" }, "credential_access": { "$ref": "#/$defs/binding" },
    "candidate_binding": { "$ref": "#/$defs/candidate" }, "review": { "$ref": "#/$defs/review" }, "owner_decision": { "$ref": "#/$defs/decision" }, "owner_amendment": { "$ref": "#/$defs/binding" },
    "not_before_utc": { "$ref": "#/$defs/utc" }, "expires_at_utc": { "$ref": "#/$defs/utc" }, "execution": { "$ref": "#/$defs/execution" }, "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "git": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" }, "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$" },
    "binding": { "type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "predecessor": { "type": "object", "additionalProperties": false, "required": ["ledger_event_hash", "evidence_id", "evidence_sha256"], "properties": { "ledger_event_hash": { "$ref": "#/$defs/sha" }, "evidence_id": { "$ref": "#/$defs/id" }, "evidence_sha256": { "$ref": "#/$defs/sha" } } },
    "attempt": { "type": "object", "additionalProperties": false, "required": ["attempt_id", "attempt_ordinal", "request_id", "reservation_id", "dispatch_fence_id"], "properties": { "attempt_id": { "$ref": "#/$defs/id" }, "attempt_ordinal": { "type": "integer", "minimum": 1 }, "request_id": { "$ref": "#/$defs/id" }, "reservation_id": { "$ref": "#/$defs/id" }, "dispatch_fence_id": { "$ref": "#/$defs/id" } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["candidate_id", "candidate_path", "candidate_sha256", "implementation_commit", "coordinator_sha256", "helper_sha256"], "properties": { "candidate_id": { "$ref": "#/$defs/id" }, "candidate_path": { "$ref": "#/$defs/path" }, "candidate_sha256": { "$ref": "#/$defs/sha" }, "implementation_commit": { "$ref": "#/$defs/git" }, "coordinator_sha256": { "$ref": "#/$defs/sha" }, "helper_sha256": { "$ref": "#/$defs/sha" } } },
    "review": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "evidence_path", "evidence_sha256"], "properties": { "evidence_id": { "$ref": "#/$defs/id" }, "evidence_path": { "$ref": "#/$defs/path" }, "evidence_sha256": { "$ref": "#/$defs/sha" } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["decision_id", "decision_path", "decision_sha256"], "properties": { "decision_id": { "$ref": "#/$defs/id" }, "decision_path": { "$ref": "#/$defs/path" }, "decision_sha256": { "$ref": "#/$defs/sha" } } },
    "execution": { "type": "object", "additionalProperties": false, "required": ["output_root_relative", "ledger_path_relative", "evidence_path_relative", "product_state_root_absolute", "product_state_snapshot_origin_sha256", "product_state_checkpoint_sha256", "coordinator_path_relative", "helper_path_relative"], "properties": { "output_root_relative": { "$ref": "#/$defs/path" }, "ledger_path_relative": { "$ref": "#/$defs/path" }, "evidence_path_relative": { "$ref": "#/$defs/path" }, "product_state_root_absolute": { "type": "string", "minLength": 3, "maxLength": 500 }, "product_state_snapshot_origin_sha256": { "$ref": "#/$defs/sha" }, "product_state_checkpoint_sha256": { "$ref": "#/$defs/sha" }, "coordinator_path_relative": { "$ref": "#/$defs/path" }, "helper_path_relative": { "$ref": "#/$defs/path" } } },
    "limits": { "type": "object", "additionalProperties": false, "required": ["helper_launches", "credential_native_calls", "provider_starts", "dns_resolutions", "billable_operations", "automatic_retry"], "properties": { "helper_launches": { "const": 1 }, "credential_native_calls": { "const": 2 }, "provider_starts": { "const": 1 }, "dns_resolutions": { "const": 1 }, "billable_operations": { "const": 1 }, "automatic_retry": { "const": false } } }
  }
}
