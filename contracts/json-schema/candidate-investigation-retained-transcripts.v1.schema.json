{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/candidate-investigation-retained-transcripts.v1.schema.json",
  "title": "infinium.llm.candidate-investigation-retained-transcripts/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "transcripts"],
  "properties": {
    "schema_id": { "const": "infinium.llm.candidate-investigation-retained-transcripts/v1" },
    "schema_version": { "const": "1" },
    "transcripts": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/transcript" } }
  },
  "$defs": {
    "ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
    "texts": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "candidate_id", "hypothesis_id", "hypothesis", "supporting_evidence_ids", "contradicting_evidence_ids", "missing_information", "authority_category", "state", "reason"],
      "properties": {
        "proposal_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "candidate_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "hypothesis_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "hypothesis": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "supporting_evidence_ids": { "$ref": "#/$defs/ids" },
        "contradicting_evidence_ids": { "$ref": "#/$defs/ids" },
        "missing_information": { "$ref": "#/$defs/texts" },
        "authority_category": { "enum": ["informational", "protected-effect-request"] },
        "state": { "enum": ["proposed", "unsupported", "abstained", "unavailable"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "transcript": {
      "type": "object", "additionalProperties": false,
      "required": ["transcript_id", "operation_id", "context_id", "response_record_id", "response_state", "response_fingerprint", "prompt_id", "prompt_fingerprint", "proposals", "abstentions", "gaps", "model_used"],
      "properties": {
        "transcript_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "operation_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "context_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "response_record_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "response_state": { "enum": ["completed", "malformed", "refusal", "incomplete", "drift", "not-used", "unavailable"] },
        "response_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "prompt_id": { "const": "infinium.m1-s6.candidate-investigation-prompt/v1" },
        "prompt_fingerprint": { "const": "026d7002102b74df9ef50ed2421714afa9f7b5dc717c69cadf7fb586d9c5b92e" },
        "proposals": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/proposal" } },
        "abstentions": { "$ref": "#/$defs/texts" },
        "gaps": { "$ref": "#/$defs/texts" },
        "model_used": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "model_used": { "const": false } } },
          "then": {
            "properties": {
              "response_state": { "enum": ["not-used", "unavailable"] },
              "proposals": { "maxItems": 0 }
            }
          },
          "else": { "properties": { "response_state": { "not": { "enum": ["not-used", "unavailable"] } } } }
        }
      ]
    }
  }
}
