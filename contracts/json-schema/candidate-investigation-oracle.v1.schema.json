{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/candidate-investigation-oracle.v1.schema.json",
  "title": "infinium.evaluation.candidate-investigation-oracle/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "package_id", "partition", "expected_identity", "expected_context_manifest_sha256", "scenarios", "aggregate_expectations", "frozen_boundaries", "forbidden_claims"],
  "properties": {
    "schema_id": { "const": "infinium.evaluation.candidate-investigation-oracle/v1" },
    "package_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "partition": { "const": "validation" },
    "expected_identity": { "$ref": "#/$defs/identity" },
    "expected_context_manifest_sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "scenarios": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/scenario" } },
    "aggregate_expectations": { "$ref": "#/$defs/aggregate" },
    "frozen_boundaries": { "$ref": "#/$defs/boundaries" },
    "forbidden_claims": { "$ref": "#/$defs/texts" }
  },
  "$defs": {
    "ids": { "type": "array", "uniqueItems": true, "maxItems": 128, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
    "texts": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "hashes": { "type": "array", "maxItems": 32, "items": { "$ref": "common.v1.schema.json#/$defs/sha256" } },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "host_authorization_id", "analysis_run_id", "prompt_id", "prompt_fingerprint"],
      "properties": {
        "operation_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "host_authorization_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "analysis_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "prompt_id": { "const": "infinium.m1-s6.candidate-investigation-prompt/v1" },
        "prompt_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" }
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["transcript_id", "transcript_state", "response_record_id", "response_fingerprint", "model_used", "provider_used", "audit_only", "forbidden_authority_detected", "disposition", "replay_state", "context_id", "hypothesis_id", "raw_intermediate_ids", "canonical_investigation_sha256", "abstention_kinds", "gap_kinds", "audit_reasons", "investigation", "source_acquisition_links"],
      "properties": {
        "transcript_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "transcript_state": { "enum": ["completed", "malformed", "refusal", "incomplete", "drift", "not-used", "unavailable"] },
        "response_record_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "response_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "model_used": { "type": "boolean" }, "provider_used": { "type": "boolean" },
        "audit_only": { "type": "boolean" }, "forbidden_authority_detected": { "type": "boolean" },
        "disposition": { "type": "string", "minLength": 1 }, "replay_state": { "enum": ["retained-response", "audit-only", "failed-identity-drift", "not-applicable", "unavailable"] },
        "context_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "hypothesis_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "raw_intermediate_ids": { "$ref": "#/$defs/ids" }, "canonical_investigation_sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "abstention_kinds": { "$ref": "#/$defs/texts" }, "gap_kinds": { "$ref": "#/$defs/texts" }, "audit_reasons": { "$ref": "#/$defs/texts" },
        "investigation": { "$ref": "#/$defs/investigation" },
        "source_acquisition_links": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/sourceLink" } }
      }
    },
    "investigation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "schema_version", "operation_id", "owner_kind", "owner_id", "analysis_run_id", "candidate_id", "participant_ids", "participant_roles", "causal_path_ids", "dependency_closure_id", "evidence_ids", "hypothesis_proposals", "abstentions", "gaps", "validation_ids", "admission_link_ids", "admission_links"],
      "properties": {
        "schema_id": { "const": "infinium.llm.candidate-investigation/v1" }, "schema_version": { "const": "1" },
        "operation_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "owner_kind": { "const": "analysis-run" },
        "owner_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "analysis_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "candidate_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "participant_ids": { "$ref": "#/$defs/ids" },
        "participant_roles": { "$ref": "#/$defs/texts" }, "causal_path_ids": { "$ref": "#/$defs/ids" },
        "dependency_closure_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "evidence_ids": { "$ref": "#/$defs/ids" },
        "hypothesis_proposals": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/proposal" } },
        "abstentions": { "$ref": "#/$defs/texts" }, "gaps": { "$ref": "#/$defs/texts" },
        "validation_ids": { "$ref": "#/$defs/ids" }, "admission_link_ids": { "$ref": "#/$defs/ids" },
        "admission_links": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/admissionLink" } }
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "candidate_id", "hypothesis", "supporting_evidence_ids", "contradicting_evidence_ids", "missing_information", "state", "reason"],
      "properties": {
        "proposal_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "candidate_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "hypothesis": { "type": "string", "minLength": 1 }, "supporting_evidence_ids": { "$ref": "#/$defs/ids" },
        "contradicting_evidence_ids": { "$ref": "#/$defs/ids" }, "missing_information": { "$ref": "#/$defs/texts" },
        "state": { "enum": ["admitted", "rejected", "abstained", "unavailable", "unsupported", "deleted"] }, "reason": { "type": "string", "minLength": 1 }
      }
    },
    "admissionLink": {
      "type": "object", "additionalProperties": false,
      "required": ["admission_id", "proposal_id", "authorization_id", "operation_id", "response_record_id", "owner_kind", "owner_id", "root_subject_id", "validation_id", "application_link_id", "state"],
      "properties": {
        "admission_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "proposal_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "authorization_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "operation_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "response_record_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "owner_kind": { "const": "analysis-run" },
        "owner_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "root_subject_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "validation_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "application_link_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "state": { "enum": ["admitted", "rejected", "abstained", "unavailable", "unsupported", "deleted"] }
      }
    },
    "sourceLink": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "evidence_application_link_id", "source_acquisition_id", "source_admission_id", "source_application_link_id", "source_revision_id", "passage_id", "relationship", "availability", "content_sha256"],
      "properties": {
        "evidence_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "evidence_application_link_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "source_acquisition_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "source_admission_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "source_application_link_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "source_revision_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "passage_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }, "relationship": { "enum": ["supporting", "contradicting", "neutral"] },
        "availability": { "enum": ["available", "deleted", "unavailable"] }, "content_sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" }
      }
    },
    "aggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_count", "proposal_count", "admitted_proposal_count", "rejected_proposal_count", "admission_link_count", "model_used_scenario_count", "no_model_scenario_count", "unavailable_provider_scenario_count", "distinct_operation_id_count", "positive_and_matched_negative_share_operation", "retained_response_scenario_count", "audit_only_scenario_count", "failed_identity_drift_scenario_count", "forbidden_authority_scenario_count", "network_send_count", "credential_operation_count", "source_refresh_count", "scenario_transcript_ids", "scenario_canonical_investigation_sha256"],
      "properties": {
        "scenario_count": { "type": "integer", "minimum": 1 }, "proposal_count": { "type": "integer", "minimum": 0 },
        "admitted_proposal_count": { "type": "integer", "minimum": 0 }, "rejected_proposal_count": { "type": "integer", "minimum": 0 },
        "admission_link_count": { "type": "integer", "minimum": 0 }, "model_used_scenario_count": { "type": "integer", "minimum": 0 },
        "no_model_scenario_count": { "type": "integer", "minimum": 0 }, "unavailable_provider_scenario_count": { "type": "integer", "minimum": 0 },
        "distinct_operation_id_count": { "type": "integer", "minimum": 1 }, "positive_and_matched_negative_share_operation": { "const": true },
        "retained_response_scenario_count": { "type": "integer", "minimum": 0 }, "audit_only_scenario_count": { "type": "integer", "minimum": 0 },
        "failed_identity_drift_scenario_count": { "type": "integer", "minimum": 0 }, "forbidden_authority_scenario_count": { "type": "integer", "minimum": 0 },
        "network_send_count": { "const": 0 }, "credential_operation_count": { "const": 0 }, "source_refresh_count": { "const": 0 },
        "scenario_transcript_ids": { "$ref": "#/$defs/ids" }, "scenario_canonical_investigation_sha256": { "$ref": "#/$defs/hashes" }
      }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["oracle_frozen_before_product_comparison", "answer_isolated", "partition", "product_output_used", "product_implementation_used", "prior_oracle_bytes_inspected", "prior_validation_bytes_preserved", "replacement_history"],
      "properties": {
        "oracle_frozen_before_product_comparison": { "const": true }, "answer_isolated": { "const": true }, "partition": { "const": "validation" },
        "product_output_used": { "const": false }, "product_implementation_used": { "const": false }, "prior_oracle_bytes_inspected": { "const": false },
        "prior_validation_bytes_preserved": { "const": true }, "replacement_history": { "$ref": "#/$defs/texts" }
      }
    }
  }
}
