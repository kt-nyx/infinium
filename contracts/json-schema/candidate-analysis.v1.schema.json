{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/candidate-analysis.v1.schema.json",
  "title": "Infinium Slice 5 candidate analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "payload_id", "originating_run_id", "analyzer_id",
    "population_id", "population_denominator", "decisions", "candidates", "abstentions",
    "gaps", "failures", "policy_id", "threshold_id", "limit_id", "hypotheses",
    "dependency_edges", "counts", "execution_input_id", "analysis_root_id", "execution_input_fingerprint",
    "policy_fingerprint", "threshold_fingerprint", "limit_fingerprint",
    "analyzer_set_fingerprint", "analyzer_bindings", "execution_input_descriptors",
    "policy_descriptors", "threshold_descriptors", "limit_descriptors"
  ],
  "properties": {
    "schema_id": { "const": "infinium.analysis.candidate/v1" },
    "schema_version": { "const": "1.0.0" },
    "payload_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "originating_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "analyzer_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "population_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "population_denominator": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "policy_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "threshold_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "limit_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "execution_input_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "analysis_root_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "execution_input_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "policy_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "threshold_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "limit_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "analyzer_set_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "analyzer_bindings": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/analyzerBinding" } },
    "execution_input_descriptors": { "$ref": "#/$defs/descriptors" },
    "policy_descriptors": { "$ref": "#/$defs/descriptors" },
    "threshold_descriptors": { "$ref": "#/$defs/descriptors" },
    "limit_descriptors": { "$ref": "#/$defs/descriptors" },
    "decisions": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/decision" } },
    "candidates": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/candidate" } },
    "hypotheses": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/hypothesis" } },
    "abstentions": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/abstention" } },
    "gaps": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/gap" } },
    "failures": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/failure" } },
    "dependency_edges": { "type": "array", "maxItems": 4000000, "items": { "$ref": "#/$defs/dependencyEdge" } },
    "counts": { "$ref": "#/$defs/counts" }
  },
  "$defs": {
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["participant_id", "role"],
      "properties": {
        "participant_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "role": { "$ref": "common.v1.schema.json#/$defs/identifier" }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": [
        "decision_id", "population_member_id", "source_fact_id", "lane", "disposition", "participants",
        "join_kind", "path", "dependency_closure_id", "dependency_ids", "rationale", "evidence_ids",
        "admission_independent_of_score", "analyzer_id", "policy_id", "threshold_id", "limit_id"
      ],
      "properties": {
        "decision_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "population_member_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "source_fact_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "lane": { "enum": ["deterministic-required", "mandatory-evidence", "optional-ranked"] },
        "disposition": { "enum": ["candidate-admitted", "resolved-negative", "unsupported", "ambiguous", "invalid-input", "limited", "deferred", "unprocessed", "failed"] },
        "participants": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/participant" } },
        "join_kind": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "path": { "type": "array", "maxItems": 64, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
        "dependency_closure_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "dependency_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
        "rationale": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 4096 },
        "evidence_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
        "admission_independent_of_score": { "type": "boolean" },
        "optional_rank": { "type": "integer", "minimum": 1 },
        "analyzer_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "policy_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "threshold_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "limit_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }
      },
      "allOf": [
        {
          "if": { "properties": { "lane": { "enum": ["deterministic-required", "mandatory-evidence"] } }, "required": ["lane"] },
          "then": { "properties": { "admission_independent_of_score": { "const": true } }, "not": { "required": ["optional_rank"] } },
          "else": { "properties": { "admission_independent_of_score": { "const": false } } }
        },
        {
          "if": { "properties": { "lane": { "const": "optional-ranked" } }, "required": ["lane"] },
          "then": { "required": ["optional_rank"] },
          "else": { "not": { "required": ["optional_rank"] } }
        }
      ]
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "decision_id", "state", "causal_explanation", "supporting_evidence_ids", "contradicting_evidence_ids", "missing_information", "confidence", "threshold_id", "hypothesis_id"],
      "properties": {
        "candidate_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "decision_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "state": { "enum": ["present", "ambiguous", "abstained"] },
        "causal_explanation": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 4096 },
        "supporting_evidence_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
        "contradicting_evidence_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
        "missing_information": { "type": "array", "maxItems": 32, "items": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 1024 } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "threshold_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "hypothesis_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "abstention_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["hypothesis_id", "candidate_id", "state", "proposed_explanation", "predicted_impact", "supporting_evidence_ids", "contradicting_evidence_ids", "missing_information", "confidence", "threshold_id"],
      "properties": {
        "hypothesis_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "candidate_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "state": { "enum": ["present", "ambiguous", "partial"] },
        "proposed_explanation": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 4096 },
        "predicted_impact": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 4096 },
        "supporting_evidence_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
        "contradicting_evidence_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
        "missing_information": { "type": "array", "maxItems": 32, "items": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 1024 } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "threshold_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }
      }
    },
    "abstention": {
      "type": "object", "additionalProperties": false,
      "required": ["abstention_id", "decision_id", "analyzer_id", "reason", "required_information"],
      "properties": {
        "abstention_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "decision_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "candidate_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "analyzer_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "reason": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 4096 },
        "required_information": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 1024 } }
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "decision_id", "population_id", "state", "reason", "missing_capability_or_information"],
      "properties": {
        "gap_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "decision_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "population_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "state": { "$ref": "#/$defs/resultState" },
        "reason": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 4096 },
        "missing_capability_or_information": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 1024 }
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["failure_id", "analyzer_id", "population_member_ids", "failure_code", "message", "retryable"],
      "properties": {
        "failure_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "analyzer_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "population_member_ids": { "type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/identifier" } },
        "failure_code": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "message": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString", "maxLength": 512 },
        "retryable": { "type": "boolean" }
      }
    },
    "dependencyEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "from_kind", "from_id", "to_kind", "to_id", "edge_kind"],
      "properties": {
        "edge_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "from_kind": { "enum": ["candidate-analysis-root", "candidate-decision", "dependency-closure", "candidate", "hypothesis", "abstention", "gap", "failure"] },
        "from_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "to_kind": { "enum": ["snapshot", "documentation-evidence", "candidate-decision", "candidate", "hypothesis", "evidence", "dependency-closure", "dependency", "source-fact", "payload", "execution-input-binding", "policy-binding", "threshold-binding", "limit-binding", "analyzer-declaration-binding"] },
        "to_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "edge_kind": { "enum": ["derived-from", "supports", "contradicts", "depends-on", "produced-by", "limits", "uses"] }
      }
    },
    "analyzerBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["analyzer_id", "analyzer_version", "ruleset_version", "declaration_fingerprint", "canonical_declaration_json"],
      "properties": {
        "analyzer_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "analyzer_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "ruleset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "declaration_fingerprint": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "canonical_declaration_json": { "type": "string", "minLength": 2, "maxLength": 65536 }
      }
    },
    "descriptors": {
      "type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["population", "deterministic_required", "mandatory_evidence", "optional_ranked", "candidate_admitted", "hypotheses", "abstentions", "gaps", "failures", "resolved_negative", "unsupported", "ambiguous", "invalid_input", "limited", "deferred", "unprocessed"],
      "properties": {
        "population": { "$ref": "#/$defs/count" },
        "deterministic_required": { "$ref": "#/$defs/count" },
        "mandatory_evidence": { "$ref": "#/$defs/count" },
        "optional_ranked": { "$ref": "#/$defs/count" },
        "candidate_admitted": { "$ref": "#/$defs/count" },
        "hypotheses": { "$ref": "#/$defs/count" },
        "abstentions": { "$ref": "#/$defs/count" },
        "gaps": { "$ref": "#/$defs/count" },
        "failures": { "$ref": "#/$defs/count" },
        "resolved_negative": { "$ref": "#/$defs/count" },
        "unsupported": { "$ref": "#/$defs/count" },
        "ambiguous": { "$ref": "#/$defs/count" },
        "invalid_input": { "$ref": "#/$defs/count" },
        "limited": { "$ref": "#/$defs/count" },
        "deferred": { "$ref": "#/$defs/count" },
        "unprocessed": { "$ref": "#/$defs/count" }
      }
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 4000000 },
    "resultState": { "enum": ["present", "resolved-negative", "missing", "invalid-input", "unsupported", "ambiguous", "partial", "abstained", "not-applicable", "not-used", "failed", "cancelled", "limit-reached", "unavailable", "unknown"] },
    "confidence": { "enum": ["speculative-lead", "plausible", "strongly-supported", "confirmed"] }
  }
}
