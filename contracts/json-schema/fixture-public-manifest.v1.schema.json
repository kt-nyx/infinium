{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/fixture-public-manifest.v1.schema.json",
  "title": "Infinium evaluation fixture public manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "fixture_id",
    "fixture_version",
    "evaluation_ids",
    "purpose",
    "classification",
    "partition",
    "partition_history",
    "taxonomy_id",
    "taxonomy_version",
    "input_package_fingerprint",
    "oracle_fingerprint",
    "provenance_fingerprint",
    "replay_dependency_fingerprint",
    "redistribution_class",
    "owner",
    "review_state",
    "created_at"
  ],
  "properties": {
    "schema_id": {
      "const": "infinium.evaluation.fixture-public-manifest/v1"
    },
    "schema_version": {
      "const": "1"
    },
    "fixture_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "fixture_version": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
    },
    "evaluation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVAL-[0-9]{4}$"
      }
    },
    "purpose": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
    },
    "classification": {
      "enum": [
        "positive",
        "negative",
        "boundary",
        "malformed",
        "unsupported"
      ]
    },
    "partition": {
      "$ref": "common.v1.schema.json#/$defs/partition"
    },
    "partition_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/partitionHistoryEntry"
      }
    },
    "taxonomy_id": {
      "const": "infinium.skyrim-se.mod-impact-taxonomy"
    },
    "taxonomy_version": {
      "const": "0.1.0"
    },
    "input_package_fingerprint": {
      "$ref": "common.v1.schema.json#/$defs/fingerprint"
    },
    "oracle_fingerprint": {
      "$ref": "common.v1.schema.json#/$defs/fingerprint"
    },
    "provenance_fingerprint": {
      "$ref": "common.v1.schema.json#/$defs/fingerprint"
    },
    "replay_dependency_fingerprint": {
      "$ref": "common.v1.schema.json#/$defs/fingerprint"
    },
    "redistribution_class": {
      "enum": [
        "project-authored",
        "project-authored-redistributable",
        "manifest-only",
        "evaluator-private",
        "non-redistributable"
      ]
    },
    "owner": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "review_state": {
      "enum": [
        "draft",
        "reviewed",
        "accepted",
        "sealed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
