{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/candidate-investigation-context.v1.schema.json",
  "title": "infinium.llm.candidate-investigation-context/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "analysis_run_id", "selection_policy", "context_ids", "candidate_ids", "hypothesis_ids", "dependency_closure_ids", "evidence_ids", "evidence_fingerprints"],
  "properties": {
    "schema_id": { "const": "infinium.llm.candidate-investigation-context/v1" },
    "schema_version": { "const": "1" },
    "analysis_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "selection_policy": { "const": "exact-declared-candidates-and-evidence-in-declared-order/v1" },
    "context_ids": { "$ref": "source-claim-extraction.v1.schema.json#/$defs/ids" },
    "candidate_ids": { "$ref": "source-claim-extraction.v1.schema.json#/$defs/ids" },
    "hypothesis_ids": { "$ref": "source-claim-extraction.v1.schema.json#/$defs/ids" },
    "dependency_closure_ids": { "$ref": "source-claim-extraction.v1.schema.json#/$defs/ids" },
    "evidence_ids": { "$ref": "source-claim-extraction.v1.schema.json#/$defs/ids" },
    "evidence_fingerprints": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "common.v1.schema.json#/$defs/sha256" } }
  }
}
