  "$defs":{
    "rateLimitFact":{"type":"object","additionalProperties":false,"required":["scope","dimension","availability","observed_at"],"properties":{"scope":{"enum":["request","project","organization","model"]},"dimension":{"enum":["requests","input-tokens","output-tokens","total-tokens"]},"availability":{"enum":["available","unavailable","unsupported"]},"limit":{"type":"integer","minimum":0},"remaining":{"type":"integer","minimum":0},"observed_at":{"$ref":"common.v1.schema.json#/$defs/utcTimestamp"},"resets_at":{"$ref":"common.v1.schema.json#/$defs/utcTimestamp"}},"oneOf":[{"properties":{"availability":{"const":"available"}},"required":["limit","remaining"]},{"properties":{"availability":{"enum":["unavailable","unsupported"]}},"not":{"anyOf":[{"required":["limit"]},{"required":["remaining"]},{"required":["resets_at"]}]}}]}
