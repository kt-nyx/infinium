{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.infinium.dev/json-schema/provider-response.v1.schema.json","title":"infinium.provider.response/v1","type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","response_record_id","operation_id","request_id","raw_response_payload","raw_response_bytes","http_status","state","requested_model","requested_service_tier","reasoning_context","reasoning_mode","prompt_cache_mode","usage","validation_state","admission_state","recorded_at"],
  "properties":{
    "schema_id":{"const":"infinium.provider.response/v1"},"schema_version":{"const":"1"},"response_record_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},"operation_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},"request_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},"raw_response_payload":{"$ref":"provider-operation.v1.schema.json#/$defs/identityReference"},"raw_response_bytes":{"type":"integer","minimum":1,"maximum":1048576},"http_status":{"type":"integer","minimum":100,"maximum":599},
    "provider_response_id":{"type":"string","minLength":1,"maxLength":128},"state":{"enum":["completed","refusal","incomplete","failed","queued","in-progress","cancelled","malformed","oversized","mismatched","unknown"]},"refusal_code":{"type":"string","minLength":1,"maxLength":128},"incomplete_reason":{"type":"string","minLength":1,"maxLength":256},"error_code":{"type":"string","minLength":1,"maxLength":128},
    "requested_model":{"const":"gpt-5.6-sol"},"returned_model":{"type":"string","minLength":1,"maxLength":128},"requested_service_tier":{"const":"default"},"returned_service_tier":{"type":"string","minLength":1,"maxLength":64},"reasoning_context":{"const":"current_turn"},"reasoning_mode":{"const":"standard"},"prompt_cache_mode":{"const":"explicit"},"usage":{"$ref":"provider-operation.v1.schema.json#/$defs/usage"},"validation_state":{"$ref":"provider-operation.v1.schema.json#/$defs/admissionState"},"admission_state":{"$ref":"provider-operation.v1.schema.json#/$defs/admissionState"},"recorded_at":{"$ref":"common.v1.schema.json#/$defs/utcTimestamp"}
  }
}
