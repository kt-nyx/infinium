{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/analyzer-declaration.v1.schema.json",
  "title": "Infinium analyzer declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "analyzer_id",
    "analyzer_version",
    "semantic_contract_version",
    "identity_contract_version",
    "ruleset_version",
    "taxonomy_id",
    "taxonomy_version",
    "scope",
    "input_populations",
    "dependencies",
    "minimum_snapshot_assurance",
    "thresholds",
    "possible_outputs",
    "coverage",
    "operation_requirements",
    "expected_scale_and_cost",
    "resource_bounds",
    "maturity",
    "raw_development_output",
    "preset_or_maturity_suppression",
    "linked_evaluation_cases"
  ],
  "properties": {
    "schema_id": {
      "const": "infinium.analyzer.declaration/v1"
    },
    "schema_version": {
      "const": "1"
    },
    "analyzer_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "analyzer_version": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
    },
    "semantic_contract_version": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
    },
    "identity_contract_version": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
    },
    "ruleset_version": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
    },
    "taxonomy_id": {
      "const": "infinium.skyrim-se.mod-impact-taxonomy"
    },
    "taxonomy_version": {
      "const": "0.1.0"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_inputs",
        "excluded_inputs",
        "supported_record_field_asset_shapes",
        "excluded_record_field_asset_shapes",
        "supported_taxonomy_codes",
        "unsupported_taxonomy_codes",
        "supported_extent_facets",
        "excluded_extent_facets"
      ],
      "properties": {
        "supported_inputs": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "excluded_inputs": {
          "$ref": "#/$defs/reasonedScopeArray"
        },
        "supported_record_field_asset_shapes": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "excluded_record_field_asset_shapes": {
          "$ref": "#/$defs/reasonedScopeArray"
        },
        "supported_taxonomy_codes": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "unsupported_taxonomy_codes": {
          "$ref": "#/$defs/reasonedScopeArray"
        },
        "supported_extent_facets": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "excluded_extent_facets": {
          "$ref": "#/$defs/reasonedScopeArray"
        }
      }
    },
    "input_populations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "population_id",
          "description",
          "required"
        ],
        "properties": {
          "population_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "description": {
            "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "minimum_version",
          "required",
          "missing_state"
        ],
        "properties": {
          "dependency_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "minimum_version": {
            "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
          },
          "required": {
            "type": "boolean"
          },
          "missing_state": {
            "enum": [
              "skipped-by-configuration",
              "failed",
              "unsupported",
              "completed-with-gaps"
            ]
          }
        }
      }
    },
    "minimum_snapshot_assurance": {
      "enum": [
        "structural",
        "selectively-content-sealed",
        "fully-byte-sealed"
      ]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_admission",
        "evidence",
        "abstention",
        "finding_promotion"
      ],
      "properties": {
        "candidate_admission": {
          "$ref": "#/$defs/threshold"
        },
        "evidence": {
          "$ref": "#/$defs/threshold"
        },
        "abstention": {
          "$ref": "#/$defs/threshold"
        },
        "finding_promotion": {
          "$ref": "#/$defs/threshold"
        }
      }
    },
    "possible_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "observation",
          "deterministic-result",
          "external-claim",
          "discovery-lead",
          "model-proposal",
          "proposal-admission",
          "candidate",
          "hypothesis",
          "finding",
          "recommendation",
          "supported-case",
          "lead-only-case",
          "abstention",
          "invalid-input",
          "coverage-gap",
          "failure"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "populations",
        "possible_states",
        "unsupported_behavior"
      ],
      "properties": {
        "populations": {
          "$ref": "#/$defs/nonEmptyIdentifierArray"
        },
        "possible_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "completed",
              "completed-with-gaps",
              "failed",
              "skipped-by-configuration",
              "skipped-by-limit",
              "unsupported"
            ]
          }
        },
        "unsupported_behavior": {
          "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "operation_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "network_required",
        "llm_required",
        "provider_required"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local-only",
            "cached-external-evidence",
            "live-network",
            "llm-provider"
          ]
        },
        "network_required": {
          "type": "boolean"
        },
        "llm_required": {
          "type": "boolean"
        },
        "provider_required": {
          "type": "boolean"
        }
      }
    },
    "expected_scale_and_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_scale",
        "cost_class",
        "billable"
      ],
      "properties": {
        "population_scale": {
          "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
        },
        "cost_class": {
          "enum": [
            "local-low",
            "local-moderate",
            "local-high",
            "provider-bounded"
          ]
        },
        "billable": {
          "type": "boolean"
        }
      }
    },
    "resource_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_items",
        "max_output_items",
        "max_wall_time_ms"
      ],
      "properties": {
        "max_input_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_time_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "maturity": {
      "const": "Experimental"
    },
    "raw_development_output": {
      "const": true
    },
    "preset_or_maturity_suppression": {
      "const": false
    },
    "linked_evaluation_cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative",
        "boundary",
        "malformed",
        "cross_category",
        "gap"
      ],
      "properties": {
        "positive": {
          "$ref": "#/$defs/evaluationIdArray"
        },
        "negative": {
          "$ref": "#/$defs/evaluationIdArray"
        },
        "boundary": {
          "$ref": "#/$defs/evaluationIdArray"
        },
        "malformed": {
          "$ref": "#/$defs/evaluationIdArray"
        },
        "cross_category": {
          "$ref": "#/$defs/evaluationIdArray"
        },
        "gap": {
          "$ref": "#/$defs/evaluationIdArray"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyIdentifierArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/identifier"
      }
    },
    "reasonedScopeArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_id",
          "reason"
        ],
        "properties": {
          "scope_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "reason": {
            "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "ruleset_version",
        "description"
      ],
      "properties": {
        "rule_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "ruleset_version": {
          "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "evaluationIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVAL-[0-9]{4}$"
      }
    }
  }
}
