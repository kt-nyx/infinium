{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.infinium.dev/json-schema/source-claim-retained-transcripts.v1.schema.json","title":"infinium.llm.source-claim-retained-transcripts/v1","type":"object","additionalProperties":false,
