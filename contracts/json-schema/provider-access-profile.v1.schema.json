{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.infinium.dev/json-schema/provider-access-profile.v1.schema.json",
  "title":"infinium.provider.access-profile/v1",
  "type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","profile_id","generation_id","generation_ordinal","revocation_epoch","provider","purpose","display_label","lifecycle_state","verification_state","recovery_disposition","cleanup_disposition","recorded_at"],
  "properties":{
    "schema_id":{"const":"infinium.provider.access-profile/v1"},"schema_version":{"const":"1"},
    "profile_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},"generation_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},"generation_ordinal":{"type":"integer","minimum":1},"revocation_epoch":{"type":"integer","minimum":0},
    "provider":{"const":"openai"},"purpose":{"const":"responses"},"display_label":{"type":"string","minLength":1,"maxLength":128},
    "lifecycle_state":{"enum":["pending-enrollment","active-unverified","active-verified","replacing","disabled","delete-pending","deleted","secure-store-unavailable","recovery-required"]},
    "verification_state":{"$ref":"provider-operation.v1.schema.json#/$defs/availability"},
    "account_identity_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},"billing_scope_identity_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},"capability_snapshot_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},"intent_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},
    "recovery_disposition":{"enum":["not-required","required","unavailable"]},"cleanup_disposition":{"enum":["not-requested","pending","confirmed","failed"]},"recorded_at":{"$ref":"common.v1.schema.json#/$defs/utcTimestamp"}
  },
  "oneOf":[
    {"properties":{"lifecycle_state":{"const":"pending-enrollment"},"verification_state":{"const":"not-applicable"},"recovery_disposition":{"const":"not-required"},"cleanup_disposition":{"const":"not-requested"}},"required":["intent_id"],"not":{"anyOf":[{"required":["account_identity_id"]},{"required":["billing_scope_identity_id"]},{"required":["capability_snapshot_id"]}]}},
    {"properties":{"lifecycle_state":{"const":"active-unverified"},"verification_state":{"const":"unavailable"},"recovery_disposition":{"const":"not-required"},"cleanup_disposition":{"const":"not-requested"}},"required":["intent_id","account_identity_id","billing_scope_identity_id","capability_snapshot_id"]},
    {"properties":{"lifecycle_state":{"enum":["active-verified","replacing"]},"verification_state":{"const":"available"},"recovery_disposition":{"const":"not-required"},"cleanup_disposition":{"const":"not-requested"}},"required":["intent_id","account_identity_id","billing_scope_identity_id","capability_snapshot_id"]},
    {"properties":{"lifecycle_state":{"const":"disabled"},"verification_state":{"const":"unavailable"},"recovery_disposition":{"const":"not-required"},"cleanup_disposition":{"const":"not-requested"}},"required":["intent_id","account_identity_id","billing_scope_identity_id","capability_snapshot_id"]},
    {"properties":{"lifecycle_state":{"const":"delete-pending"},"verification_state":{"const":"unavailable"},"recovery_disposition":{"const":"not-required"},"cleanup_disposition":{"const":"pending"}},"required":["intent_id","account_identity_id","billing_scope_identity_id","capability_snapshot_id"]},
    {"properties":{"lifecycle_state":{"const":"deleted"},"verification_state":{"const":"unavailable"},"recovery_disposition":{"const":"not-required"},"cleanup_disposition":{"const":"confirmed"}},"not":{"anyOf":[{"required":["intent_id"]},{"required":["account_identity_id"]},{"required":["billing_scope_identity_id"]},{"required":["capability_snapshot_id"]}]}},
    {"properties":{"lifecycle_state":{"const":"secure-store-unavailable"},"verification_state":{"const":"unavailable"},"recovery_disposition":{"const":"unavailable"},"cleanup_disposition":{"enum":["not-requested","failed"]}},"required":["intent_id"],"oneOf":[{"required":["account_identity_id","billing_scope_identity_id","capability_snapshot_id"]},{"not":{"anyOf":[{"required":["account_identity_id"]},{"required":["billing_scope_identity_id"]},{"required":["capability_snapshot_id"]}]}}]},
    {"properties":{"lifecycle_state":{"const":"recovery-required"},"verification_state":{"const":"unavailable"},"recovery_disposition":{"const":"required"},"cleanup_disposition":{"enum":["not-requested","failed"]}},"required":["intent_id"],"oneOf":[{"required":["account_identity_id","billing_scope_identity_id","capability_snapshot_id"]},{"not":{"anyOf":[{"required":["account_identity_id"]},{"required":["billing_scope_identity_id"]},{"required":["capability_snapshot_id"]}]}}]}
  ]
}
