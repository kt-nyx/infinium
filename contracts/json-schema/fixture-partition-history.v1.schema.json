{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/fixture-partition-history.v1.schema.json",
  "title": "Infinium evaluation fixture partition history v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "fixture_version",
    "partition_history"
  ],
  "properties": {
    "fixture_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "fixture_version": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
    },
    "partition_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/partitionHistoryEntry"
      }
    }
  }
}
