{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/renderer-operation-registry.v1.schema.json",
  "title": "Infinium renderer operation registry v1",
  "$defs": {
    "responseOutcomes": {
      "type": "array",
      "prefixItems": [
        { "const": "accepted" },
        { "const": "rejected" },
        { "const": "conflict" },
        { "const": "unsupported" },
        { "const": "unavailable" },
        { "const": "cancelled" },
        { "const": "indeterminate" },
        { "const": "resync-required" }
      ],
      "minItems": 8,
      "maxItems": 8
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer_contract_version", "limits", "operations", "denied_authority_fields"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "renderer_contract_version": { "const": "1.0.0" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_message_bytes", "maximum_page_items", "maximum_chunk_bytes", "maximum_stream_queue_items", "maximum_filter_terms", "maximum_sort_terms", "maximum_bootstrap_recent_runs"],
      "properties": {
        "maximum_message_bytes": { "const": 1048576 },
        "maximum_page_items": { "const": 100 },
        "maximum_chunk_bytes": { "const": 262144 },
        "maximum_stream_queue_items": { "const": 64 },
        "maximum_filter_terms": { "const": 16 },
        "maximum_sort_terms": { "const": 4 },
        "maximum_bootstrap_recent_runs": { "const": 20 }
      }
    },
    "operations": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["operation", "native_target", "messages", "maturity", "owner"],
          "properties": {
            "operation": { "const": "application.bootstrap" },
            "native_target": { "const": "ApplicationService.GetApplicationBootstrap" },
            "messages": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "prefixItems": [
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["message_kind", "payload_shape", "gesture"],
                  "properties": { "message_kind": { "const": "request" }, "payload_shape": { "const": "bootstrap-request" }, "gesture": { "const": "not-allowed" } }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["message_kind", "payload_shape", "gesture", "outcomes"],
                  "properties": { "message_kind": { "const": "response" }, "payload_shape": { "const": "bootstrap-response" }, "gesture": { "const": "not-allowed" }, "outcomes": { "$ref": "#/$defs/responseOutcomes" } }
                }
              ]
            },
            "maturity": { "const": "producer-consumer-validated" },
            "owner": { "const": "frontend-application-contract-foundation" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["operation", "native_target", "messages", "maturity", "owner"],
          "properties": {
            "operation": { "const": "application.cancel" },
            "native_target": { "const": "DesktopHost.TransportCancellation" },
            "messages": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "prefixItems": [
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["message_kind", "payload_shape", "gesture"],
                  "properties": { "message_kind": { "const": "request" }, "payload_shape": { "const": "cancel-request" }, "gesture": { "const": "required" } }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["message_kind", "payload_shape", "gesture", "outcomes"],
                  "properties": { "message_kind": { "const": "response" }, "payload_shape": { "const": "cancel-response" }, "gesture": { "const": "not-allowed" }, "outcomes": { "$ref": "#/$defs/responseOutcomes" } }
                }
              ]
            },
            "maturity": { "const": "producer-consumer-validated" },
            "owner": { "const": "frontend-application-contract-foundation" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["operation", "native_target", "messages", "maturity", "owner"],
          "properties": {
            "operation": { "const": "application.resync-required" },
            "native_target": { "const": "DesktopHost.ResyncProjection" },
            "messages": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "prefixItems": [
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["message_kind", "payload_shape", "gesture", "outcomes"],
                  "properties": {
                    "message_kind": { "const": "event" }, "payload_shape": { "const": "resync-required-event" }, "gesture": { "const": "not-allowed" },
                    "outcomes": { "type": "array", "prefixItems": [{ "const": "resync-required" }], "minItems": 1, "maxItems": 1 }
                  }
                }
              ]
            },
            "maturity": { "const": "producer-consumer-validated" },
            "owner": { "const": "frontend-application-contract-foundation" }
          }
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "denied_authority_fields": {
      "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
      "items": { "enum": ["path", "sql", "command", "command_line", "url", "credential", "provider_request", "filesystem", "coordinator_proxy"] }
    }
  }
}
