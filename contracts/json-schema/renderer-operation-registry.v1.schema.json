{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/renderer-operation-registry.v1.schema.json",
  "title": "Infinium renderer operation registry v1",
  "$defs": {
    "fullOutcomes": {
      "type": "array",
      "prefixItems": [
        { "const": "accepted" }, { "const": "rejected" }, { "const": "conflict" }, { "const": "unsupported" },
        { "const": "unavailable" }, { "const": "cancelled" }, { "const": "indeterminate" }, { "const": "resync-required" }
      ],
      "minItems": 8,
      "maxItems": 8
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_kind", "direction", "payload_shape", "schema_definition", "gesture"],
      "properties": {
        "message_kind": { "enum": ["request", "response", "event"] },
        "direction": { "enum": ["renderer-to-host", "host-to-renderer"] },
        "payload_shape": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
        "schema_definition": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "gesture": { "enum": ["required", "not-allowed"] },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["accepted", "rejected", "conflict", "unsupported", "unavailable", "cancelled", "indeterminate", "resync-required"] }
        }
      },
      "allOf": [
        { "if": { "properties": { "message_kind": { "const": "request" } } }, "then": { "not": { "required": ["outcomes"] } }, "else": { "required": ["outcomes"] } }
      ]
    },
    "nativeAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["unary", "stream", "host", "transport"] },
        "request_type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "response_type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "event_type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "client_method": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+Async$" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "transport" } } },
          "then": { "required": ["event_type"], "not": { "anyOf": [{ "required": ["response_type"] }, { "required": ["client_method"] }] } },
          "else": { "required": ["request_type", "client_method"], "oneOf": [
            { "required": ["response_type"], "not": { "required": ["event_type"] } },
            { "required": ["event_type"], "not": { "required": ["response_type"] } }
          ] }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "native_target", "native_adapter", "messages", "maturity", "owner"],
      "properties": {
        "operation": { "enum": ["transport.session.establish", "transport.gesture.grant", "application.bootstrap", "results.list", "results.detail", "progress.read", "progress.subscribe", "application.cancel", "application.resync-required"] },
        "native_target": { "enum": ["DesktopHost.EstablishRendererSession", "DesktopHost.GrantRendererGesture", "ApplicationService.GetApplicationBootstrap", "ApplicationService.ListResultItems", "ApplicationService.GetResultDetail", "ApplicationService.GetProgress", "ApplicationService.SubscribeEvents", "DesktopHost.TransportCancellation", "DesktopHost.ResyncProjection"] },
        "native_adapter": { "$ref": "#/$defs/nativeAdapter" },
        "messages": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/message" } },
        "maturity": { "const": "producer-consumer-validated" },
        "owner": { "enum": ["frontend-application-contract-foundation", "desktop-host-transport"] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer_contract_version", "limits", "operations", "denied_authority_fields"],
  "properties": {
    "schema_version": { "const": "1.3.0" },
    "renderer_contract_version": { "const": "1.4.0" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_message_bytes", "maximum_page_items", "maximum_chunk_bytes", "maximum_stream_queue_items", "maximum_filter_terms", "maximum_sort_terms", "maximum_bootstrap_recent_runs"],
      "properties": {
        "maximum_message_bytes": { "const": 1048576 }, "maximum_page_items": { "const": 100 }, "maximum_chunk_bytes": { "const": 262144 },
        "maximum_stream_queue_items": { "const": 64 }, "maximum_filter_terms": { "const": 16 }, "maximum_sort_terms": { "const": 4 }, "maximum_bootstrap_recent_runs": { "const": 20 }
      }
    },
    "operations": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/operation" } },
    "denied_authority_fields": {
      "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
      "items": { "enum": ["path", "sql", "command", "command_line", "url", "credential", "provider_request", "filesystem", "coordinator_proxy"] }
    }
  }
}
