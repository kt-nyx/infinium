{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/provider-effect-runtime-authority.v1.schema.json",
  "title": "infinium.provider.effect-runtime-authority/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity", "authority_id", "scope", "kind", "status", "subject_manifest",
    "campaign", "predecessor", "candidate_binding", "review", "owner_decision",
    "not_before_utc", "expires_at_utc", "execution", "limits"
  ],
  "properties": {
    "schema_identity": { "const": "infinium.provider.effect-runtime-authority/v1" },
    "authority_id": { "$ref": "#/$defs/identity" },
    "scope": { "enum": ["effect-free-rehearsal", "external-effect"] },
    "kind": { "enum": ["credential-enrollment", "transport-qualification", "source-claim-extraction", "candidate-investigation"] },
    "status": { "const": "reviewed-and-owner-accepted" },
    "subject_manifest": { "$ref": "#/$defs/manifestBinding" },
    "campaign": { "$ref": "#/$defs/manifestBinding" },
    "predecessor": { "$ref": "#/$defs/predecessor" },
    "candidate_binding": { "$ref": "#/$defs/candidateBinding" },
    "review": { "$ref": "#/$defs/review" },
    "owner_decision": { "$ref": "#/$defs/ownerDecision" },
    "not_before_utc": { "$ref": "#/$defs/utc" },
    "expires_at_utc": { "$ref": "#/$defs/utc" },
    "execution": { "$ref": "#/$defs/execution" },
    "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "manifestBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": { "id": { "$ref": "#/$defs/identity" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["ledger_event_hash", "evidence_id", "evidence_sha256"],
      "properties": {
        "ledger_event_hash": { "type": "string", "minLength": 4, "maxLength": 64 },
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidence_sha256": { "type": "string", "minLength": 4, "maxLength": 64 }
      }
    },
    "candidateBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_commit", "coordinator_sha256", "helper_sha256"],
      "properties": {
        "implementation_commit": { "$ref": "#/$defs/gitSha" },
        "coordinator_sha256": { "$ref": "#/$defs/sha256" },
        "helper_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "evidence_sha256"],
      "properties": { "evidence_id": { "$ref": "#/$defs/identity" }, "evidence_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "ownerDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "decision_sha256"],
      "properties": { "decision_id": { "$ref": "#/$defs/identity" }, "decision_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["output_root_relative", "ledger_path_relative", "product_state_root_relative", "coordinator_path_relative", "helper_path_relative"],
      "properties": {
        "output_root_relative": { "$ref": "#/$defs/relativePath" },
        "ledger_path_relative": { "$ref": "#/$defs/relativePath" },
        "product_state_root_relative": { "$ref": "#/$defs/relativePath" },
        "coordinator_path_relative": { "$ref": "#/$defs/relativePath" },
        "helper_path_relative": { "$ref": "#/$defs/relativePath" }
      }
    },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$" },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["helper_launches", "credential_native_calls", "provider_starts", "dns_resolutions", "billable_operations", "literal_loopback_starts", "automatic_retry", "fourth_call_permitted"],
      "properties": {
        "helper_launches": { "type": "integer", "minimum": 0, "maximum": 1 },
        "credential_native_calls": { "type": "integer", "minimum": 0, "maximum": 4 },
        "provider_starts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "dns_resolutions": { "type": "integer", "minimum": 0, "maximum": 1 },
        "billable_operations": { "type": "integer", "minimum": 0, "maximum": 1 },
        "literal_loopback_starts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "automatic_retry": { "const": false },
        "fourth_call_permitted": { "const": false }
      }
    }
  }
}
