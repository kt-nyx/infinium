{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/renderer-envelope.v1.schema.json",
  "x-infinium-registry": {
    "schema_version": "1.3.0",
    "renderer_contract_version": "1.4.0",
    "limits": {
      "maximum_message_bytes": 1048576,
      "maximum_page_items": 100,
      "maximum_chunk_bytes": 262144,
      "maximum_stream_queue_items": 64,
      "maximum_filter_terms": 16,
      "maximum_sort_terms": 4,
      "maximum_bootstrap_recent_runs": 20
    },
    "operations": [
      {
        "operation": "transport.session.establish",
        "native_target": "DesktopHost.EstablishRendererSession",
        "native_adapter": { "kind": "transport", "request_type": "RendererSessionAcknowledgement", "event_type": "RendererSessionInitialization" },
        "messages": [
          { "message_kind": "event", "direction": "host-to-renderer", "payload_shape": "session-initialization-event", "schema_definition": "sessionInitializationEvent", "gesture": "not-allowed", "outcomes": ["accepted"] },
          { "message_kind": "request", "direction": "renderer-to-host", "payload_shape": "session-acknowledgement-request", "schema_definition": "sessionAcknowledgementRequest", "gesture": "not-allowed" }
        ],
        "maturity": "producer-consumer-validated",
        "owner": "desktop-host-transport"
      },
      {
        "operation": "transport.gesture.grant",
        "native_target": "DesktopHost.GrantRendererGesture",
        "native_adapter": { "kind": "transport", "event_type": "RendererGestureGrant" },
        "messages": [
          { "message_kind": "event", "direction": "host-to-renderer", "payload_shape": "gesture-grant-event", "schema_definition": "gestureGrantEvent", "gesture": "not-allowed", "outcomes": ["accepted"] }
        ],
        "maturity": "producer-consumer-validated",
        "owner": "desktop-host-transport"
      },
      {
        "operation": "application.bootstrap",
        "native_target": "ApplicationService.GetApplicationBootstrap",
        "native_adapter": { "kind": "unary", "request_type": "GetApplicationBootstrapRequest", "response_type": "GetApplicationBootstrapResponse", "client_method": "GetApplicationBootstrapAsync" },
        "messages": [
          { "message_kind": "request", "direction": "renderer-to-host", "payload_shape": "bootstrap-request", "schema_definition": "bootstrapRequest", "gesture": "not-allowed" },
          { "message_kind": "response", "direction": "host-to-renderer", "payload_shape": "bootstrap-response", "schema_definition": "bootstrapResponse", "gesture": "not-allowed", "outcomes": ["accepted", "rejected", "conflict", "unsupported", "unavailable", "cancelled", "indeterminate", "resync-required"] }
        ],
        "maturity": "producer-consumer-validated",
        "owner": "frontend-application-contract-foundation"
      },
      {
        "operation": "results.list",
        "native_target": "ApplicationService.ListResultItems",
        "native_adapter": { "kind": "unary", "request_type": "ListResultItemsRequest", "response_type": "ListResultItemsResponse", "client_method": "ListResultItemsAsync" },
        "messages": [
          { "message_kind": "request", "direction": "renderer-to-host", "payload_shape": "result-list-request", "schema_definition": "resultListRequest", "gesture": "not-allowed" },
          { "message_kind": "response", "direction": "host-to-renderer", "payload_shape": "result-list-response", "schema_definition": "resultListResponse", "gesture": "not-allowed", "outcomes": ["accepted", "rejected", "conflict", "unsupported", "unavailable", "cancelled", "indeterminate", "resync-required"] }
        ],
        "maturity": "producer-consumer-validated",
        "owner": "frontend-application-contract-foundation"
      },
      {
        "operation": "results.detail",
        "native_target": "ApplicationService.GetResultDetail",
        "native_adapter": { "kind": "unary", "request_type": "GetResultDetailRequest", "response_type": "GetResultDetailResponse", "client_method": "GetResultDetailAsync" },
        "messages": [
          { "message_kind": "request", "direction": "renderer-to-host", "payload_shape": "result-detail-request", "schema_definition": "resultDetailRequest", "gesture": "not-allowed" },
          { "message_kind": "response", "direction": "host-to-renderer", "payload_shape": "result-detail-response", "schema_definition": "resultDetailResponse", "gesture": "not-allowed", "outcomes": ["accepted", "rejected", "conflict", "unsupported", "unavailable", "cancelled", "indeterminate", "resync-required"] }
        ],
        "maturity": "producer-consumer-validated",
        "owner": "frontend-application-contract-foundation"
      },
      {
        "operation": "progress.read",
        "native_target": "ApplicationService.GetProgress",
        "native_adapter": { "kind": "unary", "request_type": "GetProgressRequest", "response_type": "GetProgressResponse", "client_method": "GetProgressAsync" },
        "messages": [
          { "message_kind": "request", "direction": "renderer-to-host", "payload_shape": "progress-request", "schema_definition": "progressRequest", "gesture": "not-allowed" },
          { "message_kind": "response", "direction": "host-to-renderer", "payload_shape": "progress-response", "schema_definition": "progressResponse", "gesture": "not-allowed", "outcomes": ["accepted", "rejected", "conflict", "unsupported", "unavailable", "cancelled", "indeterminate", "resync-required"] }
        ],
        "maturity": "producer-consumer-validated",
        "owner": "frontend-application-contract-foundation"
      },
      {
        "operation": "progress.subscribe",
        "native_target": "ApplicationService.SubscribeEvents",
        "native_adapter": { "kind": "stream", "request_type": "SubscribeEventsRequest", "event_type": "ApplicationEvent", "client_method": "SubscribeEventsAsync" },
        "messages": [
          { "message_kind": "request", "direction": "renderer-to-host", "payload_shape": "progress-subscription-request", "schema_definition": "progressSubscriptionRequest", "gesture": "not-allowed" },
          { "message_kind": "event", "direction": "host-to-renderer", "payload_shape": "progress-event", "schema_definition": "progressEvent", "gesture": "not-allowed", "outcomes": ["accepted", "resync-required"] }
        ],
        "maturity": "producer-consumer-validated",
        "owner": "frontend-application-contract-foundation"
      },
      {
        "operation": "application.cancel",
        "native_target": "DesktopHost.TransportCancellation",
        "native_adapter": { "kind": "host", "request_type": "RendererCancellationRequest", "response_type": "RendererHostControlReceipt", "client_method": "CancelTransportAsync" },
        "messages": [
          { "message_kind": "request", "direction": "renderer-to-host", "payload_shape": "cancel-request", "schema_definition": "cancelRequest", "gesture": "required" },
          { "message_kind": "response", "direction": "host-to-renderer", "payload_shape": "cancel-response", "schema_definition": "cancelResponse", "gesture": "not-allowed", "outcomes": ["accepted", "rejected", "conflict", "unsupported", "unavailable", "cancelled", "indeterminate", "resync-required"] }
        ],
        "maturity": "producer-consumer-validated",
        "owner": "frontend-application-contract-foundation"
      },
      {
        "operation": "application.resync-required",
        "native_target": "DesktopHost.ResyncProjection",
        "native_adapter": { "kind": "host", "request_type": "RendererResyncRequest", "response_type": "RendererHostControlReceipt", "client_method": "ResyncProjectionAsync" },
        "messages": [
          { "message_kind": "event", "direction": "host-to-renderer", "payload_shape": "resync-required-event", "schema_definition": "resyncEvent", "gesture": "not-allowed", "outcomes": ["resync-required"] }
        ],
        "maturity": "producer-consumer-validated",
        "owner": "frontend-application-contract-foundation"
      }
    ],
    "denied_authority_fields": ["path", "sql", "command", "command_line", "url", "credential", "provider_request", "filesystem", "coordinator_proxy"]
  },
  "title": "Infinium closed renderer envelope v1",
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "opaqueProductIdentity": { "type": "string", "minLength": 1, "maxLength": 160 },
    "revision": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,256}$" },
    "uint64": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "positiveUInt64": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "opaqueCursor": { "type": "string", "minLength": 1, "maxLength": 10923, "pattern": "^[A-Za-z0-9_-]+$" },
    "lifecycleState": { "enum": ["queued", "running", "waiting", "retrying", "pausing", "paused", "cancelling", "cancelled", "completed", "completed-with-gaps", "failed", "limit-reached", "invalidated-by-changed-input"] },
    "resultItemKind": { "enum": ["supported-case", "lead-only-case", "finding", "abstention", "failure", "coverage-gap"] },
    "inertErrorBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "inert_detail", "retry_may_be_safe"],
      "properties": {
        "code": { "type": "string" },
        "inert_detail": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "retry_may_be_safe": { "type": "boolean" }
      }
    },
    "rejectedError": {
      "allOf": [
        { "$ref": "#/$defs/inertErrorBase" },
        { "properties": { "code": { "enum": ["invalid-argument", "unauthenticated", "unauthorized", "not-found", "incompatible-version", "limit-exceeded", "deadline-expired", "stale-fence", "internal", "replayed", "out-of-order"] } } }
      ]
    },
    "conflictError": {
      "allOf": [{ "$ref": "#/$defs/inertErrorBase" }, { "properties": { "code": { "const": "conflict" } } }]
    },
    "unsupportedError": {
      "allOf": [{ "$ref": "#/$defs/inertErrorBase" }, { "properties": { "code": { "const": "unsupported" } } }]
    },
    "unavailableError": {
      "allOf": [{ "$ref": "#/$defs/inertErrorBase" }, { "properties": { "code": { "const": "unavailable" } } }]
    },
    "cancelledError": {
      "allOf": [{ "$ref": "#/$defs/inertErrorBase" }, { "properties": { "code": { "const": "cancelled" } } }]
    },
    "indeterminateError": {
      "allOf": [{ "$ref": "#/$defs/inertErrorBase" }, { "properties": { "code": { "const": "indeterminate" } } }]
    },
    "resyncRequiredError": {
      "allOf": [{ "$ref": "#/$defs/inertErrorBase" }, { "properties": { "code": { "const": "resync-required" } } }]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_revision", "current_revision", "disposition"],
      "properties": {
        "expected_revision": { "$ref": "#/$defs/revision" },
        "current_revision": { "$ref": "#/$defs/revision" },
        "disposition": { "enum": ["stale-revision", "already-applied", "resync-required"] }
      }
    },
    "rejectedResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "error"],
      "properties": { "outcome": { "const": "rejected" }, "error": { "$ref": "#/$defs/rejectedError" } }
    },
    "conflictResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "error", "conflict"],
      "properties": {
        "outcome": { "const": "conflict" }, "error": { "$ref": "#/$defs/conflictError" }, "conflict": { "$ref": "#/$defs/conflict" }
      }
    },
    "unsupportedResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "error"],
      "properties": { "outcome": { "const": "unsupported" }, "error": { "$ref": "#/$defs/unsupportedError" } }
    },
    "unavailableResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "error"],
      "properties": { "outcome": { "const": "unavailable" }, "error": { "$ref": "#/$defs/unavailableError" } }
    },
    "cancelledResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "error"],
      "properties": { "outcome": { "const": "cancelled" }, "error": { "$ref": "#/$defs/cancelledError" } }
    },
    "indeterminateResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "error"],
      "properties": { "outcome": { "const": "indeterminate" }, "error": { "$ref": "#/$defs/indeterminateError" } }
    },
    "resyncRequiredResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "error", "current_projection_version"],
      "properties": {
        "outcome": { "const": "resync-required" },
        "error": { "$ref": "#/$defs/resyncRequiredError" },
        "current_projection_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_contract_version", "domain_contract_version", "storage_contract_version", "renderer_contract_version", "coordinator_health", "configuration_availability", "capabilities", "recent_runs", "projection_version", "coordinator_instance_id", "coordinator_fencing_epoch"],
      "properties": {
        "application_contract_version": { "const": "1.13.0" },
        "domain_contract_version": { "const": "1.6.0" },
        "storage_contract_version": { "const": "1.16.0" },
      "renderer_contract_version": { "const": "1.4.0" },
        "coordinator_health": { "enum": ["healthy", "degraded", "unavailable"] },
        "configuration_availability": { "enum": ["available", "partial", "unavailable"] },
        "capabilities": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["capability", "availability", "inert_reason"],
            "properties": {
              "capability": { "enum": ["bootstrap", "run-query", "event-resync", "configuration", "provider-enrollment", "result-exploration", "durable-user-review"] },
              "availability": { "enum": ["available", "partial", "unavailable"] },
              "inert_reason": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        "recent_runs": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["run_id", "lifecycle_state", "lifecycle_generation"],
            "properties": {
              "run_id": { "$ref": "#/$defs/opaqueProductIdentity" },
              "lifecycle_state": { "$ref": "#/$defs/lifecycleState" },
              "lifecycle_generation": { "$ref": "#/$defs/uint64" }
            }
          }
        },
        "projection_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "coordinator_instance_id": { "$ref": "#/$defs/opaqueProductIdentity" },
        "coordinator_fencing_epoch": { "$ref": "#/$defs/uint64" }
      }
    },
    "bootstrapRequest": {
      "type": "object", "additionalProperties": false, "required": ["maximum_recent_runs"],
      "properties": {
        "maximum_recent_runs": { "type": "integer", "minimum": 1, "maximum": 20 },
        "expected_projection_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "bootstrapAcceptedResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "bootstrap"],
      "properties": { "outcome": { "const": "accepted" }, "bootstrap": { "$ref": "#/$defs/bootstrap" } }
    },
    "bootstrapResponse": {
      "oneOf": [
        { "$ref": "#/$defs/bootstrapAcceptedResponse" }, { "$ref": "#/$defs/rejectedResponse" },
        { "$ref": "#/$defs/conflictResponse" }, { "$ref": "#/$defs/unsupportedResponse" },
        { "$ref": "#/$defs/unavailableResponse" }, { "$ref": "#/$defs/cancelledResponse" },
        { "$ref": "#/$defs/indeterminateResponse" }, { "$ref": "#/$defs/resyncRequiredResponse" }
      ]
    },
    "resultListRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "kinds", "search_text", "sort", "requested_page_size"],
      "properties": {
        "run_id": { "$ref": "#/$defs/opaqueProductIdentity" },
        "kinds": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/resultItemKind" } },
        "search_text": { "type": "string", "maxLength": 160 },
        "sort": { "enum": ["identity-ascending", "severity-descending-identity-ascending"] },
        "requested_page_size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "after_cursor": { "$ref": "#/$defs/opaqueCursor" },
        "expected_projection_version": { "$ref": "#/$defs/revision" }
      }
    },
    "resultSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "run_id", "kind", "logical_id", "inert_summary", "severity", "confidence", "analyzer_id", "analyzer_version"],
      "properties": {
        "item_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "run_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "kind": { "$ref": "#/$defs/resultItemKind" },
        "logical_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "case_occurrence_id": { "$ref": "#/$defs/opaqueProductIdentity" },
        "inert_summary": { "type": "string", "maxLength": 4096 }, "severity": { "type": "string", "minLength": 1, "maxLength": 64 },
        "confidence": { "type": "string", "minLength": 1, "maxLength": 64 }, "analyzer_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "analyzer_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "resultListAcceptedResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "page"],
      "properties": {
        "outcome": { "const": "accepted" },
        "page": {
          "type": "object", "additionalProperties": false, "required": ["items", "has_more", "projection_version"],
          "properties": { "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/resultSummary" } }, "next_cursor": { "$ref": "#/$defs/opaqueCursor" }, "has_more": { "type": "boolean" }, "projection_version": { "$ref": "#/$defs/revision" } },
          "if": { "properties": { "has_more": { "const": true } } },
          "then": { "required": ["next_cursor"] },
          "else": { "not": { "required": ["next_cursor"] } }
        }
      }
    },
    "resultListResponse": { "oneOf": [{ "$ref": "#/$defs/resultListAcceptedResponse" }, { "$ref": "#/$defs/rejectedResponse" }, { "$ref": "#/$defs/conflictResponse" }, { "$ref": "#/$defs/unsupportedResponse" }, { "$ref": "#/$defs/unavailableResponse" }, { "$ref": "#/$defs/cancelledResponse" }, { "$ref": "#/$defs/indeterminateResponse" }, { "$ref": "#/$defs/resyncRequiredResponse" }] },
    "resultDetailRequest": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "kind", "item_id"],
      "properties": { "run_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "kind": { "$ref": "#/$defs/resultItemKind" }, "item_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "expected_projection_version": { "$ref": "#/$defs/revision" } }
    },
    "resultDetailAcceptedResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "detail"],
      "properties": {
        "outcome": { "const": "accepted" },
        "detail": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "inert_conclusion", "inert_cause", "evidence_ids", "contradicting_evidence_ids", "recommendation_ids", "taxonomy_assignment_ids", "finding_occurrence_ids", "hypothesis_ids", "inert_uncertainty", "inert_gaps", "source_payload_id", "source_payload_sha256", "subject_ids", "projection_version"],
          "properties": {
            "summary": { "$ref": "#/$defs/resultSummary" }, "inert_conclusion": { "type": "string", "maxLength": 4096 }, "inert_cause": { "type": "string", "maxLength": 4096 },
            "evidence_ids": { "$ref": "#/$defs/identityArray" }, "contradicting_evidence_ids": { "$ref": "#/$defs/identityArray" }, "recommendation_ids": { "$ref": "#/$defs/identityArray" },
            "taxonomy_assignment_ids": { "$ref": "#/$defs/identityArray" }, "finding_occurrence_ids": { "$ref": "#/$defs/identityArray" }, "hypothesis_ids": { "$ref": "#/$defs/identityArray" },
            "inert_uncertainty": { "$ref": "#/$defs/inertTextArray" }, "inert_gaps": { "$ref": "#/$defs/inertTextArray" }, "source_payload_id": { "$ref": "#/$defs/opaqueProductIdentity" },
            "source_payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "subject_ids": { "$ref": "#/$defs/identityArray" }, "projection_version": { "$ref": "#/$defs/revision" }
          }
        }
      }
    },
    "identityArray": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/opaqueProductIdentity" } },
    "inertTextArray": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 4096 } },
    "resultDetailResponse": { "oneOf": [{ "$ref": "#/$defs/resultDetailAcceptedResponse" }, { "$ref": "#/$defs/rejectedResponse" }, { "$ref": "#/$defs/conflictResponse" }, { "$ref": "#/$defs/unsupportedResponse" }, { "$ref": "#/$defs/unavailableResponse" }, { "$ref": "#/$defs/cancelledResponse" }, { "$ref": "#/$defs/indeterminateResponse" }, { "$ref": "#/$defs/resyncRequiredResponse" }] },
    "progressRequest": { "type": "object", "additionalProperties": false, "required": ["run_id"], "properties": { "run_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "expected_projection_version": { "$ref": "#/$defs/revision" } } },
    "optionalUInt64": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["availability", "value"], "properties": { "availability": { "const": "available" }, "value": { "$ref": "#/$defs/uint64" } } },
        { "type": "object", "additionalProperties": false, "required": ["availability"], "properties": { "availability": { "enum": ["unavailable", "unsupported", "unknown"] } } }
      ]
    },
    "optionalInt64": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["availability", "value"], "properties": { "availability": { "const": "available" }, "value": { "type": "string", "pattern": "^(0|-?[1-9][0-9]{0,18})$" } } },
        { "type": "object", "additionalProperties": false, "required": ["availability"], "properties": { "availability": { "enum": ["unavailable", "unsupported", "unknown"] } } }
      ]
    },
    "progressProjection": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "lifecycle_state", "progress", "cost", "projection_version", "durable_event_sequence", "observed_at"],
      "properties": {
        "run_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "lifecycle_state": { "$ref": "#/$defs/lifecycleState" },
        "progress": {
          "type": "object", "additionalProperties": false,
          "required": ["denominator_state", "population_revision", "total_units", "completed_units", "reused_units", "queued_units", "running_units", "failed_units", "skipped_units", "unsupported_units", "limited_units", "invalidated_units", "gap_units"],
          "properties": {
            "denominator_state": { "enum": ["known", "enumerating", "unavailable", "unknown", "unsupported"] }, "population_revision": { "$ref": "#/$defs/uint64" }, "total_units": { "$ref": "#/$defs/optionalUInt64" },
            "completed_units": { "$ref": "#/$defs/uint64" }, "reused_units": { "$ref": "#/$defs/uint64" }, "queued_units": { "$ref": "#/$defs/uint64" }, "running_units": { "$ref": "#/$defs/uint64" },
            "failed_units": { "$ref": "#/$defs/uint64" }, "skipped_units": { "$ref": "#/$defs/uint64" }, "unsupported_units": { "$ref": "#/$defs/uint64" }, "limited_units": { "$ref": "#/$defs/uint64" },
            "invalidated_units": { "$ref": "#/$defs/uint64" }, "gap_units": { "$ref": "#/$defs/uint64" }
          }
        },
        "cost": {
          "type": "object", "additionalProperties": false,
          "required": ["reserved_nano_usd", "calculated_actual_nano_usd", "provider_input_tokens", "provider_output_tokens", "provider_reasoning_tokens", "provider_dispatch_count", "provider_tool_call_count", "has_unresolved_hold"],
          "properties": {
            "reserved_nano_usd": { "$ref": "#/$defs/optionalInt64" }, "calculated_actual_nano_usd": { "$ref": "#/$defs/optionalInt64" }, "provider_input_tokens": { "$ref": "#/$defs/optionalUInt64" },
            "provider_output_tokens": { "$ref": "#/$defs/optionalUInt64" }, "provider_reasoning_tokens": { "$ref": "#/$defs/optionalUInt64" }, "provider_dispatch_count": { "$ref": "#/$defs/optionalUInt64" },
            "provider_tool_call_count": { "$ref": "#/$defs/optionalUInt64" }, "has_unresolved_hold": { "type": "boolean" }
          }
        },
        "projection_version": { "$ref": "#/$defs/revision" }, "durable_event_sequence": { "$ref": "#/$defs/uint64" }, "observed_at": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "progressAcceptedResponse": { "type": "object", "additionalProperties": false, "required": ["outcome", "progress"], "properties": { "outcome": { "const": "accepted" }, "progress": { "$ref": "#/$defs/progressProjection" } } },
    "progressResponse": { "oneOf": [{ "$ref": "#/$defs/progressAcceptedResponse" }, { "$ref": "#/$defs/rejectedResponse" }, { "$ref": "#/$defs/conflictResponse" }, { "$ref": "#/$defs/unsupportedResponse" }, { "$ref": "#/$defs/unavailableResponse" }, { "$ref": "#/$defs/cancelledResponse" }, { "$ref": "#/$defs/indeterminateResponse" }, { "$ref": "#/$defs/resyncRequiredResponse" }] },
    "progressSubscriptionRequest": {
      "type": "object", "additionalProperties": false, "required": ["subscription_id", "run_id", "requested_queue_items"],
      "properties": { "subscription_id": { "$ref": "#/$defs/identifier" }, "run_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "after_cursor": { "$ref": "#/$defs/opaqueCursor" }, "expected_projection_version": { "$ref": "#/$defs/revision" }, "requested_queue_items": { "type": "integer", "minimum": 1, "maximum": 64 } }
    },
    "applicationEventMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinator_instance_id", "coordinator_fencing_epoch", "subscription_id", "durable_event_sequence", "projection_version", "run_scope", "resume_cursor"],
      "properties": {
        "coordinator_instance_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "coordinator_fencing_epoch": { "$ref": "#/$defs/uint64" },
        "subscription_id": { "$ref": "#/$defs/identifier" }, "durable_event_sequence": { "$ref": "#/$defs/uint64" }, "projection_version": { "$ref": "#/$defs/revision" },
        "run_scope": { "$ref": "#/$defs/opaqueProductIdentity" }, "resume_cursor": { "$ref": "#/$defs/opaqueCursor" }
      }
    },
    "progressEvent": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["outcome", "event_kind", "metadata", "progress"], "properties": { "outcome": { "const": "accepted" }, "event_kind": { "const": "progress" }, "metadata": { "$ref": "#/$defs/applicationEventMetadata" }, "progress": { "$ref": "#/$defs/progressProjection" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["outcome", "event_kind", "metadata", "lifecycle_changed"],
          "properties": {
            "outcome": { "const": "accepted" }, "event_kind": { "const": "lifecycle-changed" }, "metadata": { "$ref": "#/$defs/applicationEventMetadata" },
            "lifecycle_changed": {
              "type": "object", "additionalProperties": false, "required": ["previous_state", "current_state", "lifecycle_generation", "transition_id", "transition_record_kind", "lifecycle_policy_version"],
              "properties": { "previous_state": { "$ref": "#/$defs/lifecycleState" }, "current_state": { "$ref": "#/$defs/lifecycleState" }, "lifecycle_generation": { "$ref": "#/$defs/uint64" }, "transition_id": { "$ref": "#/$defs/opaqueProductIdentity" }, "transition_record_kind": { "enum": ["requested", "observed"] }, "lifecycle_policy_version": { "type": "string", "minLength": 1, "maxLength": 64 } }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["outcome", "event_kind", "metadata", "reason", "error", "current_projection_version"],
          "properties": { "outcome": { "const": "resync-required" }, "event_kind": { "enum": ["projection-invalidated", "resync-required"] }, "metadata": { "$ref": "#/$defs/applicationEventMetadata" }, "reason": { "enum": ["slow-client", "queue-overflow", "sequence-gap", "coordinator-restart", "replay-window-expired", "projection-rebuilt", "cursor-invalid"] }, "error": { "$ref": "#/$defs/resyncRequiredError" }, "current_projection_version": { "$ref": "#/$defs/revision" } }
        }
      ]
    },
    "cancelRequest": {
      "type": "object", "additionalProperties": false, "required": ["target_request_id"],
      "properties": { "target_request_id": { "$ref": "#/$defs/identifier" } }
    },
    "cancelAcceptedResponse": {
      "type": "object", "additionalProperties": false, "required": ["outcome"],
      "properties": { "outcome": { "const": "accepted" } }
    },
    "cancelResponse": {
      "oneOf": [
        { "$ref": "#/$defs/cancelAcceptedResponse" }, { "$ref": "#/$defs/rejectedResponse" },
        { "$ref": "#/$defs/conflictResponse" }, { "$ref": "#/$defs/unsupportedResponse" },
        { "$ref": "#/$defs/unavailableResponse" }, { "$ref": "#/$defs/cancelledResponse" },
        { "$ref": "#/$defs/indeterminateResponse" }, { "$ref": "#/$defs/resyncRequiredResponse" }
      ]
    },
    "sessionInitializationEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "origin", "renderer_contract_version", "renderer_registry_version", "renderer_registry_sha256"],
      "properties": {
        "outcome": { "const": "accepted" },
        "origin": { "const": "https://app.infinium.invalid" },
        "renderer_contract_version": { "const": "1.4.0" },
        "renderer_registry_version": { "const": "1.3.0" },
        "renderer_registry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "sessionAcknowledgementRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["renderer_registry_version", "renderer_registry_sha256"],
      "properties": {
        "renderer_registry_version": { "const": "1.3.0" },
        "renderer_registry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "gestureGrantEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "gesture_id", "target_request_id", "operation"],
      "properties": {
        "outcome": { "const": "accepted" },
        "gesture_id": { "$ref": "#/$defs/identifier" },
        "target_request_id": { "$ref": "#/$defs/identifier" },
        "operation": { "const": "application.cancel" }
      }
    },
    "resyncEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "error", "current_projection_version"],
      "properties": {
        "outcome": { "const": "resync-required" },
        "error": { "$ref": "#/$defs/resyncRequiredError" },
        "current_projection_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "message_kind", "session_id", "sequence", "operation", "payload"],
  "properties": {
    "contract_version": { "const": "1.4.0" },
    "message_kind": { "enum": ["request", "response", "event"] },
    "session_id": { "$ref": "#/$defs/identifier" },
    "sequence": { "$ref": "#/$defs/positiveUInt64" },
    "request_id": { "$ref": "#/$defs/identifier" },
    "subscription_id": { "$ref": "#/$defs/identifier" },
    "revision": { "$ref": "#/$defs/revision" },
    "operation": { "enum": ["transport.session.establish", "transport.gesture.grant", "application.bootstrap", "results.list", "results.detail", "progress.read", "progress.subscribe", "application.cancel", "application.resync-required"] },
    "gesture_proof": {
      "type": "object", "additionalProperties": false, "required": ["gesture_id"],
      "properties": { "gesture_id": { "$ref": "#/$defs/identifier" } }
    },
    "payload": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": { "message_kind": { "const": "event" }, "operation": { "const": "transport.session.establish" }, "payload": { "$ref": "#/$defs/sessionInitializationEvent" } },
      "not": { "anyOf": [{ "required": ["request_id"] }, { "required": ["subscription_id"] }, { "required": ["gesture_proof"] }, { "required": ["revision"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "request" }, "operation": { "const": "transport.session.establish" }, "payload": { "$ref": "#/$defs/sessionAcknowledgementRequest" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }, { "required": ["revision"] }] }
    },
    {
      "properties": { "message_kind": { "const": "event" }, "operation": { "const": "transport.gesture.grant" }, "payload": { "$ref": "#/$defs/gestureGrantEvent" } },
      "not": { "anyOf": [{ "required": ["request_id"] }, { "required": ["subscription_id"] }, { "required": ["gesture_proof"] }, { "required": ["revision"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "request" }, "operation": { "const": "application.bootstrap" }, "payload": { "$ref": "#/$defs/bootstrapRequest" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }, { "required": ["revision"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "response" }, "operation": { "const": "application.bootstrap" }, "payload": { "$ref": "#/$defs/bootstrapResponse" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "request" }, "operation": { "const": "results.list" }, "payload": { "$ref": "#/$defs/resultListRequest" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }, { "required": ["revision"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "response" }, "operation": { "const": "results.list" }, "payload": { "$ref": "#/$defs/resultListResponse" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "request" }, "operation": { "const": "results.detail" }, "payload": { "$ref": "#/$defs/resultDetailRequest" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }, { "required": ["revision"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "response" }, "operation": { "const": "results.detail" }, "payload": { "$ref": "#/$defs/resultDetailResponse" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "request" }, "operation": { "const": "progress.read" }, "payload": { "$ref": "#/$defs/progressRequest" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }, { "required": ["revision"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "response" }, "operation": { "const": "progress.read" }, "payload": { "$ref": "#/$defs/progressResponse" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "request" }, "operation": { "const": "progress.subscribe" }, "payload": { "$ref": "#/$defs/progressSubscriptionRequest" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }, { "required": ["revision"] }] }
    },
    {
      "required": ["subscription_id", "revision"],
      "properties": { "message_kind": { "const": "event" }, "operation": { "const": "progress.subscribe" }, "payload": { "$ref": "#/$defs/progressEvent" } },
      "not": { "anyOf": [{ "required": ["request_id"] }, { "required": ["gesture_proof"] }] }
    },
    {
      "required": ["request_id", "gesture_proof"],
      "properties": { "message_kind": { "const": "request" }, "operation": { "const": "application.cancel" }, "payload": { "$ref": "#/$defs/cancelRequest" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["revision"] }] }
    },
    {
      "required": ["request_id"],
      "properties": { "message_kind": { "const": "response" }, "operation": { "const": "application.cancel" }, "payload": { "$ref": "#/$defs/cancelResponse" } },
      "not": { "anyOf": [{ "required": ["subscription_id"] }, { "required": ["gesture_proof"] }] }
    },
    {
      "required": ["subscription_id", "revision"],
      "properties": { "message_kind": { "const": "event" }, "operation": { "const": "application.resync-required" }, "payload": { "$ref": "#/$defs/resyncEvent" } },
      "not": { "anyOf": [{ "required": ["request_id"] }, { "required": ["gesture_proof"] }] }
    }
  ]
}
