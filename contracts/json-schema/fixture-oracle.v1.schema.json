{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/fixture-oracle.v1.schema.json",
  "title": "Infinium evaluation fixture independent oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "fixture_version",
    "oracle_version",
    "independent_authors_and_reviewers",
    "ground_truth_methods",
    "expected_observations",
    "expected_deterministic_results",
    "expected_external_claims",
    "expected_application_links",
    "expected_discovery_leads",
    "expected_model_proposals",
    "expected_proposal_admissions",
    "expected_candidates",
    "expected_hypotheses",
    "expected_findings",
    "expected_recommendations",
    "expected_supported_cases",
    "expected_lead_only_cases",
    "expected_abstentions",
    "expected_invalid_inputs",
    "expected_failures",
    "expected_documentation_revisions",
    "expected_passages",
    "expected_candidate_decisions",
    "expected_reconciliation_assessments",
    "expected_lineage_events",
    "expected_coverage_and_gaps",
    "expected_collection_states",
    "expected_taxonomy_assignments",
    "expected_replayability",
    "expected_replay_manifest",
    "expected_not_used_boundaries",
    "forbidden_claims",
    "known_limits",
    "pre_registered_at",
    "change_history"
  ],
  "properties": {
    "fixture_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "fixture_version": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
    },
    "oracle_version": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
    },
    "independent_authors_and_reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/identifier"
      }
    },
    "ground_truth_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method_id",
          "method",
          "evidence_references",
          "independent_of_system_under_test"
        ],
        "properties": {
          "method_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "method": {
            "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
          },
          "evidence_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.v1.schema.json#/$defs/artifactReference"
            }
          },
          "independent_of_system_under_test": {
            "const": true
          }
        }
      }
    },
    "expected_observations": {
      "$ref": "#/$defs/expectedObservationCollection"
    },
    "expected_deterministic_results": {
      "$ref": "#/$defs/expectedDeterministicResultCollection"
    },
    "expected_external_claims": {
      "$ref": "#/$defs/expectedExternalClaimCollection"
    },
    "expected_application_links": {
      "$ref": "#/$defs/expectedApplicationLinkCollection"
    },
    "expected_discovery_leads": {
      "$ref": "#/$defs/expectedDiscoveryLeadCollection"
    },
    "expected_model_proposals": {
      "$ref": "#/$defs/expectedModelProposalCollection"
    },
    "expected_proposal_admissions": {
      "$ref": "#/$defs/expectedProposalAdmissionCollection"
    },
    "expected_candidates": {
      "$ref": "#/$defs/expectedCandidateCollection"
    },
    "expected_hypotheses": {
      "$ref": "#/$defs/expectedHypothesisCollection"
    },
    "expected_findings": {
      "$ref": "#/$defs/expectedFindingCollection"
    },
    "expected_recommendations": {
      "$ref": "#/$defs/expectedRecommendationCollection"
    },
    "expected_supported_cases": {
      "$ref": "#/$defs/expectedSupportedCaseCollection"
    },
    "expected_lead_only_cases": {
      "$ref": "#/$defs/expectedLeadOnlyCaseCollection"
    },
    "expected_abstentions": {
      "$ref": "#/$defs/expectedAbstentionCollection"
    },
    "expected_invalid_inputs": {
      "$ref": "#/$defs/expectedInvalidInputCollection"
    },
    "expected_failures": {
      "$ref": "#/$defs/expectedFailureCollection"
    },
    "expected_documentation_revisions": {
      "type": "array", "items": { "$ref": "#/$defs/expectedItem" }
    },
    "expected_passages": {
      "type": "array", "items": { "$ref": "#/$defs/expectedItem" }
    },
    "expected_candidate_decisions": {
      "type": "array", "items": { "$ref": "#/$defs/expectedItem" }
    },
    "expected_reconciliation_assessments": {
      "type": "array", "items": { "$ref": "#/$defs/expectedItem" }
    },
    "expected_lineage_events": {
      "type": "array", "items": { "$ref": "#/$defs/expectedItem" }
    },
    "expected_coverage_and_gaps": {
      "$ref": "#/$defs/expectedCoverageAndGapCollection"
    },
    "expected_collection_states": {
      "$ref": "#/$defs/expectedCollectionStates"
    },
    "expected_taxonomy_assignments": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "common.v1.schema.json#/$defs/taxonomyAssignment"
          },
          {
            "type": "object",
            "properties": {
              "taxonomy_id": {
                "const": "infinium.skyrim-se.mod-impact-taxonomy"
              },
              "taxonomy_version": {
                "const": "0.1.0"
              }
            }
          }
        ]
      }
    },
    "expected_replayability": {
      "enum": [
        "complete-clean",
        "boundary-replay",
        "audit-only",
        "unavailable"
      ]
    },
    "expected_replay_manifest": {
      "$ref": "common.v1.schema.json#/$defs/artifactReference"
    },
    "expected_not_used_boundaries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["provider", "hosted-search", "nexus", "loot"] }
    },
    "forbidden_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_type",
          "reason"
        ],
        "properties": {
          "claim_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "claim_type": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "reason": {
            "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "known_limits": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
      }
    },
    "pre_registered_at": {
      "$ref": "common.v1.schema.json#/$defs/utcTimestamp"
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "oracle_version",
          "changed_at",
          "independent_evidence_reference",
          "prior_error_explanation",
          "reviewer"
        ],
        "properties": {
          "oracle_version": {
            "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
          },
          "changed_at": {
            "$ref": "common.v1.schema.json#/$defs/utcTimestamp"
          },
          "independent_evidence_reference": {
            "$ref": "common.v1.schema.json#/$defs/artifactReference"
          },
          "prior_error_explanation": {
            "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
          },
          "reviewer": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          }
        }
      }
    }
  },
  "$defs": {
    "expectedObservationCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "observation"
          }
        }
      }
    },
    "expectedDeterministicResultCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "deterministic-result"
          }
        }
      }
    },
    "expectedExternalClaimCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "external-claim"
          }
        }
      }
    },
    "expectedApplicationLinkCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "application-link"
          }
        }
      }
    },
    "expectedDiscoveryLeadCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "discovery-lead"
          }
        }
      }
    },
    "expectedModelProposalCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "model-proposal"
          }
        }
      }
    },
    "expectedProposalAdmissionCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "proposal-admission"
          }
        }
      }
    },
    "expectedCandidateCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "candidate"
          }
        }
      }
    },
    "expectedHypothesisCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "hypothesis"
          }
        }
      }
    },
    "expectedFindingCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "finding"
          }
        }
      }
    },
    "expectedRecommendationCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "recommendation"
          }
        }
      }
    },
    "expectedSupportedCaseCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "supported-case"
          }
        }
      }
    },
    "expectedLeadOnlyCaseCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "lead-only-case"
          }
        }
      }
    },
    "expectedAbstentionCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "abstention"
          }
        }
      }
    },
    "expectedInvalidInputCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "invalid-input"
          }
        }
      }
    },
    "expectedFailureCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "const": "failure"
          }
        }
      }
    },
    "expectedCoverageAndGapCollection": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/expectedItem",
        "properties": {
          "expected_type": {
            "enum": [
              "coverage",
              "coverage-gap",
              "audit-gap"
            ]
          }
        }
      }
    },
    "expectedCollectionStates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "deterministic_results",
        "external_claims",
        "application_links",
        "discovery_leads",
        "model_proposals",
        "proposal_admissions",
        "candidates",
        "hypotheses",
        "findings",
        "recommendations",
        "supported_cases",
        "lead_only_cases",
        "abstentions",
        "invalid_inputs",
        "coverage_gaps",
        "failures"
      ],
      "properties": {
        "observations": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "deterministic_results": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "external_claims": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "application_links": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "discovery_leads": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "model_proposals": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "proposal_admissions": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "candidates": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "hypotheses": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "findings": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "recommendations": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "supported_cases": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "lead_only_cases": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "abstentions": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "invalid_inputs": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "coverage_gaps": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        },
        "failures": {
          "$ref": "common.v1.schema.json#/$defs/collectionState"
        }
      }
    },
    "expectedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_id",
        "subject_id",
        "expected_type",
        "expected_state",
        "ground_truth_method_ids",
        "canonical_value_fingerprint"
      ],
      "properties": {
        "expected_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "subject_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "expected_type": {
          "enum": [
            "observation",
            "deterministic-result",
            "external-claim",
            "application-link",
            "discovery-lead",
            "model-proposal",
            "proposal-admission",
            "candidate",
            "hypothesis",
            "finding",
            "recommendation",
            "supported-case",
            "lead-only-case",
            "abstention",
            "invalid-input",
            "failure",
            "coverage-gap",
            "coverage",
            "audit-gap",
            "documentation-revision",
            "passage",
            "candidate-decision",
            "reconciliation-assessment",
            "lineage-event"
          ]
        },
        "expected_state": {
          "enum": [
            "present",
            "absent",
            "empty",
            "unsupported",
            "unknown",
            "unmapped",
            "not-applicable",
            "failed",
            "skipped-by-configuration",
            "skipped-by-limit"
          ]
        },
        "ground_truth_method_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          }
        },
        "canonical_value_fingerprint": {
          "$ref": "common.v1.schema.json#/$defs/fingerprint"
        }
      }
    }
  }
}
