{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/documentation-fixture-case-matrix.v1.schema.json",
  "title": "Infinium WP2 documentation fixture case matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "fixture_version",
    "application_targets",
    "aggregate_output_binding",
    "cases"
  ],
  "properties": {
    "fixture_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "fixture_version": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" },
    "execution_binding": { "$ref": "#/$defs/executionBinding" },
    "clean_execution_binding": { "$ref": "#/$defs/executionBinding" },
    "application_targets": { "$ref": "#/$defs/applicationTargets" },
    "aggregate_output_binding": {
      "oneOf": [
        { "$ref": "#/$defs/coreAggregateBinding" },
        { "$ref": "#/$defs/adversarialAggregateBinding" }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/simpleCase" },
          { "$ref": "#/$defs/mutationCase" },
          { "$ref": "#/$defs/deletedReuseCase" },
          { "$ref": "#/$defs/unavailableReuseCase" }
        ]
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/coreMatrix" },
    { "$ref": "#/$defs/adversarialMatrix" }
  ],
  "$defs": {
    "coreMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "fixture_version",
        "execution_binding",
        "application_targets",
        "aggregate_output_binding",
        "cases"
      ],
      "properties": {
        "fixture_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "fixture_version": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" },
        "execution_binding": { "$ref": "#/$defs/executionBinding" },
        "application_targets": { "$ref": "#/$defs/applicationTargets" },
        "aggregate_output_binding": { "$ref": "#/$defs/coreAggregateBinding" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/simpleCase" }
        }
      }
    },
    "adversarialMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "fixture_version",
        "clean_execution_binding",
        "application_targets",
        "aggregate_output_binding",
        "cases"
      ],
      "properties": {
        "fixture_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "fixture_version": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" },
        "clean_execution_binding": { "$ref": "#/$defs/executionBinding" },
        "application_targets": { "$ref": "#/$defs/applicationTargets" },
        "aggregate_output_binding": { "$ref": "#/$defs/adversarialAggregateBinding" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/simpleCase" },
              { "$ref": "#/$defs/mutationCase" },
              { "$ref": "#/$defs/deletedReuseCase" },
              { "$ref": "#/$defs/unavailableReuseCase" }
            ]
          }
        }
      }
    },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originating_run_id",
        "import_run_id",
        "mode",
        "dependency_closure_id",
        "extractor_id",
        "imported_at"
      ],
      "properties": {
        "originating_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "import_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "mode": { "const": "clean-import" },
        "dependency_closure_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "extractor_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "imported_at": { "$ref": "common.v1.schema.json#/$defs/utcTimestamp" }
      }
    },
    "applicationTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/applicationTarget" }
    },
    "applicationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_claim_key",
        "consuming_run_id",
        "installation_snapshot_id",
        "analysis_context_id",
        "resolved_input_manifest_id",
        "subject_id",
        "subject_type",
        "dependency_closure_id"
      ],
      "properties": {
        "application_claim_key": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "consuming_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "installation_snapshot_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "analysis_context_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "resolved_input_manifest_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "subject_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "subject_type": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "dependency_closure_id": { "$ref": "common.v1.schema.json#/$defs/identifier" }
      }
    },
    "coreAggregateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "passage_state",
        "llm_involvement",
        "llm_operation",
        "boundaries",
        "list_order"
      ],
      "properties": {
        "schema_id": { "const": "infinium.documentation.evidence/v1" },
        "schema_version": { "const": "1.0.0" },
        "passage_state": { "enum": ["present", "partial", "unavailable"] },
        "llm_involvement": { "const": "none" },
        "llm_operation": { "const": "none" },
        "boundaries": { "$ref": "#/$defs/boundaries" },
        "list_order": { "const": "one revision and import; passages, claims, applications, purposes, receipts, and gaps ordinal by stable ID; all nested sets ordinal-sorted" }
      }
    },
    "adversarialAggregateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "clean_passage_state",
        "deleted_reuse_passage_state",
        "unavailable_live_source_reuse_passage_state",
        "retained_reuse_revision_retention_state",
        "retained_reuse_revision_replay_state",
        "llm_involvement",
        "llm_operation",
        "boundaries",
        "list_order"
      ],
      "properties": {
        "schema_id": { "const": "infinium.documentation.evidence/v1" },
        "schema_version": { "const": "1.0.0" },
        "clean_passage_state": { "enum": ["present", "partial", "unavailable"] },
        "deleted_reuse_passage_state": { "enum": ["present", "partial", "unavailable"] },
        "unavailable_live_source_reuse_passage_state": { "enum": ["present", "partial", "unavailable"] },
        "retained_reuse_revision_retention_state": { "enum": ["present", "partial", "unavailable"] },
        "retained_reuse_revision_replay_state": { "$ref": "#/$defs/replayState" },
        "llm_involvement": { "const": "none" },
        "llm_operation": { "const": "none" },
        "boundaries": { "$ref": "#/$defs/boundaries" },
        "list_order": { "const": "one revision and import; passages, claims, applications, purposes, receipts, and gaps ordinal by stable ID; all nested sets ordinal-sorted" }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary_id", "state", "reason"],
        "properties": {
          "boundary_id": { "enum": ["provider", "hosted-search", "nexus", "loot"] },
            "state": { "const": "not-used" },
          "reason": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" }
        }
      }
    },
    "simpleCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "classification", "expected"],
      "properties": {
        "case_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "classification": { "$ref": "#/$defs/classification" },
        "expected": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" }
      }
    },
    "mutationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "classification", "mutation", "expected"],
      "properties": {
        "case_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "classification": { "$ref": "#/$defs/classification" },
        "mutation": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" },
        "expected": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" }
      }
    },
    "deletedReuseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "classification",
        "availability",
        "originating_run_id",
        "import_run_id",
        "mode",
        "imported_at",
        "deleted_at",
        "deletion_reason",
        "source_bytes",
        "new_claims",
        "new_applications",
        "retained_evidence",
        "expected"
      ],
      "properties": {
        "case_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "classification": { "$ref": "#/$defs/classification" },
        "availability": { "const": "deleted" },
        "originating_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "import_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "mode": { "const": "retained-reuse" },
        "imported_at": { "$ref": "common.v1.schema.json#/$defs/utcTimestamp" },
        "deleted_at": { "$ref": "common.v1.schema.json#/$defs/utcTimestamp" },
        "deletion_reason": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" },
        "source_bytes": { "const": "not-supplied" },
        "new_claims": { "type": "array", "maxItems": 0 },
        "new_applications": { "type": "array", "maxItems": 0 },
        "retained_evidence": { "const": "clean-output" },
        "expected": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" }
      }
    },
    "unavailableReuseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "classification",
        "availability",
        "originating_run_id",
        "import_run_id",
        "mode",
        "imported_at",
        "source_bytes",
        "new_claims",
        "new_applications",
        "retained_evidence",
        "expected"
      ],
      "properties": {
        "case_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "classification": { "$ref": "#/$defs/classification" },
        "availability": { "const": "unavailable" },
        "originating_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "import_run_id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "mode": { "const": "retained-reuse" },
        "imported_at": { "$ref": "common.v1.schema.json#/$defs/utcTimestamp" },
        "source_bytes": { "const": "not-supplied" },
        "new_claims": { "type": "array", "maxItems": 0 },
        "new_applications": { "type": "array", "maxItems": 0 },
        "retained_evidence": { "const": "clean-output" },
        "expected": { "$ref": "common.v1.schema.json#/$defs/nonEmptyString" }
      }
    },
    "classification": {
      "enum": ["positive", "negative", "boundary", "malformed", "unsupported"]
    },
    "replayState": {
      "enum": ["complete-clean", "partial", "audit-only", "unavailable", "failed-identity-drift"]
    }
  }
}
