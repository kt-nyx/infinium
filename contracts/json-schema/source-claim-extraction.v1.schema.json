{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/source-claim-extraction.v1.schema.json",
  "title": "infinium.llm.source-claim-extraction/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "acquisition_run_id",
    "operation_id",
    "owner_kind",
    "owner_id",
    "parent_analysis_run_id",
    "application_scope_id",
    "cost_attribution_scope_id",
    "source_revision_id",
    "passage_ids",
    "declared_purpose",
    "claim_proposals",
    "contradiction_evidence_ids",
    "abstentions",
    "gaps",
    "validation_ids",
    "admission_correlation_ids",
    "admission_correlations"
  ],
  "properties": {
    "schema_id": {
      "const": "infinium.llm.source-claim-extraction/v1"
    },
    "schema_version": {
      "const": "1"
    },
    "acquisition_run_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "operation_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "owner_kind": {
      "const": "evidence-acquisition-run"
    },
    "owner_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "parent_analysis_run_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "application_scope_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "cost_attribution_scope_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "source_revision_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "passage_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/identifier"
      }
    },
    "declared_purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "claim_proposals": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "contradiction_evidence_ids": {
      "$ref": "#/$defs/ids"
    },
    "abstentions": {
      "$ref": "#/$defs/texts"
    },
    "gaps": {
      "$ref": "#/$defs/texts"
    },
    "validation_ids": {
      "$ref": "#/$defs/ids"
    },
    "admission_correlation_ids": {
      "$ref": "#/$defs/ids"
    },
    "admission_correlations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/admissionCorrelation"
      }
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/identifier"
      }
    },
    "texts": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "proposalState": {
      "enum": [
        "proposed",
        "extracted",
        "rejected",
        "abstained",
        "unavailable",
        "deleted"
      ]
    },
    "supportState": {
      "enum": [
        "not-evaluated",
        "supported",
        "unsupported",
        "contradicted",
        "unavailable"
      ]
    },
    "applicabilityState": {
      "enum": [
        "not-evaluated",
        "applicable",
        "conditional-unestablished",
        "not-applicable",
        "unknown"
      ]
    },
    "decisionState": {
      "enum": [
        "admitted",
        "rejected",
        "abstained",
        "audit-only"
      ]
    },
    "semanticStateCombination": {
      "oneOf": [
        {
          "properties": {
            "support_state": {
              "const": "supported"
            },
            "applicability_state": {
              "const": "applicable"
            },
            "decision_state": {
              "const": "admitted"
            }
          }
        },
        {
          "properties": {
            "decision_state": {
              "const": "abstained"
            }
          },
          "anyOf": [
            {
              "properties": {
                "support_state": {
                  "enum": [
                    "not-evaluated",
                    "unsupported",
                    "contradicted",
                    "unavailable"
                  ]
                }
              }
            },
            {
              "properties": {
                "applicability_state": {
                  "enum": [
                    "not-evaluated",
                    "conditional-unestablished",
                    "not-applicable",
                    "unknown"
                  ]
                }
              }
            }
          ]
        },
        {
          "properties": {
            "support_state": {
              "const": "not-evaluated"
            },
            "applicability_state": {
              "const": "not-evaluated"
            },
            "decision_state": {
              "const": "rejected"
            }
          }
        },
        {
          "properties": {
            "support_state": {
              "const": "unavailable"
            },
            "applicability_state": {
              "const": "not-evaluated"
            },
            "decision_state": {
              "const": "audit-only"
            }
          }
        }
      ]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "passage_id",
        "claim",
        "condition_ids",
        "extraction_state",
        "reason"
      ],
      "properties": {
        "proposal_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "passage_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "condition_ids": {
          "$ref": "#/$defs/ids"
        },
        "extraction_state": {
          "$ref": "#/$defs/proposalState"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "admissionCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_id",
        "proposal_id",
        "authorization_id",
        "operation_id",
        "response_record_id",
        "owner_kind",
        "owner_id",
        "root_subject_id",
        "validation_id",
        "admission_correlation_id",
        "support_state",
        "applicability_state",
        "decision_state"
      ],
      "properties": {
        "admission_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "proposal_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "authorization_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "operation_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "response_record_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "owner_kind": {
          "const": "evidence-acquisition-run"
        },
        "owner_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "root_subject_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "validation_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "admission_correlation_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "support_state": {
          "$ref": "#/$defs/supportState"
        },
        "applicability_state": {
          "$ref": "#/$defs/applicabilityState"
        },
        "decision_state": {
          "$ref": "#/$defs/decisionState"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/sourceBoundSemanticStateCombination"
        }
      ]
    },
    "admissionLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_id",
        "proposal_id",
        "authorization_id",
        "operation_id",
        "response_record_id",
        "owner_kind",
        "owner_id",
        "root_subject_id",
        "validation_id",
        "application_link_id",
        "support_state",
        "applicability_state",
        "decision_state"
      ],
      "properties": {
        "admission_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "proposal_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "authorization_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "operation_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "response_record_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "owner_kind": {
          "const": "analysis-run"
        },
        "owner_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "root_subject_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "validation_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "application_link_id": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "support_state": {
          "$ref": "#/$defs/supportState"
        },
        "applicability_state": {
          "$ref": "#/$defs/applicabilityState"
        },
        "decision_state": {
          "$ref": "#/$defs/decisionState"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/semanticStateCombination"
        }
      ]
    },
    "sourceBoundSemanticStateCombination": {
      "oneOf": [
        {
          "properties": {
            "support_state": {
              "enum": [
                "supported",
                "unsupported",
                "contradicted"
              ]
            },
            "applicability_state": {
              "const": "not-evaluated"
            },
            "decision_state": {
              "const": "abstained"
            }
          }
        },
        {
          "properties": {
            "support_state": {
              "const": "not-evaluated"
            },
            "applicability_state": {
              "const": "not-evaluated"
            },
            "decision_state": {
              "enum": [
                "abstained",
                "rejected"
              ]
            }
          }
        },
        {
          "properties": {
            "support_state": {
              "const": "unavailable"
            },
            "applicability_state": {
              "const": "not-evaluated"
            },
            "decision_state": {
              "enum": [
                "abstained",
                "audit-only"
              ]
            }
          }
        }
      ]
    }
  }
}
