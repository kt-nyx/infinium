    "replay_state":{"enum":["not-available","retained-response","audit-only"]},
    "recorded_at":{"$ref":"common.v1.schema.json#/$defs/utcTimestamp"}
  },
  "$defs": {
    "identityReference":{"type":"object","additionalProperties":false,"required":["identity","fingerprint"],"properties":{"identity":{"$ref":"common.v1.schema.json#/$defs/identifier"},"fingerprint":{"$ref":"common.v1.schema.json#/$defs/fingerprint"}}},
    "finiteLimits":{"type":"object","additionalProperties":false,"required":["maximum_request_bytes","maximum_input_tokens","maximum_output_tokens","maximum_raw_response_bytes","maximum_dispatch_count","maximum_calculated_nano_usd","deadline_milliseconds"],"properties":{"maximum_request_bytes":{"type":"integer","minimum":1,"maximum":65536},"maximum_input_tokens":{"type":"integer","minimum":1,"maximum":73728},"maximum_output_tokens":{"type":"integer","minimum":1,"maximum":4096},"maximum_raw_response_bytes":{"type":"integer","minimum":1,"maximum":1048576},"maximum_dispatch_count":{"const":1},"maximum_calculated_nano_usd":{"type":"integer","minimum":1,"maximum":600000000},"deadline_milliseconds":{"type":"integer","minimum":1,"maximum":120000}}},
    "availability":{"enum":["available","unavailable","unsupported","not-applicable","not-used"]},
    "operationState":{"enum":["proposed","confirmed","reserved","assigned","final-gate-authorized","transport-not-started","transport-may-have-started","response-staged","admitted","rejected","settled","unresolved-hold"]},
    "admissionState":{"enum":["proposed","admitted","rejected","abstained","unavailable","unsupported","deleted"]},
    "usage":{"type":"object","additionalProperties":false,"required":["dispatch_count","input_tokens","output_tokens","reasoning_tokens","cache_read_tokens","cache_write_tokens","priced_tool_calls","calculated_nano_usd","billing_availability","rate_availability","credit_availability"],"properties":{"dispatch_count":{"type":"integer","minimum":0,"maximum":1},"input_tokens":{"type":"integer","minimum":0,"maximum":73728},"output_tokens":{"type":"integer","minimum":0,"maximum":4096},"reasoning_tokens":{"type":"integer","minimum":0,"maximum":4096},"cache_read_tokens":{"const":0},"cache_write_tokens":{"const":0},"priced_tool_calls":{"const":0},"calculated_nano_usd":{"type":"integer","minimum":0,"maximum":600000000},"billing_availability":{"$ref":"#/$defs/availability"},"rate_availability":{"$ref":"#/$defs/availability"},"credit_availability":{"$ref":"#/$defs/availability"}}},
    "priceRule":{"type":"object","additionalProperties":false,"required":["rule_id","provider","model","service_tier","context_band","cache_class","token_class","tool_class","region","currency","numerator_nano_usd","denominator_tokens","revision"],"properties":{"rule_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},"provider":{"const":"openai"},"model":{"const":"gpt-5.6-sol"},"service_tier":{"const":"default"},"context_band":{"const":"standard-under-272k"},"cache_class":{"enum":["ordinary-input","cache-write","cache-read","none"]},"token_class":{"enum":["input","output","reasoning"]},"tool_class":{"const":"none"},"region":{"const":"global"},"currency":{"const":"USD"},"numerator_nano_usd":{"type":"integer","minimum":0,"maximum":600000000},"denominator_tokens":{"type":"integer","minimum":1,"maximum":1000000000},"revision":{"type":"string","minLength":1,"maxLength":128}}}
  }
}
