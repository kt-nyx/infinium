    "profile_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},
    "generation_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},
    "revocation_epoch":{"type":"integer","minimum":0},
    "capability_snapshot":{"$ref":"#/$defs/identityReference"},
    "price_snapshot":{"$ref":"#/$defs/identityReference"},
    "settings_fingerprint":{"$ref":"common.v1.schema.json#/$defs/fingerprint"},
    "output_schema_fingerprint":{"$ref":"common.v1.schema.json#/$defs/fingerprint"},
    "request_fingerprint":{"$ref":"common.v1.schema.json#/$defs/fingerprint"},
    "limits":{"$ref":"#/$defs/finiteLimits"},
    "authorization_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},
