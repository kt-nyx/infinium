{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/json-schema/provider-operation.v1.schema.json",
  "title": "infinium.provider.operation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id","schema_version","operation_id","owner_id","owner_kind","job_node_id","attempt_id","request_id","profile_id","generation_id","revocation_epoch","capability_snapshot","price_snapshot","settings_fingerprint","output_schema_fingerprint","request_fingerprint","limits","authorization_id","reservation_id","dispatch_fence_id","state","transport_state","receipt_state","usage","settlement_state","replay_state","recorded_at"],
  "properties": {
    "schema_id": {"const":"infinium.provider.operation/v1"},
    "schema_version": {"const":"1"},
    "operation_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},
    "owner_id":{"$ref":"common.v1.schema.json#/$defs/identifier"},
