{
  "schema_version": "1.0.0",
  "renderer_contract_version": "1.1.0",
  "limits": {
    "maximum_message_bytes": 1048576,
    "maximum_page_items": 100,
    "maximum_chunk_bytes": 262144,
    "maximum_stream_queue_items": 64,
    "maximum_filter_terms": 16,
    "maximum_sort_terms": 4,
    "maximum_bootstrap_recent_runs": 20
  },
  "operations": [
    {
      "operation": "application.bootstrap",
      "native_target": "ApplicationService.GetApplicationBootstrap",
      "messages": [
        {
          "message_kind": "request",
          "payload_shape": "bootstrap-request",
          "gesture": "not-allowed"
        },
        {
          "message_kind": "response",
          "payload_shape": "bootstrap-response",
          "gesture": "not-allowed",
          "outcomes": ["accepted", "rejected", "conflict", "unsupported", "unavailable", "cancelled", "indeterminate", "resync-required"]
        }
      ],
      "maturity": "producer-consumer-validated",
      "owner": "frontend-application-contract-foundation"
    },
    {
      "operation": "application.cancel",
      "native_target": "DesktopHost.TransportCancellation",
      "messages": [
        {
          "message_kind": "request",
          "payload_shape": "cancel-request",
          "gesture": "required"
        },
        {
          "message_kind": "response",
          "payload_shape": "cancel-response",
          "gesture": "not-allowed",
          "outcomes": ["accepted", "rejected", "conflict", "unsupported", "unavailable", "cancelled", "indeterminate", "resync-required"]
        }
      ],
      "maturity": "producer-consumer-validated",
      "owner": "frontend-application-contract-foundation"
    },
    {
      "operation": "application.resync-required",
      "native_target": "DesktopHost.ResyncProjection",
      "messages": [
        {
          "message_kind": "event",
          "payload_shape": "resync-required-event",
          "gesture": "not-allowed",
          "outcomes": ["resync-required"]
        }
      ],
      "maturity": "producer-consumer-validated",
      "owner": "frontend-application-contract-foundation"
    }
  ],
  "denied_authority_fields": ["path", "sql", "command", "command_line", "url", "credential", "provider_request", "filesystem", "coordinator_proxy"]
}
