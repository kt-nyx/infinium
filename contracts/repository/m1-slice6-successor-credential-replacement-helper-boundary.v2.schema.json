{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.m1-s6.successor-credential-replacement-helper-boundary/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "attempt_id", "assignment_id", "terminal_origin", "validated_failure_envelope", "terminal_receipt", "process"],
  "properties": {
    "schema_identity": { "const": "infinium.m1-s6.successor-credential-replacement-helper-boundary/v2" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "assignment_id": { "$ref": "#/$defs/id" },
    "terminal_origin": { "enum": ["helper-terminal-receipt", "validated-native-failure-envelope"] },
    "validated_failure_envelope": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["sha256", "base64", "stage", "reason", "network_facts_known", "external_effect_facts_known", "dns_operation_count", "provider_operation_count", "billable_operation_count"],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha" },
            "base64": { "type": "string", "minLength": 12, "maxLength": 131072, "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
            "stage": { "enum": ["engine-execution", "evidence-collection", "metrics-write"] },
            "reason": { "enum": ["io-failure", "invalid-data", "invalid-operation", "cancelled", "timeout", "win32-failure", "controlled-failure"] },
            "network_facts_known": { "const": true },
            "external_effect_facts_known": { "const": true },
            "dns_operation_count": { "const": 0 },
            "provider_operation_count": { "const": 0 },
            "billable_operation_count": { "const": 0 }
          }
        }
      ]
    },
    "terminal_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "sha256", "base64", "sequence", "outcome"],
      "properties": {
        "relative_path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+helper-receipt\\.v2\\.pb$" },
        "sha256": { "$ref": "#/$defs/sha" },
        "base64": { "type": "string", "minLength": 4, "maxLength": 65536, "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "sequence": { "const": 3 },
        "outcome": { "enum": ["Completed", "Cancelled", "FailedKnown", "Unavailable"] }
      }
    },
    "process": {
      "type": "object", "additionalProperties": false,
      "required": ["process_id", "exit_code", "binary_sha256", "staged_response_base64", "inherited_private_handle_count", "standard_protocol_handle_count", "listener_count", "network_operation_count", "native_credential_operation_count", "process_tree_survivor_count", "process_tree_terminated", "retry_attempted", "native_call_trace_base64", "native_entry_cleanup_base64", "native_canary_evidence_base64", "containment_probe_executed", "excluded_handle_accessible", "active_process_count_before_job_close", "total_contained_process_count", "namespace_reuse_blocked", "namespace_reuse_block_reason"],
      "properties": {
        "process_id": { "type": "integer", "minimum": 1 },
        "exit_code": { "enum": [0, 72] },
        "binary_sha256": { "$ref": "#/$defs/sha" },
        "staged_response_base64": { "const": "" },
        "inherited_private_handle_count": { "const": 2 },
        "standard_protocol_handle_count": { "const": 0 },
        "listener_count": { "const": 0 },
        "network_operation_count": { "const": 0 },
        "native_credential_operation_count": { "type": "integer", "minimum": 0, "maximum": 11 },
        "process_tree_survivor_count": { "const": 0 },
        "process_tree_terminated": { "const": true },
        "retry_attempted": { "const": false },
        "native_call_trace_base64": { "type": "string", "minLength": 4, "maxLength": 262144 },
        "native_entry_cleanup_base64": { "type": ["string", "null"], "maxLength": 262144 },
        "native_canary_evidence_base64": { "type": "string", "minLength": 4, "maxLength": 262144 },
        "containment_probe_executed": { "const": true },
        "excluded_handle_accessible": { "const": false },
        "active_process_count_before_job_close": { "type": "integer", "minimum": 1 },
        "total_contained_process_count": { "type": "integer", "minimum": 2 },
        "namespace_reuse_blocked": { "type": "boolean" },
        "namespace_reuse_block_reason": { "type": ["string", "null"], "maxLength": 128 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "terminal_origin": { "const": "helper-terminal-receipt" } } },
      "then": { "properties": { "validated_failure_envelope": { "type": "null" }, "process": { "properties": { "exit_code": { "const": 0 } } } } }
    },
    {
      "if": { "properties": { "terminal_origin": { "const": "validated-native-failure-envelope" } } },
      "then": { "properties": { "validated_failure_envelope": { "type": "object" }, "terminal_receipt": { "properties": { "outcome": { "const": "FailedKnown" } } }, "process": { "properties": { "exit_code": { "const": 72 } } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
