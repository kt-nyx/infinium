{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/wp4-credential-native-authorization.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "manifest_id",
    "status",
    "effect_authority",
    "prepared_at_utc",
    "expires_at_utc",
    "candidate_binding",
    "authority",
    "disposable_namespace",
    "native_boundary",
    "entry_boundary",
    "provider_boundary",
    "operation_limits",
    "required_scenarios",
    "backup_restore_recovery",
    "canary_contract",
    "cleanup_contract",
    "required_evidence",
    "independent_review",
    "execution_command",
    "acceptance_binding"
  ],
  "properties": {
    "schema_identity": { "const": "infinium.repository.wp4-credential-native-authorization/1.0.0" },
    "manifest_id": { "$ref": "#/$defs/nonEmptyString" },
    "status": { "const": "ready-for-owner-acceptance" },
    "effect_authority": { "const": "none-until-owner-accepts-exact-manifest-bytes" },
    "prepared_at_utc": { "$ref": "#/$defs/utcTimestamp" },
    "expires_at_utc": { "$ref": "#/$defs/utcTimestamp" },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_wp3_candidate_commit",
        "authorization_handoff_commit",
        "repository_head_at_preparation",
        "required_branch",
        "required_execution_state"
      ],
      "properties": {
        "accepted_wp3_candidate_commit": { "$ref": "#/$defs/gitSha" },
        "authorization_handoff_commit": { "$ref": "#/$defs/gitSha" },
        "repository_head_at_preparation": { "$ref": "#/$defs/gitSha" },
        "required_branch": { "const": "codex/m1-s6" },
        "required_execution_state": {
          "const": "clean committed descendant of authorization_handoff_commit, preserving accepted_wp3_candidate_commit as an ancestor; the exact WP4 implementation candidate must be recorded before CredentialNative may run"
        }
      }
    },
    "authority": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPathOrAnchor" }
    },
    "disposable_namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace_id",
        "derivation",
        "credential_type",
        "persistence",
        "raw_target_retention",
        "targets",
        "reuse"
      ],
      "properties": {
        "namespace_id": { "$ref": "#/$defs/nonEmptyString" },
        "derivation": { "const": "UTF8('Infinium:' + access_profile_id + ':' + generation_id)" },
        "credential_type": { "const": "CRED_TYPE_GENERIC" },
        "persistence": { "const": "CRED_PERSIST_LOCAL_MACHINE" },
        "raw_target_retention": { "const": "helper-memory-only; artifacts and receipts retain target_fingerprint_sha256 only" },
        "targets": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/target" }
        },
        "reuse": { "const": "never; each derived target is one qualification target and uncertainty blocks the entire namespace" }
      }
    },
    "native_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_calls", "call_rules", "forbidden_calls", "fallback"],
      "properties": {
        "allowed_calls": {
          "const": ["CredWriteW", "CredReadW", "CredDeleteW", "CredFree"]
        },
        "call_rules": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "forbidden_calls": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "fallback": { "const": "none" }
      }
    },
    "entry_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "control", "echo", "prepopulate", "clipboard_return", "terminal_behavior"],
      "properties": {
        "owner": { "const": "one-shot credential helper" },
        "control": { "const": "native masked entry owned by helper" },
        "echo": { "const": false },
        "prepopulate": { "const": false },
        "clipboard_return": { "const": false },
        "terminal_behavior": {
          "const": "submit returns only non-secret success or typed error; cancel/close/timeout returns only cancelled or typed error and clears mutable entry buffers"
        }
      }
    },
    "provider_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatch", "dns_operations", "network_operations", "provider_operations", "billable_operations", "api_key"],
      "properties": {
        "dispatch": { "const": "deterministic fake-provider simulator only" },
        "dns_operations": { "const": 0 },
        "network_operations": { "const": 0 },
        "provider_operations": { "const": 0 },
        "billable_operations": { "const": 0 },
        "api_key": { "const": "not-used" }
      }
    },
    "operation_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_window_seconds",
        "gate_wall_clock_seconds",
        "helper_processes",
        "entry_dialogs",
        "fake_provider_dispatches",
        "credential_blob_bytes",
        "cleanup_attempts_per_target",
        "native_call_maxima"
      ],
      "properties": {
        "authorization_window_seconds": { "type": "integer", "minimum": 1, "maximum": 172800 },
        "gate_wall_clock_seconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "helper_processes": { "type": "integer", "minimum": 1, "maximum": 32 },
        "entry_dialogs": { "const": 2 },
        "fake_provider_dispatches": { "const": 1 },
        "credential_blob_bytes": { "const": 2560 },
        "cleanup_attempts_per_target": { "type": "integer", "minimum": 1, "maximum": 2 },
        "native_call_maxima": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CredWriteW", "CredReadW", "CredDeleteW", "CredFree", "total"],
          "properties": {
            "CredWriteW": { "type": "integer", "minimum": 1, "maximum": 12 },
            "CredReadW": { "type": "integer", "minimum": 1, "maximum": 60 },
            "CredDeleteW": { "type": "integer", "minimum": 1, "maximum": 24 },
            "CredFree": { "type": "integer", "minimum": 1, "maximum": 24 },
            "total": { "type": "integer", "minimum": 4, "maximum": 120 }
          }
        }
      }
    },
    "required_scenarios": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "backup_restore_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup_secret", "backup_target", "restored_state", "reactivation", "old_target_cleanup"],
      "properties": {
        "backup_secret": { "const": "absent" },
        "backup_target": { "const": "absent" },
        "restored_state": { "const": "recovery-required" },
        "reactivation": { "const": "local helper entry into a new generation only; restored generation cannot reactivate" },
        "old_target_cleanup": { "const": "known exact target only; confirmed absence required; no enumeration" }
      }
    },
    "canary_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_canary", "target_canary", "authorized_surfaces", "forbidden_surfaces", "pass_condition"],
      "properties": {
        "secret_canary": { "const": "runtime-only; never serialized or fingerprinted in an artifact" },
        "target_canary": { "const": "runtime-derived; receipts retain only target_fingerprint_sha256" },
        "authorized_surfaces": {
          "const": ["helper mutable entry buffer", "Credential Manager exact target/blob", "private test oracle memory"]
        },
        "forbidden_surfaces": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "pass_condition": { "const": "zero exact secret-canary and raw-target-canary matches on every forbidden surface" }
      }
    },
    "cleanup_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_paths", "preflight_collision", "procedure", "absence_proof", "ambiguous_or_failed", "reuse_after_absence"],
      "properties": {
        "terminal_paths": {
          "const": ["success", "cancel", "typed-failure", "timeout", "helper-crash", "coordinator-crash", "store-unavailable"]
        },
        "preflight_collision": { "const": "if exact-target CredReadW succeeds, stop without write or delete, mark namespace blocked, and require a fresh manifest" },
        "procedure": { "const": "bounded exact-target CredDeleteW followed by exact-target CredReadW expecting ERROR_NOT_FOUND; CredFree every successful read allocation" },
        "absence_proof": { "const": "per-target target_fingerprint_sha256 plus exact-target ERROR_NOT_FOUND result and zero raw target retention" },
        "ambiguous_or_failed": { "const": "fail CredentialNative, retain cleanup-ambiguous or cleanup-failed, block every derived target and namespace reuse, perform no fallback, and require fresh owner authorization before another native mutation" },
        "reuse_after_absence": { "const": "not permitted; this manifest is one-shot" }
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh", "read_only", "review_scope", "acceptance_rule"],
      "properties": {
        "fresh": { "const": true },
        "read_only": { "const": true },
        "review_scope": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "acceptance_rule": { "const": "WP4 remains unaccepted unless the fresh reviewer returns ACCEPT against the exact implementation candidate, manifest identity, gate receipt, and cleanup evidence" }
      }
    },
    "execution_command": { "$ref": "#/$defs/nonEmptyString" },
    "acceptance_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "owner_must_name", "recording", "expiry_rule", "mutation_rule"],
      "properties": {
        "method": { "const": "explicit owner acceptance of exact manifest bytes out-of-band before any WP4 implementation execution or native effect" },
        "owner_must_name": {
          "const": ["manifest_id", "manifest_sha256", "accepted_wp3_candidate_commit", "authorization_handoff_commit", "expires_at_utc"]
        },
        "recording": { "const": "append the exact owner decision and manifest identity to the Slice 6 append-only record without changing current-state until WP4 acceptance" },
        "expiry_rule": { "const": "acceptance or execution at/after expires_at_utc is invalid and requires a fresh manifest" },
        "mutation_rule": { "const": "any manifest byte change invalidates acceptance and requires owner acceptance of the new SHA-256" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utcTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "repositoryPathOrAnchor": { "type": "string", "pattern": "^(docs|contracts|eng)/[^\\\\]+$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "access_profile_id", "generation_id", "target_fingerprint_sha256"],
      "properties": {
        "alias": { "$ref": "#/$defs/nonEmptyString" },
        "access_profile_id": { "type": "string", "pattern": "^[a-z0-9-]{1,160}$" },
        "generation_id": { "type": "string", "pattern": "^g[0-9]{3}$" },
        "target_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targets", "required_result"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "required_result": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
