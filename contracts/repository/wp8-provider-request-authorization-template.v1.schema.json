{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/wp8-provider-request-authorization-template.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity", "packet_id", "packet_kind", "status", "effect_authority",
    "candidate_binding", "acceptance_binding", "materialization", "prerequisites", "owner_authorization",
    "billing_disclosure", "profile_binding", "provider_profile", "request_binding",
    "fixture_oracle_binding", "capability_price_binding", "limits", "transport_boundary",
    "canaries", "execution"
  ],
  "properties": {
    "schema_identity": { "const": "infinium.repository.wp8-provider-request-authorization-template/1.0.0" },
    "packet_id": { "type": "string", "pattern": "^infinium\\.m1-s6\\.wp8\\.pre-live-(qualification|source-claim|candidate-investigation)-authorization-template/v1$" },
    "packet_kind": { "enum": ["Qualification", "SourceClaimExtraction", "CandidateInvestigation"] },
    "status": { "const": "non-executable-template" },
    "effect_authority": { "const": "none" },
    "candidate_binding": { "$ref": "#/$defs/candidateBinding" },
    "acceptance_binding": { "$ref": "#/$defs/acceptanceBinding" },
    "materialization": { "$ref": "#/$defs/materialization" },
    "prerequisites": { "$ref": "#/$defs/stringArray" },
    "owner_authorization": { "$ref": "#/$defs/ownerAuthorization" },
    "billing_disclosure": { "$ref": "#/$defs/billingDisclosure" },
    "profile_binding": { "$ref": "#/$defs/profileBinding" },
    "provider_profile": { "$ref": "#/$defs/providerProfile" },
    "request_binding": { "$ref": "#/$defs/requestBinding" },
    "fixture_oracle_binding": { "$ref": "#/$defs/fixtureOracleBinding" },
    "capability_price_binding": { "$ref": "#/$defs/capabilityPriceBinding" },
    "limits": { "$ref": "#/$defs/limits" },
    "transport_boundary": { "$ref": "#/$defs/transportBoundary" },
    "canaries": { "$ref": "#/$defs/canaries" },
    "execution": { "$ref": "#/$defs/execution" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "stringArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "candidateBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_wp4_execution_commit", "accepted_wp4_evidence_sha256", "accepted_wp4_audit_commit", "accepted_wp7_product_commit", "accepted_wp7_evidence_commit", "wp8_product_template_commit", "wp8_verification_candidate_commit", "required_predecessor_live_acceptance"],
      "properties": {
        "accepted_wp4_execution_commit": { "$ref": "#/$defs/gitSha" },
        "accepted_wp4_evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "accepted_wp4_audit_commit": { "$ref": "#/$defs/gitSha" },
        "accepted_wp7_product_commit": { "$ref": "#/$defs/gitSha" },
        "accepted_wp7_evidence_commit": { "$ref": "#/$defs/gitSha" },
        "wp8_product_template_commit": { "type": "string", "pattern": "^(pending-until-product-template-freeze|[0-9a-f]{40})$" },
        "wp8_verification_candidate_commit": { "type": "string", "pattern": "^(pending-until-verification-freeze|[0-9a-f]{40})$" },
        "required_predecessor_live_acceptance": { "type": "string", "minLength": 1 }
      }
    },
    "acceptanceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "verification_candidate_commit", "post_run_evidence_candidate_commit", "non_live_all_receipt_sha256", "pre_live_receipt_sha256", "direct_layer6_receipt_sha256"],
      "properties": {
        "state": { "enum": ["correction-verification-pending", "accepted-closeout"] },
        "verification_candidate_commit": { "$ref": "#/$defs/gitSha" },
        "post_run_evidence_candidate_commit": { "type": "string", "pattern": "^(pending-until-post-run-evidence-freeze|[0-9a-f]{40})$" },
        "non_live_all_receipt_sha256": { "type": "string", "pattern": "^(pending-until-post-run-evidence-freeze|[0-9a-f]{64})$" },
        "pre_live_receipt_sha256": { "type": "string", "pattern": "^(pending-until-post-run-evidence-freeze|[0-9a-f]{64})$" },
        "direct_layer6_receipt_sha256": { "type": "string", "pattern": "^(pending-until-post-run-evidence-freeze|[0-9a-f]{64})$" }
      }
    },
    "materialization": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "fresh_packet_identity", "fresh_expiry", "fresh_exact_byte_review", "fresh_official_doc_review", "request_fingerprint", "no_inheritance"],
      "properties": {
        "required": { "const": true },
        "fresh_packet_identity": { "const": "pending" },
        "fresh_expiry": { "const": "pending" },
        "fresh_exact_byte_review": { "const": "required" },
        "fresh_official_doc_review": { "const": "pending-separate-research-or-planning-authority-before-live-materialization" },
        "request_fingerprint": { "const": "pending-after-exact-canonical-request-materialization" },
        "no_inheritance": { "const": true }
      }
    },
    "ownerAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_identity", "manifest_sha256", "expires_at_utc", "scope", "inheritance"],
      "properties": {
        "authorization_identity": { "const": "pending" },
        "manifest_sha256": { "const": "pending" },
        "expires_at_utc": { "const": "pending" },
        "scope": { "const": "exactly-one-distinct-provider-request" },
        "inheritance": { "const": "prohibited" }
      }
    },
    "billingDisclosure": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_owner", "billing_authority", "amount_charged_authority", "maximum_local_nano_usd", "owner_confirmation"],
      "properties": {
        "credential_owner": { "const": "user-owned-openai-platform-profile" },
        "billing_authority": { "const": "provider-account-not-locally-provable-before-request" },
        "amount_charged_authority": { "const": "unavailable-local-catalog-cost-is-not-provider-charge" },
        "maximum_local_nano_usd": { "type": "integer", "minimum": 1, "maximum": 600000000 },
        "owner_confirmation": { "const": "pending-for-exact-materialized-packet" }
      }
    },
    "profileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "generation_id", "revocation_epoch", "verification_receipt_sha256"],
      "properties": {
        "profile_id": { "const": "pending-after-production-profile-sub-gate" },
        "generation_id": { "const": "pending-after-production-profile-sub-gate" },
        "revocation_epoch": { "const": "pending-after-production-profile-sub-gate" },
        "verification_receipt_sha256": { "const": "pending-after-production-profile-sub-gate" }
      }
    },
    "providerProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "endpoint", "model", "reasoning_effort", "reasoning_context", "reasoning_mode", "structured_output_strict", "store", "service_tier", "background", "stream", "tool_choice", "tools", "truncation", "prompt_cache_mode", "prompt_cache_key", "prompt_cache_breakpoint"],
      "properties": {
        "provider": { "const": "openai" },
        "endpoint": { "const": "https://api.openai.com/v1/responses" },
        "model": { "const": "gpt-5.6-sol" },
        "reasoning_effort": { "const": "medium" },
        "reasoning_context": { "const": "current_turn" },
        "reasoning_mode": { "const": "standard" },
        "structured_output_strict": { "const": true },
        "store": { "const": false },
        "service_tier": { "const": "default" },
        "background": { "const": false },
        "stream": { "const": false },
        "tool_choice": { "const": "none" },
        "tools": { "const": [] },
        "truncation": { "const": "disabled" },
        "prompt_cache_mode": { "const": "explicit" },
        "prompt_cache_key": { "type": "null" },
        "prompt_cache_breakpoint": { "type": "null" }
      }
    },
    "requestBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "canonical_request", "prompt_id", "prompt_fingerprint_sha256", "output_schema_path", "output_schema_sha256"],
      "properties": {
        "operation": { "enum": ["transport-qualification", "source-claim-extraction", "candidate-investigation"] },
        "canonical_request": { "const": "pending-exact-bytes" },
        "prompt_id": { "type": "string", "minLength": 1 },
        "prompt_fingerprint_sha256": { "type": "string", "pattern": "^(pending|[0-9a-f]{64})$" },
        "output_schema_path": { "type": "string", "minLength": 1 },
        "output_schema_sha256": { "type": "string", "pattern": "^(pending|[0-9a-f]{64})$" }
      }
    },
    "fixtureOracleBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_identity", "fixture_manifest_sha256", "oracle_identity", "oracle_sha256", "answer_in_request"],
      "properties": {
        "fixture_identity": { "type": "string", "minLength": 1 },
        "fixture_manifest_sha256": { "const": "pending" },
        "oracle_identity": { "type": "string", "minLength": 1 },
        "oracle_sha256": { "const": "pending" },
        "answer_in_request": { "const": false }
      }
    },
    "capabilityPriceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["official_doc_snapshot", "official_doc_snapshot_sha256", "official_doc_refresh_authority", "fresh_drift_snapshot", "capability_snapshot_sha256", "price_snapshot_sha256"],
      "properties": {
        "official_doc_snapshot": { "const": "docs/research/investigations/RESEARCH-0054-slice6-openai-profile-and-implementation-readiness-refresh.md" },
        "official_doc_snapshot_sha256": { "const": "bf585dee726ab386ca27570829e29ce51c3060a001e4a4749797357fd301c68a" },
        "official_doc_refresh_authority": { "const": "separate-accepted-research-or-planning-action-not-inherited-from-live-packet" },
        "fresh_drift_snapshot": { "const": "pending-separate-authorized-research-or-planning-result" },
        "capability_snapshot_sha256": { "const": "pending" },
        "price_snapshot_sha256": { "const": "pending" }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_request_bytes", "maximum_input_tokens", "maximum_output_tokens", "maximum_raw_response_bytes", "maximum_dispatch_count", "maximum_calculated_nano_usd", "deadline_milliseconds"],
      "properties": {
        "maximum_request_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maximum_input_tokens": { "type": "integer", "minimum": 1, "maximum": 73728 },
        "maximum_output_tokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maximum_raw_response_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maximum_dispatch_count": { "const": 1 },
        "maximum_calculated_nano_usd": { "type": "integer", "minimum": 1, "maximum": 600000000 },
        "deadline_milliseconds": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "transportBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["automatic_retry", "ambiguous_start", "redirects", "fallback", "dns_maximum", "provider_request_maximum", "credential_read_maximum"],
      "properties": {
        "automatic_retry": { "const": false },
        "ambiguous_start": { "const": "unresolved-hold-and-no-retry" },
        "redirects": { "const": false },
        "fallback": { "const": "none" },
        "dns_maximum": { "const": 1 },
        "provider_request_maximum": { "const": 1 },
        "credential_read_maximum": { "const": 1 }
      }
    },
    "canaries": {
      "type": "object", "additionalProperties": false,
      "required": ["secret_canary", "target_canary", "untrusted_instruction_canary", "pass_condition"],
      "properties": {
        "secret_canary": { "const": "pending-generated-at-materialization-not-stored-in-template" },
        "target_canary": { "const": "pending-fingerprint-only-at-materialization" },
        "untrusted_instruction_canary": { "const": "pending-fixture-bound-at-materialization" },
        "pass_condition": { "const": "zero-secret-target-authority-escalation-matches" }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["permitted", "command", "script_status"],
      "properties": {
        "permitted": { "const": false },
        "command": { "type": "null" },
        "script_status": { "const": "not-created-by-wp8" }
      }
    }
  }
}
