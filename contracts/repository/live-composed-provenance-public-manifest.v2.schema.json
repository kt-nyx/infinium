{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/live-composed-provenance-public-manifest.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "package_identity",
    "package_version",
    "partition",
    "status",
    "operation",
    "semantic_use",
    "provider_call_count",
    "qualification",
    "stage_wrappers",
    "oracle",
    "required_bindings",
    "explicit_omissions",
    "no_fourth_call"
  ],
  "properties": {
    "schema_identity": {
      "const": "infinium.public-fixture.live-composed-provenance/2.0.0"
    },
    "package_identity": {
      "const": "PROV-LIVE-COMPOSED-VAL-v2"
    },
    "package_version": {
      "const": "2.0.0"
    },
    "partition": {
      "const": "validation"
    },
    "status": {
      "const": "oracle-frozen-pre-live-comparison"
    },
    "operation": {
      "const": "ComposedProvenanceValidation"
    },
    "semantic_use": {
      "const": true
    },
    "provider_call_count": {
      "type": "integer",
      "minimum": 0
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_identity",
        "package_version",
        "semantic_use",
        "manifest_path",
        "manifest_bytes",
        "manifest_sha256"
      ],
      "properties": {
        "package_identity": {
          "type": "string",
          "minLength": 1
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "semantic_use": {
          "const": false
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "stage_wrappers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "package_identity",
              "package_version",
              "semantic_use",
              "manifest_path",
              "manifest_bytes",
              "manifest_sha256"
            ],
            "properties": {
              "stage": {
                "const": "WP10"
              },
              "package_identity": {
                "type": "string",
                "minLength": 1
              },
              "package_version": {
                "type": "string",
                "minLength": 1
              },
              "semantic_use": {
                "const": true
              },
              "manifest_path": {
                "type": "string",
                "minLength": 1
              },
              "manifest_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "package_identity",
              "package_version",
              "semantic_use",
              "manifest_path",
              "manifest_bytes",
              "manifest_sha256"
            ],
            "properties": {
              "stage": {
                "const": "WP11"
              },
              "package_identity": {
                "type": "string",
                "minLength": 1
              },
              "package_version": {
                "type": "string",
                "minLength": 1
              },
              "semantic_use": {
                "const": true
              },
              "manifest_path": {
                "type": "string",
                "minLength": 1
              },
              "manifest_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "schema_identity",
        "authoring",
        "product_visible"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_identity": {
          "const": "infinium.evaluation.live-composed-provenance-oracle/2.0.0"
        },
        "authoring": {
          "const": "independent-pre-response"
        },
        "product_visible": {
          "const": false
        }
      }
    },
    "required_bindings": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "campaign-authorization",
          "credential-authorization",
          "stage-authorization",
          "canonical-request-hashes",
          "retained-raw-response-hashes",
          "retained-header-hashes",
          "one-owned-usage-per-stage",
          "settlement",
          "replay",
          "stage-evidence-acceptance",
          "semantic-validation-package-hashes"
        ]
      }
    },
    "explicit_omissions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "credentials",
          "raw-target-names",
          "hosted-search",
          "Nexus",
          "private-fixtures",
          "expected-answers"
        ]
      }
    },
    "no_fourth_call": {
      "const": true
    }
