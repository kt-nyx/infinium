{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/wp8-production-profile-authorization-template.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity", "packet_id", "packet_kind", "status", "effect_authority",
    "candidate_binding", "materialization", "owner_authorization", "provider_intent",
    "profile_binding", "native_boundary", "entry_cancel", "persistence_delete",
    "deadline", "canaries", "execution"
  ],
  "properties": {
    "schema_identity": { "const": "infinium.repository.wp8-production-profile-authorization-template/1.0.0" },
    "packet_id": { "const": "infinium.m1-s6.wp8.pre-live-profile-authorization-template/v1" },
    "packet_kind": { "const": "EnrollOrVerifyProfile" },
    "status": { "const": "non-executable-template" },
    "effect_authority": { "const": "none" },
    "candidate_binding": { "$ref": "#/$defs/candidateBinding" },
    "materialization": { "$ref": "#/$defs/materialization" },
    "owner_authorization": { "$ref": "#/$defs/ownerAuthorization" },
    "provider_intent": { "$ref": "#/$defs/providerIntent" },
    "profile_binding": { "$ref": "#/$defs/profileBinding" },
    "native_boundary": { "$ref": "#/$defs/nativeBoundary" },
    "entry_cancel": { "$ref": "#/$defs/entryCancel" },
    "persistence_delete": { "$ref": "#/$defs/persistenceDelete" },
    "deadline": { "$ref": "#/$defs/pendingDeadline" },
    "canaries": { "$ref": "#/$defs/canaries" },
    "execution": { "$ref": "#/$defs/execution" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_wp4_execution_commit", "accepted_wp4_evidence_sha256", "accepted_wp4_audit_commit", "accepted_wp7_product_commit", "accepted_wp7_evidence_commit", "wp8_candidate_commit"],
      "properties": {
        "accepted_wp4_execution_commit": { "$ref": "#/$defs/gitSha" },
        "accepted_wp4_evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "accepted_wp4_audit_commit": { "$ref": "#/$defs/gitSha" },
        "accepted_wp7_product_commit": { "$ref": "#/$defs/gitSha" },
        "accepted_wp7_evidence_commit": { "$ref": "#/$defs/gitSha" },
        "wp8_candidate_commit": { "const": "pending-after-independent-wp8-acceptance" }
      }
    },
    "materialization": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "operation_choice", "fresh_identity", "fresh_expiry", "fresh_exact_byte_review", "no_inheritance"],
      "properties": {
        "required": { "const": true },
        "operation_choice": { "const": "pending-new-or-exact-existing-owner-choice" },
        "fresh_identity": { "const": "pending" },
        "fresh_expiry": { "const": "pending" },
        "fresh_exact_byte_review": { "const": "required" },
        "no_inheritance": { "const": true }
      }
    },
    "ownerAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_identity", "manifest_sha256", "expires_at_utc", "scope", "inheritance"],
      "properties": {
        "authorization_identity": { "const": "pending" },
        "manifest_sha256": { "const": "pending" },
        "expires_at_utc": { "const": "pending" },
        "scope": { "const": "exactly-one-production-profile-enrollment-or-verification-effect" },
        "inheritance": { "const": "prohibited" }
      }
    },
    "providerIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "purpose", "account_authority", "billing_scope_authority"],
      "properties": {
        "provider": { "const": "openai" },
        "purpose": { "const": "user-owned-platform-api-inference" },
        "account_authority": { "const": "pending-owner-confirmation" },
        "billing_scope_authority": { "const": "pending-owner-confirmation" }
      }
    },
    "profileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "profile_id", "generation_id", "revocation_epoch", "verification_expectation"],
      "properties": {
        "mode": { "const": "pending-new-or-exact-existing" },
        "profile_id": { "const": "pending" },
        "generation_id": { "const": "pending" },
        "revocation_epoch": { "const": "pending" },
        "verification_expectation": { "const": "materialized-manifest-must-bind-one-exact-generation-and-revocation-epoch" }
      }
    },
    "nativeBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["new_profile_calls", "existing_profile_calls", "forbidden_calls", "enumeration", "fallback"],
      "properties": {
        "new_profile_calls": { "const": ["CredWriteW", "CredReadW", "CredFree"] },
        "existing_profile_calls": { "const": ["CredReadW", "CredFree"] },
        "forbidden_calls": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "enumeration": { "const": "prohibited" },
        "fallback": { "const": "none" }
      }
    },
    "entryCancel": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "presentation", "masked", "paste_permitted", "renderer_receives_value", "cancel_result"],
      "properties": {
        "owner": { "const": "one-shot-credential-helper" },
        "presentation": { "const": "Settings -> Add/Replace API key -> WPF-parented helper-owned modal" },
        "masked": { "const": true },
        "paste_permitted": { "const": true },
        "renderer_receives_value": { "const": false },
        "cancel_result": { "const": "typed-cancel-with-no-write-and-no-dispatch" }
      }
    },
    "persistenceDelete": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_persistence", "post_qualification_intent", "partial_or_ambiguous_effect"],
      "properties": {
        "credential_persistence": { "const": "pending-owner-choice" },
        "post_qualification_intent": { "const": "pending-retain-or-delete-exact-generation" },
        "partial_or_ambiguous_effect": { "const": "block-provider-request-until-fresh-authorized-recovery" }
      }
    },
    "pendingDeadline": {
      "type": "object", "additionalProperties": false,
      "required": ["expires_at_utc", "maximum_wall_clock_seconds"],
      "properties": {
        "expires_at_utc": { "const": "pending" },
        "maximum_wall_clock_seconds": { "const": 1800 }
      }
    },
    "canaries": {
      "type": "object", "additionalProperties": false,
      "required": ["secret_canary", "target_canary", "pass_condition"],
      "properties": {
        "secret_canary": { "const": "pending-generated-at-materialization-not-stored-in-template" },
        "target_canary": { "const": "pending-fingerprint-only-at-materialization" },
        "pass_condition": { "const": "zero-forbidden-surface-matches" }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["permitted", "command", "script_status"],
      "properties": {
        "permitted": { "const": false },
        "command": { "type": "null" },
        "script_status": { "const": "not-created-by-wp8" }
      }
    }
  }
}
