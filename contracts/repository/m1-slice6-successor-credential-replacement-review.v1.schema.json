{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.repository.m1-slice6-successor-credential-replacement-review/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "review_id", "verdict", "reviewer_id", "independent", "provider_effect_used", "subject", "findings", "reviewed_at_utc"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-successor-credential-replacement-review/1.0.0" },
    "review_id": { "$ref": "#/$defs/id" },
    "verdict": { "const": "accept" },
    "reviewer_id": { "$ref": "#/$defs/id" },
    "independent": { "const": true },
    "provider_effect_used": { "const": false },
    "subject": { "type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "findings": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "reviewed_at_utc": { "$ref": "#/$defs/canonicalZ" }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "canonicalZ": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" } }
}
