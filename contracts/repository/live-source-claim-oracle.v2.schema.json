{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/live-source-claim-oracle.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "package_id",
    "package_version",
    "partition",
    "semantic_use",
    "validates",
    "source_package",
    "required_live_validation",
    "no_admission_states"
  ],
  "properties": {
    "schema_id": {
      "const": "infinium.evaluation.live-source-claim-oracle/2.0.0"
    },
    "schema_version": {
      "const": "2"
    },
    "package_id": {
      "const": "LLM-CLAIM-LIVE-VAL-v2"
    },
    "package_version": {
      "const": "2.0.0"
    },
    "partition": {
      "const": "validation"
    },
    "semantic_use": {
      "const": true
    },
    "validates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_live_response",
        "host_admission",
        "canned_transcript_execution",
        "provider_request_during_replay"
      ],
      "properties": {
        "retained_live_response": {
          "const": true
        },
        "host_admission": {
          "const": true
        },
        "canned_transcript_execution": {
          "const": false
        },
        "provider_request_during_replay": {
          "const": false
        }
      }
    },
    "source_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_version",
        "execution_input",
        "context_manifest",
        "oracle"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "execution_input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "byte_length",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "context_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "byte_length",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "schema_id"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "schema_id": {
              "const": "infinium.evaluation.source-claim-oracle/2.0.0"
            }
          }
        }
      }
    },
    "required_live_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_response_envelope_count",
        "operation_id",
        "acquisition_run_id",
        "host_authorization_id",
        "expected_host_admission_count",
        "admission_id",
        "proposal_id",
        "admitted_artifact_id",
        "application_link_id",
        "source_revision_id",
        "passage_id",
        "persisted_payload_sha256",
        "required_applicability_fact_id",
        "required_applicability_fact_sha256",
        "requires_typed_semantic_oracle_validation",
        "requires_retained_response_replay_equality"
      ],
      "properties": {
        "completed_response_envelope_count": {
          "type": "integer",
          "minimum": 0
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "acquisition_run_id": {
          "type": "string",
          "minLength": 1
        },
        "host_authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_host_admission_count": {
          "type": "integer",
          "minimum": 0
        },
        "admission_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "admitted_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "application_link_id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "passage_id": {
          "type": "string",
          "minLength": 1
        },
        "persisted_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_applicability_fact_id": {
          "type": "string",
          "minLength": 1
        },
        "required_applicability_fact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requires_typed_semantic_oracle_validation": {
          "const": true
        },
        "requires_retained_response_replay_equality": {
          "const": true
        }
      }
    },
    "no_admission_states": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "unsupported-negative",
          "conditional-unestablished",
          "version-mismatched",
          "contradictory",
          "hostile-untrusted",
          "deleted-audit-only",
          "insufficient-abstention"
        ]
      }
    }
  }
}
