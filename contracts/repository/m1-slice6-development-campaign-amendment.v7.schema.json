{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.repository.m1-slice6-development-campaign-amendment/7.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "amendment_id", "status", "owner_authority_source", "prior_owner_authority", "retained_stopped_evidence", "retained_boundary", "retained_receipt", "correction", "recovery", "preserved_boundaries", "authorized_at_utc"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-development-campaign-amendment/7.0.0" },
    "amendment_id": { "$ref": "#/$defs/id" },
    "status": { "const": "owner-authorized-credential-replacement-cleanup-recovery" },
    "owner_authority_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "const": "current-owner-task-message" },
        "summary": { "const": "use the confirmed-working fresh key through the masked credential enrollment surface" }
      }
    },
    "prior_owner_authority": { "$ref": "#/$defs/bindingPath" },
    "retained_stopped_evidence": { "$ref": "#/$defs/bindingPath" },
    "retained_boundary": { "$ref": "#/$defs/bindingPath" },
    "retained_receipt": { "$ref": "#/$defs/bindingPath" },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosis", "implementation_commit", "independent_review", "retained_operation_id", "consumed_helper_launches", "native_credential_operations", "sole_failed_readiness_fact"],
      "properties": {
        "diagnosis": { "const": "credential-replacement-dialog-did-not-reassert-foreground-during-bounded-readiness" },
        "implementation_commit": { "const": "5d7f3d889b74254b2ca58cca0bc08a2c1418b0e2" },
        "independent_review": { "$ref": "#/$defs/bindingPath" },
        "retained_operation_id": { "const": "m1s6-credential-replacement-d7ae77b7d68c577196bbe5ac26325638" },
        "consumed_helper_launches": { "const": 1 },
        "native_credential_operations": { "const": 0 },
        "sole_failed_readiness_fact": { "const": "Foreground=false" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "predecessor_state", "successor_generation_id", "fresh_generation_creation", "assignment_kind", "helper_launches", "prior_authority_replay", "foreground_readiness", "typed_failure_settlement", "dns_resolutions", "network_operations", "provider_operations", "billable_operations", "provider_effect"],
      "properties": {
        "mode": { "const": "run-fresh-exact-replace-helper-after-foreground-readiness-correction" },
        "predecessor_state": { "const": "ordinal1-delete-pending-unavailable-cleanup-failed" },
        "successor_generation_id": { "$ref": "#/$defs/id" },
        "fresh_generation_creation": { "const": "prohibited-already-durably-reserved" },
        "assignment_kind": { "const": "Replace" },
        "helper_launches": { "const": 1 },
        "prior_authority_replay": { "const": "prohibited" },
        "foreground_readiness": { "const": "strict-measured-required-before-action" },
        "typed_failure_settlement": { "const": "required-before-stopped-evidence-publication" },
        "dns_resolutions": { "const": 0 },
        "network_operations": { "const": 0 },
        "provider_operations": { "const": 0 },
        "billable_operations": { "const": 0 },
        "provider_effect": { "const": "prohibited" }
      }
    },
    "preserved_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_budget_nano_usd", "historical_evidence_immutable", "secret_isolation", "private_answer_isolation", "enumeration", "exposure", "slice7"],
      "properties": {
        "hard_budget_nano_usd": { "const": 10000000000 },
        "historical_evidence_immutable": { "const": true },
        "secret_isolation": { "const": true },
        "private_answer_isolation": { "const": true },
        "enumeration": { "const": "prohibited" },
        "exposure": { "const": "prohibited" },
        "slice7": { "const": "not-authorized" }
      }
    },
    "authorized_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$" },
    "bindingPath": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" } } }
  }
}
