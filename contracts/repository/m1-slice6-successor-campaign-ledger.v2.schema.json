{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.m1-s6.successor-campaign-ledger/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "campaign_id", "campaign_manifest_sha256", "terminal_campaign_id", "terminal_event_hash", "state", "event", "attempt", "evidence_id", "evidence_sha256", "failure_disposition", "wp9_possible_starts", "wp10_possible_starts", "wp11_possible_starts", "wp9_authoritative", "wp10_authoritative", "wp11_authoritative", "prior_conservative_nano_usd", "successor_cumulative_reserved_nano_usd", "successor_outstanding_reserved_nano_usd", "successor_unresolved_nano_usd", "successor_settled_nano_usd", "previous_hash", "event_hash", "recorded_at_utc"],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "campaign_id": { "type": "string" }, "campaign_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "terminal_campaign_id": { "const": "infinium.m1-s6.finite-live-campaign/ff2d542a-04f0-448a-bcb8-a0ecbedde5b9" },
    "terminal_event_hash": { "const": "282c97151dbdcd354288b67f96c4b01d7f7ef43b1bbfb9f247cbd9b510506de9" },
    "state": { "enum": ["ready", "reviewed", "admitted", "attempt-reserved", "attempt-started", "attempt-evidence-handoff", "authoritative-recovery-handoff", "attempt-failure-accepted", "correction-reviewed", "stage-accepted", "composed-evidence-handoff", "completed", "stopped"] },
    "event": { "type": "string" },
    "attempt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/attempt" }] },
    "evidence_id": { "type": "string" }, "evidence_sha256": { "type": "string" },
    "failure_disposition": { "type": "string" },
    "wp9_possible_starts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "wp10_possible_starts": { "type": "integer", "minimum": 0, "maximum": 5 },
    "wp11_possible_starts": { "type": "integer", "minimum": 0, "maximum": 5 },
    "wp9_authoritative": { "type": "boolean" }, "wp10_authoritative": { "type": "boolean" }, "wp11_authoritative": { "type": "boolean" },
    "prior_conservative_nano_usd": { "const": 140000000 },
    "successor_cumulative_reserved_nano_usd": { "type": "integer", "minimum": 0, "maximum": 9860000000 },
    "successor_outstanding_reserved_nano_usd": { "type": "integer", "minimum": 0, "maximum": 9860000000 },
    "successor_unresolved_nano_usd": { "type": "integer", "minimum": 0, "maximum": 9860000000 },
    "successor_settled_nano_usd": { "type": "integer", "minimum": 0, "maximum": 9860000000 },
    "previous_hash": { "$ref": "#/$defs/sha256" }, "event_hash": { "$ref": "#/$defs/sha256" },
    "recorded_at_utc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "attempt_ordinal", "attempt_id", "stage_manifest_id", "stage_manifest_sha256", "runtime_authority_id", "runtime_authority_sha256", "request_id", "reservation_id", "dispatch_fence_id"],
      "properties": {
        "stage": { "enum": ["qualification", "source-claim-extraction", "candidate-investigation"] },
        "attempt_ordinal": { "type": "integer", "minimum": 1, "maximum": 100 },
        "attempt_id": { "type": "string" }, "stage_manifest_id": { "type": "string" },
        "stage_manifest_sha256": { "$ref": "#/$defs/sha256" }, "runtime_authority_id": { "type": "string" },
        "runtime_authority_sha256": { "$ref": "#/$defs/sha256" }, "request_id": { "type": "string" },
        "reservation_id": { "type": "string" }, "dispatch_fence_id": { "type": "string" }
      }
    }
  }
}
