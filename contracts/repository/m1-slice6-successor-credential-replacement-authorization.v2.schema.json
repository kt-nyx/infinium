{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.repository.m1-slice6-successor-credential-replacement-authorization/2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "authority_id", "evidence_id", "status", "prepared_at_utc", "not_before_utc", "expires_at_utc", "owner_authority", "predecessor_ledger", "product_state", "profile", "release_build", "effect_boundary", "native_boundary", "m1_entry_surface"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-successor-credential-replacement-authorization/2.0.0" },
    "authority_id": { "$ref": "#/$defs/id" },
    "evidence_id": { "$ref": "#/$defs/id" },
    "status": { "const": "independently-reviewed-ready-for-owner-effect" },
    "prepared_at_utc": { "$ref": "#/$defs/canonicalZ" },
    "not_before_utc": { "$ref": "#/$defs/canonicalZ" },
    "expires_at_utc": { "$ref": "#/$defs/canonicalZ" },
    "owner_authority": { "$ref": "#/$defs/bindingPath" },
    "predecessor_ledger": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "sequence", "event_hash"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" }, "sequence": { "const": 44 }, "event_hash": { "$ref": "#/$defs/sha" } } },
    "product_state": { "type": "object", "additionalProperties": false, "required": ["root_absolute", "checkpoint_sha256"], "properties": { "root_absolute": { "type": "string", "minLength": 3, "maxLength": 500 }, "checkpoint_sha256": { "$ref": "#/$defs/sha" } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["access_profile_id", "predecessor_generation_id", "predecessor_target_fingerprint_sha256", "successor_generation_id", "successor_generation_ordinal", "successor_target_fingerprint_sha256", "target_derivation", "target_encoding"], "properties": { "access_profile_id": { "$ref": "#/$defs/id" }, "predecessor_generation_id": { "$ref": "#/$defs/id" }, "predecessor_target_fingerprint_sha256": { "$ref": "#/$defs/sha" }, "successor_generation_id": { "$ref": "#/$defs/id" }, "successor_generation_ordinal": { "const": 3 }, "successor_target_fingerprint_sha256": { "$ref": "#/$defs/sha" }, "target_derivation": { "const": "Infinium:<access_profile_id>:<generation_id>" }, "target_encoding": { "const": "utf-8" } } },
    "release_build": { "type": "object", "additionalProperties": false, "required": ["implementation_commit", "coordinator_path", "coordinator_sha256", "helper_path", "helper_sha256"], "properties": { "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "coordinator_path": { "$ref": "#/$defs/path" }, "coordinator_sha256": { "$ref": "#/$defs/sha" }, "helper_path": { "$ref": "#/$defs/path" }, "helper_sha256": { "$ref": "#/$defs/sha" } } },
    "effect_boundary": { "type": "object", "additionalProperties": false, "required": ["evidence_path", "helper_launches", "dns_resolutions", "network_operations", "provider_operations", "billable_operations", "automatic_retry", "enumeration", "secret_exposure"], "properties": { "evidence_path": { "$ref": "#/$defs/path" }, "helper_launches": { "const": 1 }, "dns_resolutions": { "const": 0 }, "network_operations": { "const": 0 }, "provider_operations": { "const": 0 }, "billable_operations": { "const": 0 }, "automatic_retry": { "const": false }, "enumeration": { "const": "prohibited" }, "secret_exposure": { "const": "prohibited" } } },
    "native_boundary": { "type": "object", "additionalProperties": false, "required": ["maximum_calls", "enumeration", "overwrite", "predecessor_delete"], "properties": { "maximum_calls": { "type": "object", "additionalProperties": false, "required": ["CredWriteW", "CredReadW", "CredDeleteW", "CredFree", "total"], "properties": { "CredWriteW": { "const": 1 }, "CredReadW": { "const": 6 }, "CredDeleteW": { "const": 1 }, "CredFree": { "const": 3 }, "total": { "const": 11 } } }, "enumeration": { "const": "prohibited" }, "overwrite": { "const": "prohibited" }, "predecessor_delete": { "const": "required-after-successor-write-readback-verification" } } },
    "m1_entry_surface": { "type": "object", "required": ["purpose", "owner", "presentation", "masked", "paste_permitted", "renderer_receives_or_retains_secret", "manual_value", "readiness_deadline_seconds", "response_deadline_seconds", "readiness_requirements", "pre_readiness_input", "input_bound", "expected_character_length", "expected_utf8_byte_length", "cleanup_requirements", "cancel_result"], "additionalProperties": false, "properties": { "purpose": { "type": "string" }, "owner": { "const": "one-shot-credential-helper" }, "presentation": { "const": "direct-helper-owned-native-modal" }, "masked": { "const": true }, "paste_permitted": { "const": true }, "renderer_receives_or_retains_secret": { "const": false }, "manual_value": { "type": "string" }, "readiness_deadline_seconds": { "const": 10 }, "response_deadline_seconds": { "const": 600 }, "readiness_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "pre_readiness_input": { "type": "string" }, "input_bound": { "const": "exact-164-characters-exact-164-canonical-ascii-bytes-no-truncation" }, "expected_character_length": { "const": 164 }, "expected_utf8_byte_length": { "const": 164 }, "cleanup_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "cancel_result": { "type": "string" } } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$" },
    "bindingPath": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "canonicalZ": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" }
  }
}
