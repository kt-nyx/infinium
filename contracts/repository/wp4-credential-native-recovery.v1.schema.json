{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/wp4-credential-native-recovery.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "manifest_id", "status", "effect_authority", "prepared_at_utc", "expires_at_utc", "binding", "disposable_namespace", "native_boundary", "limits", "cleanup_contract", "execution_command"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.wp4-credential-native-recovery/1.0.0" },
    "manifest_id": { "const": "infinium.m1-s6.wp4.credential-native-recovery/dea7e27a-beb9-41b0-8345-b878baf26240" },
    "status": { "enum": ["draft-binding-pending", "ready-for-owner-acceptance"] },
    "effect_authority": { "const": "none-until-owner-accepts-exact-recovery-manifest" },
    "prepared_at_utc": { "type": "string", "format": "date-time" },
    "expires_at_utc": { "type": "string", "format": "date-time" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed_manifest_id", "failed_manifest_sha256", "failure_record_commit", "consumed_lock_sha256", "close_ready_recovery_commit", "required_branch"],
      "properties": {
        "failed_manifest_id": { "const": "infinium.m1-s6.wp4.credential-native-authorization/cedc4c47-0c58-490e-8d14-5159362aadf3" },
        "failed_manifest_sha256": { "const": "6a2c1f39137de8e40d9e9574ba963d39c8bbdb7c880663a363cc69e65145c952" },
        "failure_record_commit": { "const": "fd6bd645f041502333d92b5e95c69bf8c69f2c83" },
        "consumed_lock_sha256": { "const": "05bf7fc259bf90d367c20f9ba23af3d1525aa2514ee6e1888304cbaf44b364c4" },
        "close_ready_recovery_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "required_branch": { "const": "codex/m1-s6" }
      }
    },
    "disposable_namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace_id", "reuse", "targets"],
      "properties": {
        "namespace_id": { "const": "m1-s6-wp4-native-cedc4c47-0c58-490e-8d14-5159362aadf3" },
        "reuse": { "const": "cleanup-only; never requalification; terminal after this recovery attempt" },
        "targets": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "access_profile_id", "generation_id", "target_fingerprint_sha256"],
            "properties": {
              "alias": { "type": "string", "minLength": 1 },
              "access_profile_id": { "type": "string", "minLength": 1 },
              "generation_id": { "type": "string", "pattern": "^g[0-9]{3}$" },
              "target_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "native_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_calls", "forbidden", "fallback", "ui", "provider"],
      "properties": {
        "allowed_calls": { "const": ["CredReadW", "CredDeleteW", "CredFree"] },
        "forbidden": { "const": ["CredWriteW", "CredEnumerateW", "any prefix/arbitrary target", "any alternate store"] },
        "fallback": { "const": "none" },
        "ui": { "const": "none" },
        "provider": { "const": "none" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "targets", "CredReadW", "CredDeleteW", "CredFree", "total_native_calls", "attempts"],
      "properties": {
        "wall_clock_seconds": { "const": 120 },
        "targets": { "const": 12 },
        "CredReadW": { "const": 36 },
        "CredDeleteW": { "const": 12 },
        "CredFree": { "const": 12 },
        "total_native_calls": { "const": 60 },
        "attempts": { "const": 1 }
      }
    },
    "cleanup_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "ambiguity", "network_operations", "dns_operations", "provider_operations", "billable_operations"],
      "properties": {
        "success": { "const": "each fingerprint ends with exact ERROR_NOT_FOUND and canonical trace/free pairing" },
        "ambiguity": { "const": "stop immediately; no later native call; namespace remains blocked forever" },
        "network_operations": { "const": 0 },
        "dns_operations": { "const": 0 },
        "provider_operations": { "const": 0 },
        "billable_operations": { "const": 0 }
      }
    },
    "execution_command": { "type": "string", "minLength": 1 }
  }
}
