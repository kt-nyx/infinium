{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/candidate-investigation-context.v2.schema.json",
  "title": "infinium.llm.candidate-investigation-context/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "analysis_run_id", "selection_policy", "context_ids", "candidate_ids", "hypothesis_ids", "dependency_closure_ids", "local_observation_ids", "local_observation_fingerprints", "evidence_ids", "evidence_fingerprints"],
  "properties": {
    "schema_id": { "const": "infinium.llm.candidate-investigation-context/v2" }, "schema_version": { "const": "2" }, "analysis_run_id": { "type": "string", "minLength": 1 }, "selection_policy": { "const": "two-matched-contexts-with-declared-host-evidence/v2" },
    "context_ids": { "$ref": "#/$defs/ids" }, "candidate_ids": { "$ref": "#/$defs/ids" }, "hypothesis_ids": { "$ref": "#/$defs/ids" }, "dependency_closure_ids": { "$ref": "#/$defs/single_id" }, "local_observation_ids": { "$ref": "#/$defs/single_id" }, "local_observation_fingerprints": { "$ref": "#/$defs/single_fingerprint" }, "evidence_ids": { "$ref": "#/$defs/ids" }, "evidence_fingerprints": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
  },
  "$defs": { "ids": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "single_id": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "single_fingerprint": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
}
