{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.m1-s6.successor-credential-replacement-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "evidence_id", "status", "authority", "independent_review", "profile", "product_state", "effect", "completed_at_utc"],
  "properties": {
    "schema_identity": { "const": "infinium.m1-s6.successor-credential-replacement-evidence/v1" },
    "evidence_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["passed-active-verified-predecessor-absent", "stopped-non-dispatchable-recovery-required"] },
    "authority": { "$ref": "#/$defs/binding" },
    "independent_review": { "$ref": "#/$defs/binding" },
    "profile": { "type": "object", "additionalProperties": false, "required": ["access_profile_id", "predecessor_generation_id", "predecessor_target_fingerprint_sha256", "successor_generation_id", "successor_target_fingerprint_sha256", "final_generation_id", "final_generation_ordinal", "final_lifecycle_state", "final_verification_state"], "properties": { "access_profile_id": { "$ref": "#/$defs/id" }, "predecessor_generation_id": { "$ref": "#/$defs/id" }, "predecessor_target_fingerprint_sha256": { "$ref": "#/$defs/sha" }, "successor_generation_id": { "$ref": "#/$defs/id" }, "successor_target_fingerprint_sha256": { "$ref": "#/$defs/sha" }, "final_generation_id": { "$ref": "#/$defs/id" }, "final_generation_ordinal": { "type": "integer", "minimum": 1 }, "final_lifecycle_state": { "type": "string", "minLength": 1 }, "final_verification_state": { "type": "string", "minLength": 1 } } },
    "product_state": { "type": "object", "additionalProperties": false, "required": ["root_projection_sha256", "checkpoint_before_sha256", "checkpoint_after_sha256"], "properties": { "root_projection_sha256": { "$ref": "#/$defs/sha" }, "checkpoint_before_sha256": { "$ref": "#/$defs/sha" }, "checkpoint_after_sha256": { "$ref": "#/$defs/sha" } } },
    "effect": { "$ref": "#/$defs/effect" },
    "completed_at_utc": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "passed-active-verified-predecessor-absent" } } }, "then": { "properties": { "profile": { "properties": { "final_generation_ordinal": { "const": 2 }, "final_lifecycle_state": { "const": "active-verified" }, "final_verification_state": { "const": "available" } } }, "effect": { "properties": { "helper_outcome": { "const": "Completed" }, "namespace_reuse_blocked": { "const": false }, "namespace_reuse_block_reason": { "type": "null" } } } } } },
    { "if": { "properties": { "status": { "const": "stopped-non-dispatchable-recovery-required" } } }, "then": { "properties": { "profile": { "properties": { "final_generation_ordinal": { "const": 1 }, "final_lifecycle_state": { "const": "delete-pending" }, "final_verification_state": { "const": "unavailable" } } }, "effect": { "properties": { "helper_outcome": { "enum": ["Cancelled", "FailedKnown", "Unavailable"] } } } } } }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "binding": { "type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "traceItem": { "type": "object", "additionalProperties": false, "required": ["Sequence", "Operation", "TargetFingerprintSha256", "Scenario", "Result", "AllocationId", "PairedAllocationId"], "properties": { "Sequence": { "type": "integer", "minimum": 1, "maximum": 11 }, "Operation": { "enum": ["CredReadW", "CredWriteW", "CredDeleteW", "CredFree"] }, "TargetFingerprintSha256": { "$ref": "#/$defs/sha" }, "Scenario": { "const": "m1-slice6-successor-credential-replacement" }, "Result": { "type": "string", "minLength": 1, "maxLength": 128 }, "AllocationId": { "type": ["integer", "null"], "minimum": 1 }, "PairedAllocationId": { "type": ["integer", "null"], "minimum": 1 } } },
    "canarySurface": { "type": "object", "additionalProperties": false, "required": ["Name", "Kind", "ByteCount", "SecretMatches", "RawTargetMatches"], "properties": { "Name": { "type": "string", "minLength": 1 }, "Kind": { "type": "string", "minLength": 1 }, "ByteCount": { "type": "integer", "minimum": 1 }, "SecretMatches": { "const": 0 }, "RawTargetMatches": { "const": 0 } } },
    "canaries": { "type": "object", "additionalProperties": false, "required": ["SecretMatches", "RawTargetMatches", "RawTargetEncodings", "ScannedSurfaces"], "properties": { "SecretMatches": { "const": 0 }, "RawTargetMatches": { "const": 0 }, "RawTargetEncodings": { "const": ["utf-8", "utf-16le"] }, "ScannedSurfaces": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/canarySurface" } } } },
    "actionSnapshot": { "type": ["object", "null"], "properties": { "Action": { "type": "string" }, "Source": { "type": "string" }, "WindowVisible": { "type": "boolean" }, "EditVisible": { "type": "boolean" }, "InitiallyBlank": { "type": "boolean" }, "HelperProcessOwned": { "type": "boolean" }, "SameSession": { "type": "boolean" }, "InputDesktopAvailable": { "type": "boolean" }, "NotCloaked": { "type": "boolean" }, "OnMonitor": { "type": "boolean" }, "Enabled": { "type": "boolean" }, "Focused": { "type": "boolean" }, "Foreground": { "type": "boolean" }, "Active": { "type": "boolean" }, "CurrentBlank": { "type": "boolean" }, "CurrentCharacterLength": { "type": "integer", "minimum": 0 }, "Admitted": { "type": "boolean" } }, "additionalProperties": false },
    "entry": { "type": "object", "additionalProperties": false, "required": ["Surface", "Masked", "PastePermitted", "HelperOwned", "RendererReceivedSecret", "InitiallyBlank", "Ready", "HelperProcessOwned", "SameSession", "InputDesktopAvailable", "NotCloaked", "OnMonitor", "Enabled", "Focused", "Foreground", "Active", "ReadinessChecks", "PreReadinessIgnoredActions", "MessagePumpIterations", "ActionSnapshot", "TerminalState", "WindowDestroyed", "BufferCleared", "NativeEditEmptyVerified", "ThreadJoined"], "properties": { "Surface": { "const": "wp9-distinct-helper-owned-native-masked-paste-surface" }, "Masked": { "const": true }, "PastePermitted": { "const": true }, "HelperOwned": { "const": true }, "RendererReceivedSecret": { "const": false }, "InitiallyBlank": { "type": "boolean" }, "Ready": { "type": "boolean" }, "HelperProcessOwned": { "type": "boolean" }, "SameSession": { "type": "boolean" }, "InputDesktopAvailable": { "type": "boolean" }, "NotCloaked": { "type": "boolean" }, "OnMonitor": { "type": "boolean" }, "Enabled": { "type": "boolean" }, "Focused": { "type": "boolean" }, "Foreground": { "type": "boolean" }, "Active": { "type": "boolean" }, "ReadinessChecks": { "type": "integer", "minimum": 0 }, "PreReadinessIgnoredActions": { "type": "integer", "minimum": 0 }, "MessagePumpIterations": { "type": "integer", "minimum": 0 }, "ActionSnapshot": { "$ref": "#/$defs/actionSnapshot" }, "TerminalState": { "enum": ["submitted", "cancelled", "failed", "timed-out"] }, "WindowDestroyed": { "const": true }, "BufferCleared": { "const": true }, "NativeEditEmptyVerified": { "const": true }, "ThreadJoined": { "const": true } } },
    "effect": { "type": "object", "additionalProperties": false, "required": ["helper_launch_count", "native_credential_operation_count", "native_call_trace", "entry_evidence", "canaries", "staged_response_byte_length", "network_operation_count", "listener_count", "provider_operation_count", "billable_operation_count", "retry_attempted", "helper_outcome", "namespace_reuse_blocked", "namespace_reuse_block_reason", "containment"], "properties": { "helper_launch_count": { "const": 1 }, "native_credential_operation_count": { "type": "integer", "minimum": 0, "maximum": 11 }, "native_call_trace": { "type": "array", "maxItems": 11, "items": { "$ref": "#/$defs/traceItem" } }, "entry_evidence": { "$ref": "#/$defs/entry" }, "canaries": { "$ref": "#/$defs/canaries" }, "staged_response_byte_length": { "const": 0 }, "network_operation_count": { "const": 0 }, "listener_count": { "const": 0 }, "provider_operation_count": { "const": 0 }, "billable_operation_count": { "const": 0 }, "retry_attempted": { "const": false }, "helper_outcome": { "enum": ["Completed", "Cancelled", "FailedKnown", "Unavailable"] }, "namespace_reuse_blocked": { "type": "boolean" }, "namespace_reuse_block_reason": { "type": ["string", "null"] }, "containment": { "type": "object", "additionalProperties": false, "required": ["probe_executed", "process_tree_terminated", "process_tree_survivor_count", "active_process_count_before_job_close", "total_contained_process_count", "excluded_handle_accessible"], "properties": { "probe_executed": { "const": true }, "process_tree_terminated": { "const": true }, "process_tree_survivor_count": { "const": 0 }, "active_process_count_before_job_close": { "type": "integer", "minimum": 1 }, "total_contained_process_count": { "type": "integer", "minimum": 2 }, "excluded_handle_accessible": { "const": false } } } } }
  }
}
