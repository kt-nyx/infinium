{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/wp4-credential-native-authorization.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity", "manifest_id", "status", "effect_authority",
    "prepared_at_utc", "expires_at_utc", "candidate_binding", "supersedes",
    "authority", "disposable_namespace", "native_boundary", "entry_boundary",
    "provider_boundary", "operation_limits", "qualification_components",
    "required_scenarios", "backup_restore_recovery", "canary_contract",
    "cleanup_contract", "required_evidence", "independent_review",
    "execution_command", "acceptance_binding"
  ],
  "properties": {
    "schema_identity": { "const": "infinium.repository.wp4-credential-native-authorization/1.5.0" },
    "manifest_id": { "const": "infinium.m1-s6.wp4.credential-native-authorization/076b981a-9d32-4e6a-af35-1e7017e0f833" },
    "status": { "enum": ["draft-close-ready-binding-pending", "ready-for-owner-acceptance", "stale-product-candidate-changed"] },
    "effect_authority": { "const": "none-until-owner-accepts-exact-manifest-bytes" },
    "prepared_at_utc": { "$ref": "#/$defs/utcTimestamp" },
    "expires_at_utc": { "$ref": "#/$defs/utcTimestamp" },
    "candidate_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_wp3_candidate_commit", "accepted_wp7_product_candidate_commit",
        "accepted_wp7_evidence_commit", "authorization_handoff_commit", "sqlite_correction_candidate_commit",
        "ambiguity_evidence_correction_candidate_commit", "native_failure_evidence_and_containment_correction_candidate_commit",
        "close_ready_implementation_commit", "required_branch", "required_execution_state"],
      "properties": {
        "accepted_wp3_candidate_commit": { "$ref": "#/$defs/gitSha" },
        "accepted_wp7_product_candidate_commit": { "$ref": "#/$defs/gitSha" },
        "accepted_wp7_evidence_commit": { "$ref": "#/$defs/gitSha" },
        "authorization_handoff_commit": { "$ref": "#/$defs/gitSha" },
        "sqlite_correction_candidate_commit": { "const": "2f95692687b60d97db2710835e9d0966f131c164" },
        "ambiguity_evidence_correction_candidate_commit": { "const": "2dce8acc27eece01b0232dd531a2deb27ef752af" },
        "native_failure_evidence_and_containment_correction_candidate_commit": { "const": "3456fe02594fd365b1d2627dd08fad44fe0aee92" },
        "close_ready_implementation_commit": { "$ref": "#/$defs/gitSha" },
        "required_branch": { "const": "codex/m1-s6" },
        "required_execution_state": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "supersedes": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "manifest_sha256", "namespace_disposition",
        "native_evidence_sha256", "authority_lock_sha256", "cleanup_recovery"],
      "properties": {
        "manifest_id": { "const": "infinium.m1-s6.wp4.credential-native-authorization/4936dcef-a0f4-4302-9899-0afd99b19799" },
        "manifest_sha256": { "const": "910ff1552d178bcfe5ff36fd9b618d187203c38c6b023d9610af5c702bdb3393" },
        "namespace_disposition": { "const": "terminal-cleanup-confirmed-absent-never-reuse" },
        "native_evidence_sha256": { "const": "0a10a873b7356612cd8ac25934c8fbf85ab0cae76f7aea42b2317421dd251674" },
        "authority_lock_sha256": { "const": "18ffe3e24687543c7c0d538ec98874245ef3fe0c3d2c26945d375b5e23604d02" },
        "cleanup_recovery": {
          "type": "object", "additionalProperties": false,
          "required": ["manifest_id", "manifest_sha256", "evidence_sha256", "authority_lock_sha256", "receipt_sha256", "combined_namespace_target_absence_count"],
          "properties": {
            "manifest_id": { "const": "infinium.m1-s6.wp4.credential-native-recovery/dd412ecc-3b2c-4628-8865-bc8574a357c7" },
            "manifest_sha256": { "const": "09b6858eaf472038499f18654d2a2fc4ca0a32b2ed34cd1a192146f90755e183" },
            "evidence_sha256": { "const": "427d78e467fa0f26517d35abcb2c4405bbaf4db5a5845f278d9b584effdc271a" },
            "authority_lock_sha256": { "const": "5f9420335ce08c482bf747cf43ac409bb3e13204a6910370c480f9caae00720e" },
            "receipt_sha256": { "const": "eb4ec7b518329081830bceb3e3b4f3894dee74ed7d334eacb532ce72009dc429" },
            "combined_namespace_target_absence_count": { "const": 12 }
          }
        }
      }
    },
    "authority": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "disposable_namespace": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace_id", "derivation", "credential_type", "persistence", "raw_target_retention", "targets", "reuse"],
      "properties": {
        "namespace_id": { "const": "m1-s6-wp4-native-076b981a-9d32-4e6a-af35-1e7017e0f833" },
        "derivation": { "const": "UTF8('Infinium:' + access_profile_id + ':' + generation_id)" },
        "credential_type": { "const": "CRED_TYPE_GENERIC" },
        "persistence": { "const": "CRED_PERSIST_LOCAL_MACHINE" },
        "raw_target_retention": { "$ref": "#/$defs/nonEmptyString" },
        "targets": {
          "type": "array", "minItems": 12, "maxItems": 12, "items": false,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "interactive-primary" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-interactive-primary" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "04b35e2718e202cb0a6bfef233dbe033c791aa02b2261e1779813d310bd3baad" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "interactive-cancel" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-interactive-cancel" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "24f709437c97a67819b06270d0d211aaae426bbfbd56f83774106bd2f7da5277" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "size-valid" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-size-valid" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "6aa891fe3db76c45c994b7b7a461f5242621226a788c489d0bcecde87b78e2dd" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "size-oversize" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-size-oversize" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "01338cb4af7abf7d50b49313cce237db80a389ba1ff2c01d23a8a96ff02d66f2" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "unavailable-store" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-unavailable" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "a7af4cc90f3f3021cf2a7220f92d247165fcaaf1f6b41410ca2d34fd55582895" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "replacement-old" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-replacement" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "e82ee891429ff57587ea0f7f35f6f5ef98ae96a9d5d75da5ad7ee716a645ae77" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "replacement-new" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-replacement" }, "generation_id": { "const": "g002" }, "target_fingerprint_sha256": { "const": "fea103ab44d0057a2a9cc10de5792ffec891cc6fe17086fe960a979d87eb852a" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "revoke-delete" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-revoke-delete" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "92cf677dd3dfc6509d75c9d502c12ae3d4b9295b2c25b4327b965f252b10649d" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "crash-restart" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-crash-restart" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "c36ea4643f97ff6a68d1880445669f213e1ef1e2b71487b3179d6102a1ce0f95" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "backup-old" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-backup-restore" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "1ce6dceb1deea0485f5c56b9dce06eb3d44cda389ff0805291a9719eb1de865f" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "backup-new" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-backup-restore" }, "generation_id": { "const": "g002" }, "target_fingerprint_sha256": { "const": "11d51fa6e870709f346f61e931a91ab8cf5336b689f8ddcfc427283d71fb1d0a" } } }] },
            { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "alias": { "const": "fake-dispatch" }, "access_profile_id": { "const": "m1s6-wp4-076b981a9d324e6aaf351e7017e0f833-fake-dispatch" }, "generation_id": { "const": "g001" }, "target_fingerprint_sha256": { "const": "bcb55be3c8d4f1b89103d28cd5fa40d97fcdbc528ffd2f4513f4f3b12770c0b1" } } }] }
          ]
        },
        "reuse": { "const": "never; uncertainty blocks every target and the entire namespace" }
      }
    },
    "native_boundary": { "$ref": "#/$defs/nativeBoundary" },
    "entry_boundary": { "$ref": "#/$defs/entryBoundary" },
    "provider_boundary": { "$ref": "#/$defs/providerBoundary" },
    "operation_limits": { "$ref": "#/$defs/operationLimits" },
    "qualification_components": {
      "type": "object", "additionalProperties": false,
      "required": ["non_native_prerequisites", "native_success_run", "actual_cleanup_ambiguity_rule"],
      "properties": {
        "non_native_prerequisites": { "$ref": "#/$defs/nonNativePrerequisites" },
        "native_success_run": { "$ref": "#/$defs/nativeSuccessRun" },
        "actual_cleanup_ambiguity_rule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "required_scenarios": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/scenario" } },
    "backup_restore_recovery": { "$ref": "#/$defs/backupRestoreRecovery" },
    "canary_contract": { "$ref": "#/$defs/canaryContract" },
    "cleanup_contract": { "$ref": "#/$defs/cleanupContract" },
    "required_evidence": { "type": "array", "minItems": 14, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "independent_review": { "$ref": "#/$defs/independentReview" },
    "execution_command": { "$ref": "#/$defs/nonEmptyString" },
    "acceptance_binding": { "$ref": "#/$defs/acceptanceBinding" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utcTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "stringArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "nativeBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_calls", "call_rules", "forbidden_calls", "fallback"],
      "properties": {
        "allowed_calls": { "type": "array", "prefixItems": [
          { "const": "CredWriteW" }, { "const": "CredReadW" },
          { "const": "CredDeleteW" }, { "const": "CredFree" }
        ], "items": false },
        "call_rules": { "$ref": "#/$defs/stringArray" },
        "forbidden_calls": { "$ref": "#/$defs/stringArray" },
        "fallback": { "const": "none" }
      }
    },
    "entryBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "control", "echo", "prepopulate", "clipboard_return", "operator_action", "readiness_oracle", "action_routing", "terminal_behavior"],
      "properties": {
        "owner": { "const": "one-shot credential helper" },
        "control": { "$ref": "#/$defs/nonEmptyString" },
        "echo": { "const": false }, "prepopulate": { "const": false },
        "clipboard_return": { "const": false },
        "operator_action": { "$ref": "#/$defs/nonEmptyString" },
        "readiness_oracle": { "$ref": "#/$defs/nonEmptyString" },
        "action_routing": { "$ref": "#/$defs/nonEmptyString" },
        "terminal_behavior": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "providerBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["dispatch", "dns_operations", "network_operations", "provider_operations", "billable_operations", "api_key"],
      "properties": {
        "dispatch": { "$ref": "#/$defs/nonEmptyString" },
        "dns_operations": { "const": 0 }, "network_operations": { "const": 0 },
        "provider_operations": { "const": 0 }, "billable_operations": { "const": 0 },
        "api_key": { "const": "not-used" }
      }
    },
    "nativeCallMaxima": {
      "type": "object", "additionalProperties": false,
      "required": ["CredWriteW", "CredReadW", "CredDeleteW", "CredFree", "total"],
      "properties": {
        "CredWriteW": { "const": 9 },
        "CredReadW": { "const": 78 },
        "CredDeleteW": { "const": 9 },
        "CredFree": { "const": 28 },
        "total": { "const": 124 }
      }
    },
    "operationLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_window_seconds", "gate_wall_clock_seconds", "primary_phase_seconds", "cleanup_reserve_seconds", "evidence_reserve_seconds", "helper_processes", "entry_dialogs", "fake_provider_dispatches", "credential_blob_bytes", "cleanup_attempts_per_target", "native_call_maxima"],
      "properties": {
        "authorization_window_seconds": { "const": 172800 },
        "gate_wall_clock_seconds": { "const": 1800 },
        "primary_phase_seconds": { "const": 1650 },
        "cleanup_reserve_seconds": { "const": 120 },
        "evidence_reserve_seconds": { "const": 30 },
        "helper_processes": { "const": 48 },
        "entry_dialogs": { "const": 3 }, "fake_provider_dispatches": { "const": 1 },
        "credential_blob_bytes": { "const": 2560 },
        "cleanup_attempts_per_target": { "const": 2 },
        "native_call_maxima": { "$ref": "#/$defs/nativeCallMaxima" }
      }
    },
    "nonNativePrerequisites": {
      "type": "object", "additionalProperties": false,
      "required": ["cleanup_ambiguity_probe", "deadline_and_ui_fault_proofs", "canary_mutation_proofs", "trace_and_free_pairing_proofs"],
      "properties": {
        "cleanup_ambiguity_probe": { "$ref": "#/$defs/nonEmptyString" },
        "deadline_and_ui_fault_proofs": { "$ref": "#/$defs/nonEmptyString" },
        "canary_mutation_proofs": { "$ref": "#/$defs/nonEmptyString" },
        "trace_and_free_pairing_proofs": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "nativeSuccessRun": {
      "type": "object", "additionalProperties": false,
      "required": ["inject_cleanup_ambiguity", "pass_condition", "process_model"],
      "properties": {
        "inject_cleanup_ambiguity": { "const": false },
        "pass_condition": { "$ref": "#/$defs/nonEmptyString" },
        "process_model": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "backupRestoreRecovery": {
      "type": "object", "additionalProperties": false,
      "required": ["backup_secret", "backup_target", "restored_state", "reactivation", "old_target_cleanup"],
      "properties": {
        "backup_secret": { "const": "absent" }, "backup_target": { "const": "absent" },
        "restored_state": { "const": "recovery-required" },
        "reactivation": { "$ref": "#/$defs/nonEmptyString" },
        "old_target_cleanup": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "canaryContract": {
      "type": "object", "additionalProperties": false,
      "required": ["secret_canary", "target_canary", "authorized_surfaces", "forbidden_surfaces", "pass_condition"],
      "properties": {
        "secret_canary": { "$ref": "#/$defs/nonEmptyString" },
        "target_canary": { "$ref": "#/$defs/nonEmptyString" },
        "authorized_surfaces": { "$ref": "#/$defs/stringArray" },
        "forbidden_surfaces": { "$ref": "#/$defs/stringArray" },
        "pass_condition": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "cleanupContract": {
      "type": "object", "additionalProperties": false,
      "required": ["terminal_paths", "preflight_collision", "procedure", "absence_proof", "ambiguous_or_failed", "reuse_after_absence"],
      "properties": {
        "terminal_paths": { "$ref": "#/$defs/stringArray" },
        "preflight_collision": { "$ref": "#/$defs/nonEmptyString" },
        "procedure": { "$ref": "#/$defs/nonEmptyString" },
        "absence_proof": { "$ref": "#/$defs/nonEmptyString" },
        "ambiguous_or_failed": { "$ref": "#/$defs/nonEmptyString" },
        "reuse_after_absence": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "independentReview": {
      "type": "object", "additionalProperties": false,
      "required": ["fresh", "read_only", "review_scope", "acceptance_rule"],
      "properties": {
        "fresh": { "const": true }, "read_only": { "const": true },
        "review_scope": { "$ref": "#/$defs/stringArray" },
        "acceptance_rule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "acceptanceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "recording", "expiry_rule", "mutation_rule", "second_run_rule"],
      "properties": {
        "method": { "$ref": "#/$defs/nonEmptyString" },
        "recording": { "$ref": "#/$defs/nonEmptyString" },
        "expiry_rule": { "$ref": "#/$defs/nonEmptyString" },
        "mutation_rule": { "$ref": "#/$defs/nonEmptyString" },
        "second_run_rule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["alias", "access_profile_id", "generation_id", "target_fingerprint_sha256"],
      "properties": {
        "alias": { "$ref": "#/$defs/nonEmptyString" },
        "access_profile_id": { "type": "string", "pattern": "^[a-z0-9-]{1,160}$" },
        "generation_id": { "type": "string", "pattern": "^g[0-9]{3}$" },
        "target_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "targets", "required_result"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "targets": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "required_result": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
