{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinium.invalid/contracts/repository/m1-slice6-campaign-stage-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "manifest_id", "status", "candidate_binding", "campaign_binding", "stage", "predecessor_evidence", "canonical_request", "transport", "limits", "safety_identifier", "validation_package", "execution"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-campaign-stage-request/1.0.0" },
    "manifest_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["verification-pending", "ready-for-independent-review", "reviewed-and-admitted"] },
    "candidate_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["close_ready_implementation_commit", "review_candidate_resolution"],
      "properties": {
        "close_ready_implementation_commit": { "$ref": "#/$defs/sha40OrPending" },
        "review_candidate_resolution": { "enum": ["pending", "exact-clean-committed-two-file-stage-candidate"] }
      }
    },
    "campaign_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "campaign_manifest_sha256", "campaign_review_candidate_commit", "credential_manifest_id", "credential_manifest_sha256"],
      "properties": {
        "campaign_id": { "$ref": "#/$defs/id" },
        "campaign_manifest_sha256": { "$ref": "#/$defs/sha64" },
        "campaign_review_candidate_commit": { "$ref": "#/$defs/sha40" },
        "credential_manifest_id": { "$ref": "#/$defs/id" },
        "credential_manifest_sha256": { "$ref": "#/$defs/sha64" }
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "work_package", "operation"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 3 },
        "work_package": { "enum": ["WP9", "WP10", "WP11"] },
        "operation": { "enum": ["Qualification", "SourceClaimExtraction", "CandidateInvestigation"] }
      }
    },
    "predecessor_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["ledger_event_hash", "evidence_id", "evidence_sha256"],
      "properties": {
        "ledger_event_hash": { "$ref": "#/$defs/sha64" },
        "evidence_id": { "$ref": "#/$defs/id" },
        "evidence_sha256": { "$ref": "#/$defs/sha64" }
      }
    },
    "canonical_request": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "campaign_input_bytes", "campaign_input_sha256", "request_template_sha256", "input_bound_policy_id", "input_bound_policy_version", "o200k_token_count", "token_ids_sha256", "structural_allowance_tokens", "proved_input_tokens", "maximum_output_tokens"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,240}$" },
        "sha256": { "$ref": "#/$defs/sha64" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "campaign_input_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "campaign_input_sha256": { "$ref": "#/$defs/sha64" },
        "request_template_sha256": { "$ref": "#/$defs/sha64" },
        "input_bound_policy_id": { "const": "openai-responses-o200k-byte-envelope" },
        "input_bound_policy_version": { "const": "v2" },
        "o200k_token_count": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "token_ids_sha256": { "$ref": "#/$defs/sha64" },
        "structural_allowance_tokens": { "enum": [4096, 8192] },
        "proved_input_tokens": { "type": "integer", "minimum": 0, "maximum": 73728 },
        "maximum_output_tokens": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["scheme", "host", "path", "method", "tool_choice", "tool_count", "retry_count", "parallel", "maximum_provider_calls", "maximum_dns_resolutions"],
      "properties": {
        "scheme": { "const": "https" }, "host": { "const": "api.openai.com" },
        "path": { "const": "/v1/responses" }, "method": { "const": "POST" },
        "tool_choice": { "const": "none" }, "tool_count": { "const": 0 },
        "retry_count": { "const": 0 }, "parallel": { "const": false },
        "maximum_provider_calls": { "const": 1 }, "maximum_dns_resolutions": { "const": 1 }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_request_bytes", "maximum_input_tokens", "maximum_output_tokens", "maximum_raw_response_bytes", "maximum_nano_usd", "deadline_milliseconds"],
      "properties": {
        "maximum_request_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maximum_input_tokens": { "type": "integer", "minimum": 1, "maximum": 73728 },
        "maximum_output_tokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maximum_raw_response_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maximum_nano_usd": { "type": "integer", "minimum": 1, "maximum": 600000000 },
        "deadline_milliseconds": { "enum": [60000, 120000] }
      }
    },
    "safety_identifier": {
      "type": "object", "additionalProperties": false,
      "required": ["projection", "state_version", "raw_seed_present"],
      "properties": {
        "projection": { "$ref": "#/$defs/sha64" },
        "state_version": { "const": "infinium.product-user-safety-identifier/1.0.0" },
        "raw_seed_present": { "const": false }
      }
    },
    "validation_package": {
      "type": "object", "additionalProperties": false,
      "required": ["package_id", "manifest_path", "manifest_sha256", "product_input_path", "product_input_bytes", "product_input_sha256", "predecessor_manifest_path", "predecessor_manifest_bytes", "predecessor_manifest_sha256", "oracle_path", "oracle_sha256", "deterministic_oracle_result_sha256", "semantic_use"],
      "properties": {
        "package_id": { "enum": ["M1-PLAT-PROVIDER-CAPABILITY-VAL-v1", "LLM-CLAIM-LIVE-VAL", "LLM-INVESTIGATE-LIVE-VAL"] },
        "manifest_path": { "type": "string", "pattern": "^fixtures/public/[A-Za-z0-9._/-]{1,220}$" },
        "manifest_sha256": { "$ref": "#/$defs/sha64" },
        "product_input_path": { "type": "string", "pattern": "^fixtures/public/[A-Za-z0-9._/-]{1,220}$" },
        "product_input_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "product_input_sha256": { "$ref": "#/$defs/sha64" },
        "predecessor_manifest_path": { "type": "string", "pattern": "^fixtures/public/[A-Za-z0-9._/-]{1,220}$" },
        "predecessor_manifest_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "predecessor_manifest_sha256": { "$ref": "#/$defs/sha64" },
        "oracle_path": { "type": "string", "pattern": "^fixtures/public/[A-Za-z0-9._/-]{1,220}$" },
        "oracle_sha256": { "$ref": "#/$defs/sha64" },
        "deterministic_oracle_result_sha256": { "$ref": "#/$defs/sha64" },
        "semantic_use": { "type": "boolean" }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_request_permitted", "requires_exact_review_marker", "requires_exact_admission_marker", "automatic_retry", "fourth_call_permitted"],
      "properties": {
        "provider_request_permitted": { "type": "boolean" },
        "requires_exact_review_marker": { "const": true },
        "requires_exact_admission_marker": { "const": true },
        "automatic_retry": { "const": false },
        "fourth_call_permitted": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "verification-pending" } }, "required": ["status"] },
      "then": { "properties": { "candidate_binding": { "properties": { "close_ready_implementation_commit": { "const": "pending" }, "review_candidate_resolution": { "const": "pending" } } }, "execution": { "properties": { "provider_request_permitted": { "const": false } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "ready-for-independent-review" } }, "required": ["status"] },
      "then": { "properties": { "candidate_binding": { "properties": { "close_ready_implementation_commit": { "$ref": "#/$defs/sha40" }, "review_candidate_resolution": { "const": "exact-clean-committed-two-file-stage-candidate" } } }, "execution": { "properties": { "provider_request_permitted": { "const": false } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "reviewed-and-admitted" } }, "required": ["status"] },
      "then": { "properties": { "candidate_binding": { "properties": { "close_ready_implementation_commit": { "$ref": "#/$defs/sha40" }, "review_candidate_resolution": { "const": "exact-clean-committed-two-file-stage-candidate" } } }, "execution": { "properties": { "provider_request_permitted": { "const": true } } } } }
    },
    {
      "if": { "properties": { "stage": { "properties": { "operation": { "const": "Qualification" } }, "required": ["operation"] } }, "required": ["stage"] },
      "then": { "properties": { "validation_package": { "properties": { "package_id": { "const": "M1-PLAT-PROVIDER-CAPABILITY-VAL-v1" }, "semantic_use": { "const": false } } } } }
    },
    {
      "if": { "properties": { "stage": { "properties": { "operation": { "const": "SourceClaimExtraction" } }, "required": ["operation"] } }, "required": ["stage"] },
      "then": { "properties": { "validation_package": { "properties": { "package_id": { "const": "LLM-CLAIM-LIVE-VAL" }, "semantic_use": { "const": true } } } } }
    },
    {
      "if": { "properties": { "stage": { "properties": { "operation": { "const": "CandidateInvestigation" } }, "required": ["operation"] } }, "required": ["stage"] },
      "then": { "properties": { "validation_package": { "properties": { "package_id": { "const": "LLM-INVESTIGATE-LIVE-VAL" }, "semantic_use": { "const": true } } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,200}$" },
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha40OrPending": { "oneOf": [{ "$ref": "#/$defs/sha40" }, { "const": "pending" }] }
  }
}
