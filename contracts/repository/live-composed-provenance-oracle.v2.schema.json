{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/live-composed-provenance-oracle.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "package_id",
    "package_version",
    "partition",
    "campaign_id",
    "provider_call_count",
    "validates",
    "frozen_input_bindings",
    "required_stage_order",
    "required_semantic_chain",
    "required_bindings",
    "explicit_omissions",
    "no_fourth_call"
  ],
  "properties": {
    "schema_id": {
      "const": "infinium.evaluation.live-composed-provenance-oracle/2.0.0"
    },
    "schema_version": {
      "const": "2"
    },
    "package_id": {
      "const": "PROV-LIVE-COMPOSED-VAL-v2"
    },
    "package_version": {
      "const": "2.0.0"
    },
    "partition": {
      "const": "validation"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_call_count": {
      "type": "integer",
      "minimum": 0
    },
    "validates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_live_responses",
        "host_admissions",
        "canned_transcript_execution",
        "provider_request_during_composed_validation"
      ],
      "properties": {
        "retained_live_responses": {
          "const": true
        },
        "host_admissions": {
          "const": true
        },
        "canned_transcript_execution": {
          "const": false
        },
        "provider_request_during_composed_validation": {
          "const": false
        }
      }
    },
    "frozen_input_bindings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "byte_length",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "required_stage_order": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package_id",
              "package_version",
              "semantic_use",
              "role"
            ],
            "properties": {
              "package_id": {
                "type": "string",
                "minLength": 1
              },
              "package_version": {
                "type": "string",
                "minLength": 1
              },
              "semantic_use": {
                "const": false
              },
              "role": {
                "const": "qualification"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package_id",
              "package_version",
              "semantic_use",
              "role"
            ],
            "properties": {
              "package_id": {
                "type": "string",
                "minLength": 1
              },
              "package_version": {
                "type": "string",
                "minLength": 1
              },
              "semantic_use": {
                "const": true
              },
              "role": {
                "const": "wp10-source-claim"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package_id",
              "package_version",
              "semantic_use",
              "role"
            ],
            "properties": {
              "package_id": {
                "type": "string",
                "minLength": 1
              },
              "package_version": {
                "type": "string",
                "minLength": 1
              },
              "semantic_use": {
                "const": true
              },
              "role": {
                "const": "wp11-candidate-investigation"
              }
            }
          }
        ]
      }
    },
    "required_semantic_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wp10",
        "wp11"
      ],
      "properties": {
        "wp10": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquisition_run_id",
            "proposal_id",
            "source_admission_id",
            "admitted_artifact_id",
            "application_link_id",
            "source_revision_id",
            "passage_id",
            "persisted_payload_sha256",
            "required_applicability_fact_id",
            "required_applicability_fact_sha256"
          ],
          "properties": {
            "acquisition_run_id": {
              "type": "string",
              "minLength": 1
            },
            "proposal_id": {
              "type": "string",
              "minLength": 1
            },
            "source_admission_id": {
              "type": "string",
              "minLength": 1
            },
            "admitted_artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "application_link_id": {
              "type": "string",
              "minLength": 1
            },
            "source_revision_id": {
              "type": "string",
              "minLength": 1
            },
            "passage_id": {
              "type": "string",
              "minLength": 1
            },
            "persisted_payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "required_applicability_fact_id": {
              "type": "string",
              "minLength": 1
            },
            "required_applicability_fact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "wp11": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_run_id",
            "accepted_context_id",
            "accepted_candidate_id",
            "accepted_hypothesis_id",
            "required_shared_local_observation_id",
            "required_shared_local_observation_sha256",
            "supporting_evidence_id",
            "evidence_application_link_id",
            "abstained_context_id",
            "abstained_candidate_id",
            "abstained_hypothesis_id",
            "neutral_non_supporting_evidence_id",
            "abstention_reason"
          ],
          "properties": {
            "analysis_run_id": {
              "type": "string",
              "minLength": 1
            },
            "accepted_context_id": {
              "type": "string",
              "minLength": 1
            },
            "accepted_candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "accepted_hypothesis_id": {
              "type": "string",
              "minLength": 1
            },
            "required_shared_local_observation_id": {
              "type": "string",
              "minLength": 1
            },
            "required_shared_local_observation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "supporting_evidence_id": {
              "type": "string",
              "minLength": 1
            },
            "evidence_application_link_id": {
              "type": "string",
              "minLength": 1
            },
            "abstained_context_id": {
              "type": "string",
              "minLength": 1
            },
            "abstained_candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "abstained_hypothesis_id": {
              "type": "string",
              "minLength": 1
            },
            "neutral_non_supporting_evidence_id": {
              "type": "string",
              "minLength": 1
            },
            "abstention_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "required_bindings": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "campaign-authorization",
          "credential-authorization",
          "stage-authorization",
          "canonical-request-hashes",
          "retained-raw-response-hashes",
          "retained-header-hashes",
          "one-owned-usage-per-stage",
          "settlement",
          "replay",
          "stage-evidence-acceptance",
          "semantic-validation-package-hashes"
        ]
      }
    },
    "explicit_omissions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "credentials",
          "raw-target-names",
          "hosted-search",
          "Nexus",
          "private-fixtures",
          "expected-answers"
        ]
      }
    },
    "no_fourth_call": {
      "const": true
    }
  }
}
