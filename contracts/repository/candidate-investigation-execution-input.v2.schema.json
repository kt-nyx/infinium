{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/candidate-investigation-execution-input.v2.schema.json",
  "title": "infinium.llm.candidate-investigation-execution-input/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "package_id", "operation_id", "host_authorization_id", "owner_kind", "owner_id", "analysis_run_id", "application_scope_id", "cost_attribution_scope_id", "prompt_id", "prompt_fingerprint", "contexts"],
  "properties": {
    "schema_id": { "const": "infinium.llm.candidate-investigation-execution-input/v2" }, "schema_version": { "const": "2" }, "package_id": { "type": "string", "minLength": 1 }, "operation_id": { "type": "string", "minLength": 1 }, "host_authorization_id": { "type": "string", "minLength": 1 }, "owner_kind": { "const": "analysis-run" }, "owner_id": { "type": "string", "minLength": 1 }, "analysis_run_id": { "type": "string", "minLength": 1 }, "application_scope_id": { "type": "string", "minLength": 1 }, "cost_attribution_scope_id": { "type": "string", "minLength": 1 }, "prompt_id": { "const": "infinium.m1-s6.candidate-investigation-prompt/v1" }, "prompt_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contexts": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/context" } }
  },
  "$defs": {
    "context": { "type": "object", "additionalProperties": false, "required": ["context_id", "candidate_id", "hypothesis_id", "hypothesis", "participant_ids", "participant_roles", "causal_path_ids", "dependency_closure_id", "local_observations", "evidence"], "properties": { "context_id": { "type": "string", "minLength": 1 }, "candidate_id": { "type": "string", "minLength": 1 }, "hypothesis_id": { "type": "string", "minLength": 1 }, "hypothesis": { "type": "string", "minLength": 1, "maxLength": 4096 }, "participant_ids": { "$ref": "#/$defs/ids" }, "participant_roles": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "causal_path_ids": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "dependency_closure_id": { "type": "string", "minLength": 1 }, "local_observations": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/local_observation" } }, "evidence": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } } } },
    "ids": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "local_observation": { "type": "object", "additionalProperties": false, "required": ["observation_id", "text", "text_sha256"], "properties": { "observation_id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1, "maxLength": 2048 }, "text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "evidence_application_link_id", "relationship", "availability", "content_sha256"], "properties": { "evidence_id": { "type": "string", "minLength": 1 }, "evidence_application_link_id": { "type": "string", "minLength": 1 }, "relationship": { "enum": ["supporting", "neutral"] }, "availability": { "const": "available" }, "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "host_bindings": { "$ref": "#/$defs/host_bindings" }, "host_evidence": { "$ref": "#/$defs/host_evidence" } }, "oneOf": [{ "required": ["host_bindings"], "not": { "required": ["host_evidence"] }, "properties": { "relationship": { "const": "supporting" } } }, { "required": ["host_evidence"], "not": { "required": ["host_bindings"] }, "properties": { "relationship": { "const": "neutral" } } }] },
    "host_bindings": { "type": "object", "additionalProperties": false, "required": ["acquisition_run_id", "proposal_id", "source_admission_id", "admitted_artifact_id", "application_link_id", "source_revision_id", "passage_id", "persisted_payload_sha256"], "properties": { "acquisition_run_id": { "type": "string", "minLength": 1 }, "proposal_id": { "type": "string", "minLength": 1 }, "source_admission_id": { "type": "string", "minLength": 1 }, "admitted_artifact_id": { "type": "string", "minLength": 1 }, "application_link_id": { "type": "string", "minLength": 1 }, "source_revision_id": { "type": "string", "minLength": 1 }, "passage_id": { "type": "string", "minLength": 1 }, "persisted_payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "host_evidence": { "type": "object", "additionalProperties": false, "required": ["evidence_root_id", "applicability_record_id", "source_revision_id", "passage_id"], "properties": { "evidence_root_id": { "type": "string", "minLength": 1 }, "applicability_record_id": { "type": "string", "minLength": 1 }, "source_revision_id": { "type": "string", "minLength": 1 }, "passage_id": { "type": "string", "minLength": 1 } } }
  }
}
