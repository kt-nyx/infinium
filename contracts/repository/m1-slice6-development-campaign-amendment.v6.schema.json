{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.repository.m1-slice6-development-campaign-amendment/6.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "amendment_id", "status", "owner_authority_source", "prior_owner_authority", "retained_failure", "correction", "recovery", "preserved_boundaries", "authorized_at_utc"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-development-campaign-amendment/6.0.0" },
    "amendment_id": { "$ref": "#/$defs/id" },
    "status": { "const": "owner-authorized-credential-replacement-cleanup-recovery" },
    "owner_authority_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "const": "current-owner-task-message" },
        "summary": { "const": "use the confirmed-working fresh key through the masked credential enrollment surface" }
      }
    },
    "prior_owner_authority": { "$ref": "#/$defs/bindingPath" },
    "retained_failure": { "$ref": "#/$defs/bindingPath" },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosis", "implementation_commit", "retained_operation_id", "consumed_helper_launches", "validated_boundary", "terminal_receipt"],
      "properties": {
        "diagnosis": { "const": "replacement-specific-failure-envelope-was-rejected-by-enrollment-only-settlement-validation" },
        "implementation_commit": { "const": "65f68f13ede2745e63026d31073740c5e9327c90" },
        "retained_operation_id": { "const": "m1s6-credential-replacement-5bba03b2f399640c13c0432cab823a05" },
        "consumed_helper_launches": { "const": 1 },
        "validated_boundary": { "const": "absent" },
        "terminal_receipt": { "const": "absent" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "predecessor_state", "successor_generation_id", "fresh_generation_creation", "assignment_kind", "helper_launches", "prior_authority_replay", "typed_failure_settlement", "dns_resolutions", "network_operations", "provider_operations", "billable_operations", "provider_effect"],
      "properties": {
        "mode": { "const": "run-fresh-exact-replace-helper-from-delete-pending-with-typed-failure-settlement" },
        "predecessor_state": { "const": "ordinal1-delete-pending-unavailable-cleanup-failed" },
        "successor_generation_id": { "$ref": "#/$defs/id" },
        "fresh_generation_creation": { "const": "prohibited-already-durably-reserved" },
        "assignment_kind": { "const": "Replace" },
        "helper_launches": { "const": 1 },
        "prior_authority_replay": { "const": "prohibited" },
        "typed_failure_settlement": { "const": "required-before-stopped-evidence-publication" },
        "dns_resolutions": { "const": 0 },
        "network_operations": { "const": 0 },
        "provider_operations": { "const": 0 },
        "billable_operations": { "const": 0 },
        "provider_effect": { "const": "prohibited" }
      }
    },
    "preserved_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_budget_nano_usd", "historical_evidence_immutable", "secret_isolation", "private_answer_isolation", "enumeration", "exposure", "slice7"],
      "properties": {
        "hard_budget_nano_usd": { "const": 10000000000 },
        "historical_evidence_immutable": { "const": true },
        "secret_isolation": { "const": true },
        "private_answer_isolation": { "const": true },
        "enumeration": { "const": "prohibited" },
        "exposure": { "const": "prohibited" },
        "slice7": { "const": "not-authorized" }
      }
    },
    "authorized_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$" },
    "bindingPath": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" } } }
  }
}
