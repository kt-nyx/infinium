{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/m1-slice6-campaign-composed-evidence.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
