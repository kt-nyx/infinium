    "investigation": {
      "allOf": [
        { "$ref": "#/$defs/stage" },
        { "properties": {
          "ordinal": { "const": 3 }, "stage": { "const": "CandidateInvestigation" },
          "stage_manifest_id": { "const": "infinium.m1-s6.campaign-stage/CandidateInvestigation" },
          "evidence_id": { "const": "campaign-stage-evidence-3" },
          "validation_package": { "properties": { "package_id": { "const": "LLM-INVESTIGATE-LIVE-VAL-v2" }, "semantic_use": { "const": true } } },
          "semantic_validation": { "properties": { "validation_id": { "const": "infinium.host.candidate-investigation-admission/v1" }, "proposal_count": { "const": 1 }, "admission_count": { "const": 1 } } }
        } }
      ]
    }
  }
}
