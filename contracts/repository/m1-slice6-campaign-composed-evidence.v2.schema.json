    "credential_generation_id": { "const": "g-cb0c3748ef2b4745b97a9311c89f2b65" },
    "stages": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "oneOf": [
        { "$ref": "#/$defs/qualification" },
        { "$ref": "#/$defs/sourceClaim" },
        { "$ref": "#/$defs/investigation" }
      ] }
    },
    "composed_validation_package": {
      "allOf": [
        { "$ref": "#/$defs/composedValidationPackage" },
        { "properties": {
          "package_id": { "const": "PROV-LIVE-COMPOSED-VAL-v2" },
          "manifest_path": { "const": "fixtures/public/provider/live-campaign/PROV-LIVE-COMPOSED-VAL-v2/public-manifest.json" },
          "manifest_sha256": { "const": "61368c3b8da3808724d64e796b85a3b26043ca4ef1a2e3ad1dd441daf2405be8" },
          "oracle_path": { "const": "fixtures/public/provider/live-campaign/PROV-LIVE-COMPOSED-VAL-v2/oracle.v2.json" },
          "oracle_sha256": { "const": "e85cb6a9ead7c6ecb1a09b677fb8d6b12b3c29f022f6ea03cd8b6812c073e1d2" },
          "semantic_use": { "const": true }
        } }
      ]
    },
    "explicit_omissions": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": { "enum": ["credential-secret", "hosted-search", "nexus", "private-fixture"] }
    },
    "provider_call_count": { "const": 3 },
    "dns_resolution_count": { "const": 3 },
    "aggregate_request_bytes": { "type": "integer", "minimum": 1, "maximum": 147456 },
    "aggregate_input_tokens": { "type": "integer", "minimum": 1, "maximum": 167936 },
    "aggregate_output_tokens": { "type": "integer", "minimum": 1, "maximum": 8448 },
    "aggregate_raw_response_bytes": { "type": "integer", "minimum": 3, "maximum": 2359296 },
    "aggregate_maximum_nano_usd": { "const": 1340000000 },
    "outstanding_reserved_nano_usd": { "const": 0 },
    "settled_nano_usd": { "type": "integer", "minimum": 0, "maximum": 1340000000 },
    "cumulative_credential_calls": {
      "type": "object", "additionalProperties": false,
      "required": ["CredWriteW", "CredReadW", "CredDeleteW", "CredFree", "total"],
      "properties": {
        "CredWriteW": { "const": 1 }, "CredReadW": { "const": 5 },
        "CredDeleteW": { "const": 0 }, "CredFree": { "const": 4 }, "total": { "const": 10 }
      }
