_listener_snapshot_count": { "type": ["integer", "null"], "minimum": 0, "maximum": 32 }, "containment_probe_executed": { "type": ["boolean", "null"] }, "active_contained_process_count_before_job_close": { "type": ["integer", "null"], "minimum": 0, "maximum": 32 }, "total_contained_process_count": { "type": ["integer", "null"], "minimum": 0, "maximum": 32 }, "process_tree_survivor_count": { "type": ["integer", "null"], "minimum": 0, "maximum": 32 }, "process_tree_terminated": { "type": ["boolean", "null"] }, "excluded_handle_accessible": { "type": ["boolean", "null"] }, "native_credential_operation_count": { "type": ["integer", "null"], "minimum": 0, "maximum": 8 }, "failed_predicate_ids": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "enum": ["adapter-dns-count-not-one", "adapter-network-used-false", "adapter-send-count-not-one", "contained-process-count-too-small", "containment-probe-missing", "excluded-handle-accessible", "helper-receipt-unavailable", "listener-snapshot-nonzero", "process-tree-not-terminated", "process-tree-survivor-present", "retry-attempted", "staged-envelope-empty", "staged-envelope-invalid", "tcp-snapshot-count-out-of-range", "transport-may-have-started-false"] } } } },
    "artifacts": { "type": "object", "additionalProperties": false, "required": ["canonical_request_path", "canonical_request_sha256", "raw_response_path", "raw_response_sha256", "response_headers_path", "response_headers_sha256", "native_trace_path", "native_trace_sha256", "canary_evidence_path", "canary_evidence_sha256"], "properties": { "canonical_request_path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "canonical_request_sha256": { "$ref": "#/$defs/sha256" }, "raw_response_path": { "$ref": "#/$defs/nullablePath" }, "raw_response_sha256": { "$ref": "#/$defs/nullableSha" }, "response_headers_path": { "$ref": "#/$defs/nullablePath" }, "response_headers_sha256": { "$ref": "#/$defs/nullableSha" }, "native_trace_path": { "$ref": "#/$defs/nullablePath" }, "native_trace_sha256": { "$ref": "#/$defs/nullableSha" }, "canary_evidence_path": { "$ref": "#/$defs/nullablePath" }, "canary_evidence_sha256": { "$ref": "#/$defs/nullableSha" } } },
