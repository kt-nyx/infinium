{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.m1-s6.successor-credential-replacement-failure-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "evidence_id", "operation_id", "status", "authority", "independent_review", "product_state", "observed_effect_facts", "typed_failure", "isolation_observation", "completed_at_utc"],
  "properties": {
    "schema_identity": { "const": "infinium.m1-s6.successor-credential-replacement-failure-evidence/v1" },
    "evidence_id": { "$ref": "#/$defs/id" },
    "operation_id": { "$ref": "#/$defs/id" },
    "status": { "const": "stopped-ambiguous-effect-recovery-required" },
    "authority": { "type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "independent_review": { "type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "product_state": { "type": "object", "additionalProperties": false, "required": ["checkpoint_sha256", "profile_id", "generation_id", "generation_ordinal", "lifecycle_state"], "properties": { "checkpoint_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "profile_id": { "$ref": "#/$defs/id" }, "generation_id": { "$ref": "#/$defs/id" }, "generation_ordinal": { "type": "integer", "minimum": 0 }, "lifecycle_state": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "observed_effect_facts": { "const": "unknown-conservatively-blocked" },
    "typed_failure": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._]+$" },
    "isolation_observation": { "const": "fallback-fields-are-secret-free-effect-isolation-unverified-stop-condition" },
    "completed_at_utc": { "type": "string", "format": "date-time" }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
