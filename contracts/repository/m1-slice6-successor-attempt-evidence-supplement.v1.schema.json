{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.m1-s6.successor-attempt-evidence-supplement/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "supplement_id", "campaign_id", "attempt_id", "original_evidence_id", "original_evidence_sha256", "normalized_evidence_path", "normalized_evidence_sha256", "normalized_fields", "accepted_claims", "limitations", "provider_effect_used", "created_at_utc"],
  "properties": {
    "schema": { "const": "infinium.m1-s6.successor-attempt-evidence-supplement/v1" },
    "supplement_id": { "$ref": "#/$defs/id" },
    "campaign_id": { "$ref": "#/$defs/id" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "original_evidence_id": { "$ref": "#/$defs/id" },
    "original_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "normalized_evidence_path": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
    "normalized_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "normalized_fields": { "type": "array", "items": { "enum": ["response_id", "usage_entry_id", "replay_edge_id", "semantic_failure_code"] }, "uniqueItems": true, "minItems": 4, "maxItems": 4 },
    "accepted_claims": { "type": "object", "additionalProperties": false, "required": ["possible_start_and_accounting", "actual_adapter_send_count", "exact_containment_predicate", "credential_read_free_trace"], "properties": {
      "possible_start_and_accounting": { "const": "accepted" },
      "actual_adapter_send_count": { "const": "unverified" },
      "exact_containment_predicate": { "const": "unavailable" },
      "credential_read_free_trace": { "const": "not-independently-retained" }
    }},
    "limitations": { "type": "array", "items": { "enum": ["actual-adapter-send-count-unverified", "credential-read-free-trace-not-independently-retained", "exact-containment-predicate-unavailable"] }, "uniqueItems": true, "minItems": 3, "maxItems": 3 },
    "provider_effect_used": { "const": false },
    "created_at_utc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
