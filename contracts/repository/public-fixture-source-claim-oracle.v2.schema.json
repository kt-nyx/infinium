                  "passage_ids",
                  "proposal_state",
                  "host_admission",
                  "reason"
                ],
                "properties": {
                  "state": {
                    "const": "contradictory"
                  },
                  "passage_ids": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
