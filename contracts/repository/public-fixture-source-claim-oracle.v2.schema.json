                    "const": "unavailable"
                  },
                  "host_admission": {
                    "const": "forbidden"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "passage_ids",
                  "proposal_state",
                  "host_admission",
                  "reason"
                ],
                "properties": {
                  "state": {
                    "const": "hostile-untrusted"
