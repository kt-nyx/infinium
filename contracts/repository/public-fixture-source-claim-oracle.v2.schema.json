            "requires_explicit_abstention_for_passage_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "relay-retention-record-gate",
                  "relay-underdetermined-note"
                ]
              }
            },
            "forbidden": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
