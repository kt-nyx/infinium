{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/public-fixture-source-claim-oracle.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "package_id",
    "package_version",
    "partition",
    "input_bindings",
    "expected_semantics"
  ],
  "properties": {
