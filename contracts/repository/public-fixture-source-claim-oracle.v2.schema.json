      "const": "infinium.evaluation.source-claim-oracle/2.0.0"
    },
    "schema_version": {
      "const": "2"
    },
    "package_id": {
      "const": "S6-CLAIM-LIVE-VAL-v2"
    },
    "package_version": {
      "const": "2.0.0"
    },
    "partition": {
      "const": "validation"
