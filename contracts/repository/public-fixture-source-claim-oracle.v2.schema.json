                  "passage_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "relay-untrusted-note"
                      ]
                    }
                  },
                  "proposal_state": {
                    "const": "unsupported"
                  },
                  "host_admission": {
                    "const": "forbidden"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
