{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/public-fixture-registry.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "registry_version", "status", "package_count", "packages"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.public-fixture-registry/1.2.0" },
    "registry_version": { "const": "1.2.0" },
    "status": { "const": "current" },
    "package_count": { "const": 27 },
    "packages": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/](?:.*[^\\\\/])?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_identity",
        "package_version",
        "partition",
        "package_path",
        "authority_file",
        "authority_bytes",
        "authority_sha256"
      ],
      "properties": {
        "package_identity": { "$ref": "#/$defs/nonEmptyString" },
        "package_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "partition": { "$ref": "#/$defs/nonEmptyString" },
        "package_path": { "$ref": "#/$defs/relativePath" },
        "authority_file": { "$ref": "#/$defs/relativePath" },
        "authority_bytes": { "type": "integer", "minimum": 1 },
        "authority_sha256": { "$ref": "#/$defs/sha256" },
        "authority_status": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
