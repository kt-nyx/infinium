{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/public-fixture-registry.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "registry_version",
    "status",
    "package_count",
    "family_classifications",
    "packages"
  ],
  "properties": {
    "schema_identity": {
      "const": "infinium.repository.public-fixture-registry/1.15.0"
    },
    "registry_version": {
      "const": "1.15.0"
    },
    "status": {
      "const": "current"
    },
    "package_count": {
      "type": "integer",
      "const": 56
    },
    "family_classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/familyClassification" }
    },
    "packages": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "familyClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "package_path_prefix", "disposition", "required_partition", "current_validation_authority_package"],
      "properties": {
        "family_id": { "const": "semantic-admission" },
        "package_path_prefix": { "const": "fixtures/public/provider/semantic-admission/" },
        "disposition": { "const": "historical-non-authorizing" },
        "required_partition": { "const": "development" },
        "current_validation_authority_package": { "type": "null" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_identity",
        "package_version",
        "partition",
        "package_path",
        "authority_file",
        "authority_bytes",
        "authority_sha256"
      ],
      "properties": {
        "package_identity": {
          "type": "string",
          "minLength": 1
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "partition": {
          "enum": [
            "development",
            "validation",
            "finding-case-causal-conclusions",
            "finding-case-coverage-boundaries",
            "finding-case-reconciliation-lineage",
            "finding-case-taxonomy-history"
          ]
        },
        "package_path": {
          "type": "string",
          "pattern": "^fixtures/public/"
        },
        "authority_file": {
          "type": "string",
          "pattern": "^fixtures/public/.+\\.json$"
        },
        "authority_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "authority_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority_status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
