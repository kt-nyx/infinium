{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/current-fixture-registry.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "registry_version",
    "status",
    "package_count",
    "packages"
  ],
  "properties": {
    "schema_identity": {
      "const": "infinium.repository.current-fixture-registry/1.0.0"
    },
    "registry_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "current"
    },
    "package_count": {
      "type": "integer",
      "const": 30
    },
    "packages": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_identity",
        "package_version",
        "partition",
        "package_path",
        "authority_file",
        "authority_bytes",
        "authority_sha256"
      ],
      "properties": {
        "package_identity": { "type": "string", "minLength": 1 },
        "package_version": { "type": "string", "minLength": 1 },
        "partition": {
          "enum": [
            "development",
            "validation",
            "finding-case-causal-conclusions",
            "finding-case-coverage-boundaries",
            "finding-case-reconciliation-lineage",
            "finding-case-taxonomy-history"
          ]
        },
        "package_path": {
          "type": "string",
          "pattern": "^fixtures/public/(?!provider/)[A-Za-z0-9._/-]+$"
        },
        "authority_file": {
          "type": "string",
          "pattern": "^fixtures/public/(?!provider/)[A-Za-z0-9._/-]+$"
        },
        "authority_bytes": { "type": "integer", "minimum": 1 },
        "authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authority_status": { "type": "string", "minLength": 1 }
      }
    }
  }
}
