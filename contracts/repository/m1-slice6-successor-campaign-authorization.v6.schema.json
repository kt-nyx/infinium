{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.repository.m1-slice6-successor-campaign-authorization/6.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "campaign_id", "status", "prepared_at_utc", "expires_at_utc", "predecessor_campaign", "owner_amendment", "terminal_predecessor", "credential_inheritance", "stage_sources", "limits", "ordered_stages"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-successor-campaign-authorization/6.0.0" },
    "campaign_id": { "$ref": "#/$defs/identity" },
    "status": { "const": "owner-authorized-reviewed-and-admitted" },
    "prepared_at_utc": { "$ref": "#/$defs/utc" },
    "expires_at_utc": { "$ref": "#/$defs/utc" },
    "predecessor_campaign": { "type": "object", "additionalProperties": false, "required": ["campaign_id", "path", "sha256", "historical_only"], "properties": { "campaign_id": { "$ref": "#/$defs/identity" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" }, "historical_only": { "const": true } } },
    "owner_amendment": { "type": "object", "additionalProperties": false, "required": ["amendment_id", "path", "sha256", "owner_acceptance_ceremony"], "properties": { "amendment_id": { "$ref": "#/$defs/identity" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" }, "owner_acceptance_ceremony": { "const": "satisfied-by-current-owner-task-message" } } },
    "terminal_predecessor": { "type": "object", "additionalProperties": false, "required": ["campaign_id", "final_event_hash", "possible_starts", "conservative_nano_usd", "immutable"], "properties": { "campaign_id": { "const": "infinium.m1-s6.finite-live-campaign/ff2d542a-04f0-448a-bcb8-a0ecbedde5b9" }, "final_event_hash": { "const": "282c97151dbdcd354288b67f96c4b01d7f7ef43b1bbfb9f247cbd9b510506de9" }, "possible_starts": { "const": 1 }, "conservative_nano_usd": { "const": 140000000 }, "immutable": { "const": true } } },
    "credential_inheritance": { "type": "object", "additionalProperties": false, "required": ["access_authority_id", "access_authority_path", "access_authority_sha256", "manifest_id", "manifest_path", "manifest_sha256", "profile_id", "generation_id", "target_fingerprint_sha256", "permitted_boundary"], "properties": { "access_authority_id": { "$ref": "#/$defs/identity" }, "access_authority_path": { "$ref": "#/$defs/path" }, "access_authority_sha256": { "$ref": "#/$defs/sha256" }, "manifest_id": { "$ref": "#/$defs/identity" }, "manifest_path": { "$ref": "#/$defs/path" }, "manifest_sha256": { "$ref": "#/$defs/sha256" }, "profile_id": { "$ref": "#/$defs/identity" }, "generation_id": { "$ref": "#/$defs/identity" }, "target_fingerprint_sha256": { "$ref": "#/$defs/sha256" }, "permitted_boundary": { "const": "masked-helper-exact-CredReadW-CredFree-only" } } },
    "stage_sources": { "type": "object", "additionalProperties": false, "required": ["source_set_id", "path", "sha256"], "properties": { "source_set_id": { "$ref": "#/$defs/identity" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "limits": { "type": "object", "additionalProperties": false, "required": ["maximum_slice_nano_usd", "historical_committed_nano_usd", "remaining_nano_usd", "per_stage_start_limit", "per_attempt_cost_limit", "automatic_retry", "parallel_calls", "first_structurally_valid_response"], "properties": { "maximum_slice_nano_usd": { "const": 10000000000 }, "historical_committed_nano_usd": { "const": 250080000 }, "remaining_nano_usd": { "const": 9749920000 }, "per_stage_start_limit": { "type": "null" }, "per_attempt_cost_limit": { "type": "null" }, "automatic_retry": { "const": false }, "parallel_calls": { "const": false }, "first_structurally_valid_response": { "const": "permanent-stage-authority-stop-further-provider-starts" } } },
    "ordered_stages": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "oneOf": [{ "$ref": "#/$defs/wp9" }, { "$ref": "#/$defs/wp10" }, { "$ref": "#/$defs/wp11" }] } }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "wp9": { "type": "object", "additionalProperties": false, "required": ["ordinal", "work_package", "operation"], "properties": { "ordinal": { "const": 1 }, "work_package": { "const": "WP9" }, "operation": { "const": "Qualification" } } },
    "wp10": { "type": "object", "additionalProperties": false, "required": ["ordinal", "work_package", "operation"], "properties": { "ordinal": { "const": 2 }, "work_package": { "const": "WP10" }, "operation": { "const": "SourceClaimExtraction" } } },
    "wp11": { "type": "object", "additionalProperties": false, "required": ["ordinal", "work_package", "operation"], "properties": { "ordinal": { "const": 3 }, "work_package": { "const": "WP11" }, "operation": { "const": "CandidateInvestigation" } } }
  }
}
