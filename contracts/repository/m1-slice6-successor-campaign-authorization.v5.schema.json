{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.repository.m1-slice6-successor-campaign-authorization/5.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "campaign_id", "status", "prepared_at_utc", "expires_at_utc", "owner_amendment", "terminal_predecessor", "credential_inheritance", "limits", "ordered_stages"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-successor-campaign-authorization/5.0.0" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["owner-authorized-review-pending", "owner-authorized-reviewed-and-admitted"] },
    "prepared_at_utc": { "type": "string", "format": "date-time" },
    "expires_at_utc": { "type": "string", "format": "date-time" },
    "owner_amendment": {
      "type": "object", "additionalProperties": false,
      "required": ["amendment_id", "path", "sha256", "owner_acceptance_ceremony"],
      "properties": { "amendment_id": { "$ref": "#/$defs/identity" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" }, "owner_acceptance_ceremony": { "const": "satisfied-by-exact-owner-message-no-second-ceremony" } }
    },
    "terminal_predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "final_event_hash", "possible_starts", "conservative_nano_usd", "immutable"],
      "properties": { "campaign_id": { "const": "infinium.m1-s6.finite-live-campaign/ff2d542a-04f0-448a-bcb8-a0ecbedde5b9" }, "final_event_hash": { "const": "282c97151dbdcd354288b67f96c4b01d7f7ef43b1bbfb9f247cbd9b510506de9" }, "possible_starts": { "const": 1 }, "conservative_nano_usd": { "const": 140000000 }, "immutable": { "const": true } }
    },
    "credential_inheritance": {
      "type": "object", "additionalProperties": false,
      "required": ["access_authority_id", "access_authority_path", "access_authority_sha256", "manifest_id", "manifest_path", "manifest_sha256", "profile_id", "generation_id", "target_fingerprint_sha256", "permitted_boundary"],
      "properties": {
        "access_authority_id": { "$ref": "#/$defs/identity" }, "access_authority_path": { "$ref": "#/$defs/path" }, "access_authority_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_id": { "$ref": "#/$defs/identity" }, "manifest_path": { "$ref": "#/$defs/path" }, "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "profile_id": { "$ref": "#/$defs/identity" }, "generation_id": { "$ref": "#/$defs/identity" }, "target_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "permitted_boundary": { "const": "masked-helper-exact-CredReadW-CredFree-only" }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_possible_starts_per_stage", "terminal_wp9_possible_starts", "maximum_slice_nano_usd", "terminal_conservative_nano_usd", "maximum_successor_nano_usd", "automatic_retry", "parallel_calls", "first_structurally_valid_response"],
      "properties": {
        "maximum_possible_starts_per_stage": { "const": 5 }, "terminal_wp9_possible_starts": { "const": 1 },
        "maximum_slice_nano_usd": { "const": 10000000000 }, "terminal_conservative_nano_usd": { "const": 140000000 },
        "maximum_successor_nano_usd": { "const": 9860000000 }, "automatic_retry": { "const": false },
        "parallel_calls": { "const": false },
        "first_structurally_valid_response": { "const": "permanent-stage-authority-stop-further-provider-starts" }
      }
    },
    "ordered_stages": {
      "type": "array", "items": { "oneOf": [
        { "$ref": "#/$defs/wp9" }, { "$ref": "#/$defs/wp10" }, { "$ref": "#/$defs/wp11" }
      ] }, "minItems": 3, "maxItems": 3
    }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$" },
    "wp9": { "type": "object", "additionalProperties": false, "required": ["ordinal", "work_package", "maximum_lineage_starts", "maximum_successor_starts", "maximum_nano_usd_per_start"], "properties": { "ordinal": { "const": 1 }, "work_package": { "const": "WP9" }, "maximum_lineage_starts": { "const": 5 }, "maximum_successor_starts": { "const": 4 }, "maximum_nano_usd_per_start": { "const": 140000000 } } },
    "wp10": { "type": "object", "additionalProperties": false, "required": ["ordinal", "work_package", "maximum_lineage_starts", "maximum_successor_starts", "maximum_nano_usd_per_start"], "properties": { "ordinal": { "const": 2 }, "work_package": { "const": "WP10" }, "maximum_lineage_starts": { "const": 5 }, "maximum_successor_starts": { "const": 5 }, "maximum_nano_usd_per_start": { "const": 600000000 } } },
    "wp11": { "type": "object", "additionalProperties": false, "required": ["ordinal", "work_package", "maximum_lineage_starts", "maximum_successor_starts", "maximum_nano_usd_per_start"], "properties": { "ordinal": { "const": 3 }, "work_package": { "const": "WP11" }, "maximum_lineage_starts": { "const": 5 }, "maximum_successor_starts": { "const": 5 }, "maximum_nano_usd_per_start": { "const": 600000000 } } }
  }
}
