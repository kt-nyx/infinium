{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.repository.m1-slice6-successor-credential-access/2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "authority_id", "status", "expires_at_utc", "owner_amendment", "retained_profile", "retained_product_state", "accepted_enrollment_evidence", "per_attempt_boundary"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-successor-credential-access/2.0.0" },
    "authority_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["review-pending", "reviewed-and-admitted"] },
    "expires_at_utc": { "type": "string", "format": "date-time" },
    "owner_amendment": { "$ref": "#/$defs/pathDigest" },
    "retained_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "manifest_path", "manifest_sha256", "profile_id", "generation_id", "target_fingerprint_sha256"],
      "properties": {
        "manifest_id": { "$ref": "#/$defs/identity" }, "manifest_path": { "$ref": "#/$defs/path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }, "profile_id": { "$ref": "#/$defs/identity" },
        "generation_id": { "$ref": "#/$defs/identity" }, "target_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "retained_product_state": {
      "type": "object", "additionalProperties": false,
      "required": ["source_root_absolute", "successor_root_absolute", "snapshot_origin_path", "snapshot_origin_sha256", "safety_identifier_projection", "reuse_disposition"],
      "properties": {
        "source_root_absolute": { "type": "string", "minLength": 3, "maxLength": 500, "pattern": "^[^\\r\\n]+$" },
        "successor_root_absolute": { "type": "string", "minLength": 3, "maxLength": 500, "pattern": "^[^\\r\\n]+$" },
        "snapshot_origin_path": { "const": "successor-snapshot-origin.v1.json" },
        "snapshot_origin_sha256": { "$ref": "#/$defs/sha256" },
        "safety_identifier_projection": { "$ref": "#/$defs/sha256" },
        "reuse_disposition": { "const": "verified-successor-snapshot-only-source-immutable" }
      }
    },
    "accepted_enrollment_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "evidence_sha256", "acceptance_path", "acceptance_sha256"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identity" }, "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "acceptance_path": { "$ref": "#/$defs/path" }, "acceptance_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "per_attempt_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["masked_helper_only", "exact_native_call_order", "maximum_reads", "maximum_frees", "maximum_writes", "maximum_deletes", "enumeration", "exposure", "replacement"],
      "properties": {
        "masked_helper_only": { "const": true },
        "exact_native_call_order": { "const": ["CredReadW", "CredFree"] },
        "maximum_reads": { "const": 1 }, "maximum_frees": { "const": 1 },
        "maximum_writes": { "const": 0 }, "maximum_deletes": { "const": 0 },
        "enumeration": { "const": "prohibited" }, "exposure": { "const": "prohibited" },
        "replacement": { "const": "prohibited" }
      }
    }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$" },
    "pathDigest": { "type": "object", "additionalProperties": false, "required": ["amendment_id", "path", "sha256"], "properties": { "amendment_id": { "$ref": "#/$defs/identity" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
