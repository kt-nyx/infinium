{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/m1-slice6-c2-official-document-snapshot.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "retrieved_window_utc", "sources", "accepted_profile", "pricing", "data_and_cache", "drift_policy"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-c2-official-document-snapshot/1.0.0" },
    "retrieved_window_utc": { "type": "object", "additionalProperties": false, "required": ["first", "last"], "properties": { "first": { "$ref": "#/$defs/utc" }, "last": { "$ref": "#/$defs/utc" } } },
    "sources": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/source" } },
    "accepted_profile": { "type": "object", "additionalProperties": false, "required": ["model", "api", "reasoning_effort", "structured_outputs", "store", "service_tier", "stream", "provider_tools", "context_window_tokens", "maximum_input_tokens", "maximum_output_tokens"], "properties": { "model": { "const": "gpt-5.6-sol" }, "api": { "const": "responses" }, "reasoning_effort": { "const": "medium" }, "structured_outputs": { "const": true }, "store": { "const": false }, "service_tier": { "const": "default" }, "stream": { "const": false }, "provider_tools": { "const": "none" }, "context_window_tokens": { "const": 1050000 }, "maximum_input_tokens": { "const": 922000 }, "maximum_output_tokens": { "const": 128000 } } },
    "pricing": { "type": "object", "additionalProperties": false, "required": ["currency", "nano_usd_per_token", "long_context_threshold_tokens", "long_context_input_multiplier", "long_context_output_multiplier", "budget_class"], "properties": { "currency": { "const": "USD" }, "nano_usd_per_token": { "const": { "ordinary_input": 5000, "cache_read": 500, "cache_write": 6250, "output": 30000 } }, "long_context_threshold_tokens": { "const": 272000 }, "long_context_input_multiplier": { "const": 2 }, "long_context_output_multiplier": { "const": 1.5 }, "budget_class": { "const": "short-context-cache-write-worst-case-no-assumed-hit" } } },
    "data_and_cache": { "type": "object", "additionalProperties": false, "required": ["response_storage", "background", "batch", "prompt_cache_mode", "prompt_cache_key", "cache_budget_assumption", "retention_claim"], "properties": { "response_storage": { "const": "disabled-store-false" }, "background": { "const": false }, "batch": { "const": false }, "prompt_cache_mode": { "const": "explicit-with-no-breakpoints" }, "prompt_cache_key": { "const": null }, "cache_budget_assumption": { "const": "no-hit-assumed-cover-cache-write-price" }, "retention_claim": { "const": "no-zero-data-retention-claim-owner-account-controls-remain-provider-account-facts" } } },
    "drift_policy": { "type": "object", "additionalProperties": false, "required": ["pre_effect_revalidation", "migration", "price_increase", "capability_conflict", "source_domains"], "properties": { "pre_effect_revalidation": { "const": "required-immediately-before-each-effect" }, "migration": { "const": "prohibited-without-owner-decision" }, "price_increase": { "const": "reduce-within-ceilings-or-stop-never-raise" }, "capability_conflict": { "const": "stop-affected-path-for-owner-decision" }, "source_domains": { "const": ["developers.openai.com", "platform.openai.com"] } } }
  },
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": { "type": "object", "additionalProperties": false, "required": ["name", "url", "retrieved_at_utc", "bytes", "sha256"], "properties": { "name": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https://(developers|platform)\\.openai\\.com/" }, "retrieved_at_utc": { "$ref": "#/$defs/utc" }, "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha" } } }
  }
}
