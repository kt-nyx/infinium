{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/source-claim-execution-input.v2.schema.json",
  "title": "infinium.llm.source-claim-execution-input/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "package_id", "acquisition_run_id", "operation_id", "host_authorization_id", "owner_kind", "owner_id", "parent_analysis_run_id", "application_scope_id", "cost_attribution_scope_id", "source_revision_id", "declared_purpose", "prompt_id", "prompt_fingerprint", "applicability_facts", "passages"],
  "properties": {
    "schema_id": { "const": "infinium.llm.source-claim-execution-input/v2" },
    "schema_version": { "const": "2" },
    "package_id": { "type": "string", "minLength": 1 }, "acquisition_run_id": { "type": "string", "minLength": 1 }, "operation_id": { "type": "string", "minLength": 1 }, "host_authorization_id": { "type": "string", "minLength": 1 }, "owner_kind": { "const": "evidence-acquisition-run" }, "owner_id": { "type": "string", "minLength": 1 }, "parent_analysis_run_id": { "type": "string", "minLength": 1 }, "application_scope_id": { "type": "string", "minLength": 1 }, "cost_attribution_scope_id": { "type": "string", "minLength": 1 }, "source_revision_id": { "type": "string", "minLength": 1 }, "declared_purpose": { "type": "string", "minLength": 1, "maxLength": 1024 }, "prompt_id": { "const": "infinium.m1-s6.source-claim-prompt/v1" }, "prompt_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "applicability_facts": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/applicability_fact" } },
    "passages": { "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": { "$ref": "#/$defs/passage" } }
  },
  "$defs": {
    "applicability_fact": { "type": "object", "additionalProperties": false, "required": ["fact_id", "source_revision_id", "statement", "statement_sha256"], "properties": { "fact_id": { "type": "string", "minLength": 1 }, "source_revision_id": { "type": "string", "minLength": 1 }, "statement": { "type": "string", "minLength": 1, "maxLength": 1024 }, "statement_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "passage": {
      "type": "object", "additionalProperties": false,
      "required": ["passage_id", "source_revision_id", "start_byte", "end_byte", "text_sha256", "deleted"],
      "properties": { "passage_id": { "type": "string", "minLength": 1 }, "source_revision_id": { "type": "string", "minLength": 1 }, "start_byte": { "type": "integer", "minimum": 0 }, "end_byte": { "type": "integer", "minimum": 0 }, "text": { "type": "string", "minLength": 1, "maxLength": 16384 }, "text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "deleted": { "type": "boolean" }, "deletion_receipt_id": { "type": "string", "minLength": 1 }, "gap_id": { "type": "string", "minLength": 1 } },
      "allOf": [
        { "if": { "properties": { "deleted": { "const": true } } }, "then": { "required": ["deletion_receipt_id", "gap_id"], "not": { "required": ["text"] } }, "else": { "required": ["text"] } }
      ]
    }
  }
}
