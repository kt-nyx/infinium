{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/source-claim-context.v2.schema.json",
  "title": "infinium.llm.source-claim-context/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "acquisition_run_id", "source_revision_id", "selection_policy", "applicability_fact_ids", "applicability_fact_sha256", "retained_passage_ids", "audit_only_passage_ids", "text_sha256", "audit_text_sha256"],
  "properties": {
    "schema_id": { "const": "infinium.llm.source-claim-context/v2" }, "schema_version": { "const": "2" }, "acquisition_run_id": { "type": "string", "minLength": 1 }, "source_revision_id": { "type": "string", "minLength": 1 }, "selection_policy": { "const": "retained-text-with-deletion-audit-in-declared-order/v2" }, "applicability_fact_ids": { "$ref": "#/$defs/single_id" }, "applicability_fact_sha256": { "$ref": "#/$defs/single_fingerprint" },
    "retained_passage_ids": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "audit_only_passage_ids": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "text_sha256": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "audit_text_sha256": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
  },
  "$defs": { "single_id": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "single_fingerprint": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
}
