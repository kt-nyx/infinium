{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.repository.m1-slice6-development-campaign-amendment/8.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "amendment_id", "status", "owner_authority_source", "retained_wp9_failure", "retained_replacement_evidence", "retained_replacement_review", "correction", "ledger_predecessor", "replacement", "preserved_boundaries", "authorized_at_utc"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.m1-slice6-development-campaign-amendment/8.0.0" },
    "amendment_id": { "$ref": "#/$defs/id" },
    "status": { "const": "owner-authorized-credential-replacement-generation-3" },
    "owner_authority_source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "const": "current-owner-task-message" },
        "summary": { "const": "use the confirmed-working fresh key through the masked credential enrollment surface" }
      }
    },
    "retained_wp9_failure": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence", "accepted_review", "observed_submitted_character_length", "owner_confirmed_expected_character_length"],
      "properties": {
        "evidence": { "$ref": "#/$defs/bindingPath" },
        "accepted_review": { "$ref": "#/$defs/bindingPath" },
        "observed_submitted_character_length": { "const": 91 },
        "owner_confirmed_expected_character_length": { "const": 164 }
      }
    },
    "retained_replacement_evidence": { "$ref": "#/$defs/bindingPath" },
    "retained_replacement_review": { "$ref": "#/$defs/bindingPath" },
    "correction": {
      "type": "object", "additionalProperties": false,
      "required": ["defect_id", "implementation_commit", "exact_character_length", "exact_utf8_byte_length", "canonical_alphabet", "bearer_byte_preservation"],
      "properties": {
        "defect_id": { "const": "successor-v6-credential-entry-and-bearer-byte-preservation" },
        "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "exact_character_length": { "const": 164 },
        "exact_utf8_byte_length": { "const": 164 },
        "canonical_alphabet": { "const": "ASCII letters digits hyphen underscore with sk- prefix" },
        "bearer_byte_preservation": { "const": "exact-successor-only-header-admission-required" }
      }
    },
    "ledger_predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "sequence", "event_hash", "committed_nano_usd", "outstanding_nano_usd"],
      "properties": {
        "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" },
        "sequence": { "const": 44 }, "event_hash": { "$ref": "#/$defs/sha" },
        "committed_nano_usd": { "const": 1020640000 }, "outstanding_nano_usd": { "const": 0 }
      }
    },
    "replacement": {
      "type": "object", "additionalProperties": false,
      "required": ["predecessor_generation_ordinal", "successor_generation_ordinal", "helper_launches", "assignment_kind", "automatic_retry", "enumeration", "overwrite", "dns_resolutions", "network_operations", "provider_operations", "billable_operations"],
      "properties": {
        "predecessor_generation_ordinal": { "const": 2 }, "successor_generation_ordinal": { "const": 3 },
        "helper_launches": { "const": 1 }, "assignment_kind": { "const": "Replace" },
        "automatic_retry": { "const": false }, "enumeration": { "const": "prohibited" },
        "overwrite": { "const": "prohibited-new-target-only" },
        "dns_resolutions": { "const": 0 }, "network_operations": { "const": 0 },
        "provider_operations": { "const": 0 }, "billable_operations": { "const": 0 }
      }
    },
    "preserved_boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["hard_budget_nano_usd", "historical_evidence_immutable", "secret_isolation", "private_answer_isolation", "exposure", "slice7"],
      "properties": {
        "hard_budget_nano_usd": { "const": 10000000000 }, "historical_evidence_immutable": { "const": true },
        "secret_isolation": { "const": true }, "private_answer_isolation": { "const": true },
        "exposure": { "const": "prohibited" }, "slice7": { "const": "not-authorized" }
      }
    },
    "authorized_at_utc": { "$ref": "#/$defs/canonicalZ" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$" },
    "bindingPath": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "canonicalZ": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" }
  }
}
