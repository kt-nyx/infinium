{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinium.m1-s6.successor-authoritative-recovery/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recovery_id", "campaign_id", "campaign_manifest_sha256", "stage", "attempt_id", "original_evidence_id", "original_evidence_sha256", "provider_effect_used", "raw_response_sha256", "response_headers_sha256", "accounting", "semantic", "recovered_at_utc"],
  "properties": {
    "schema": { "const": "infinium.m1-s6.successor-authoritative-recovery/v1" },
    "recovery_id": { "$ref": "#/$defs/id" },
    "campaign_id": { "$ref": "#/$defs/id" },
    "campaign_manifest_sha256": { "$ref": "#/$defs/sha" },
    "stage": { "enum": ["Qualification", "SourceClaimExtraction", "CandidateInvestigation"] },
    "attempt_id": { "$ref": "#/$defs/id" },
    "original_evidence_id": { "$ref": "#/$defs/id" },
    "original_evidence_sha256": { "$ref": "#/$defs/sha" },
    "provider_effect_used": { "const": false },
    "raw_response_sha256": { "$ref": "#/$defs/sha" },
    "response_headers_sha256": { "$ref": "#/$defs/sha" },
    "accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_id", "operation_id", "attempt_id", "request_id", "dispatch_fence_id", "response_id", "usage_entry_id", "settlement_id", "replay_edge_id"],
      "properties": {
        "authorization_id": { "$ref": "#/$defs/id" }, "operation_id": { "$ref": "#/$defs/id" },
        "attempt_id": { "$ref": "#/$defs/id" }, "request_id": { "$ref": "#/$defs/id" },
        "dispatch_fence_id": { "$ref": "#/$defs/id" }, "response_id": { "$ref": "#/$defs/id" },
        "usage_entry_id": { "$ref": "#/$defs/id" }, "settlement_id": { "$ref": "#/$defs/id" },
        "replay_edge_id": { "$ref": "#/$defs/id" }
      }
    },
    "semantic": {
      "type": "object", "additionalProperties": false,
      "required": ["validation_id", "disposition", "result_sha256", "proposal_count", "admission_count", "provenance"],
      "properties": {
        "validation_id": { "$ref": "#/$defs/id" }, "disposition": { "$ref": "#/$defs/id" },
        "result_sha256": { "$ref": "#/$defs/sha" },
        "proposal_count": { "type": "integer", "minimum": 0 },
        "admission_count": { "type": "integer", "minimum": 0 },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["source_acquisition_id", "source_admission_id", "admitted_artifact_id", "source_application_link_id", "evidence_application_link_id", "candidate_id", "hypothesis_id"],
          "properties": {
            "source_acquisition_id": { "$ref": "#/$defs/optionalId" },
            "source_admission_id": { "$ref": "#/$defs/optionalId" },
            "admitted_artifact_id": { "$ref": "#/$defs/optionalId" },
            "source_application_link_id": { "$ref": "#/$defs/optionalId" },
            "evidence_application_link_id": { "$ref": "#/$defs/optionalId" },
            "candidate_id": { "$ref": "#/$defs/optionalId" },
            "hypothesis_id": { "$ref": "#/$defs/optionalId" }
          }
        }
      }
    },
    "recovered_at_utc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "optionalId": { "type": "string", "maxLength": 256, "pattern": "^(?:|[A-Za-z0-9._:/-]+)$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
