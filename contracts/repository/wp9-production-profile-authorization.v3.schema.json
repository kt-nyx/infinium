      "properties": {
        "close_ready_implementation_commit": { "$ref": "#/$defs/gitSha" },
        "accepted_wp8_verification_commit": { "const": "cc14bf60f78c80280cb6eafe60fddaf2bc764d06" },
        "accepted_wp8_evidence_commit": { "const": "baef115cdd43fa38d0a352c15f8ba44cbfa35312" },
        "accepted_wp8_non_live_all_sha256": { "const": "52aa77325a2226505c35b1fba6d9d0fe2b6354022a6c85f6652211d609c529ad" },
        "accepted_wp8_pre_live_sha256": { "const": "e5f0ca42e44e6a4ea4f98bf4aab0c1bf6769c436c51aecc32a01e22a3db5f567" },
        "accepted_wp8_direct_layer6_sha256": { "const": "4b0b661575b14c681e59d2097abca5a04cfa9baecea3837b7acef7d07e0227b5" }
      }
    },
    "predecessorBinding": {
      "type": "object", "additionalProperties": false,
