        "independent_review_record": { "const": "WP9_PROFILE_REVIEW_ACCEPTANCE candidate_commit=<exact-reviewed-candidate> manifest_id=<manifest_id> sha256=<manifest_sha256> verdicts=security,semantics,diff" },
        "scope": { "const": "exactly-one-new-production-profile-enrollment-and-verification-effect" },
        "inheritance": { "const": "prohibited" },
        "qualification_request_authority": { "const": "none-separate-fresh-manifest-and-owner-acceptance-required-after-profile-success" }
      }
    },
    "providerIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "purpose", "account_identity_id", "billing_scope_identity_id", "account_authority", "billing_scope_authority", "provider_request_permitted"],
      "properties": {
        "provider": { "const": "openai" },
        "purpose": { "const": "user-owned-platform-api-inference" },
        "account_identity_id": { "const": "openai-account-owner-confirmed-at-enrollment" },
        "billing_scope_identity_id": { "const": "openai-direct-usage-owner-confirmed-at-enrollment" },
        "account_authority": { "const": "owner-confirms-intended-openai-platform-account-at-manual-entry" },
        "billing_scope_authority": { "const": "owner-confirms-direct-usage-priced-platform-api-at-manual-entry" },
        "provider_request_permitted": { "const": false }
      }
    },
    "officialDocumentRefresh": {
      "type": "object", "additionalProperties": false,
      "required": ["retrieved_at_utc", "documents", "confirmed_profile", "catalog_binding", "drift_follow_up"],
      "properties": {
        "retrieved_at_utc": { "type": "string", "pattern": "^2026-08-(18|19)T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
        "documents": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/documentIdentity" } },
        "confirmed_profile": { "$ref": "#/$defs/confirmedProfile" },
        "catalog_binding": { "$ref": "#/$defs/catalogBinding" },
        "drift_follow_up": { "$ref": "#/$defs/driftFollowUp" }
      }
    },
    "documentIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "url", "final_url", "retrieved_at_utc", "bytes", "sha256", "content_type", "etag", "last_modified"],
      "properties": {
        "name": { "enum": ["model", "latest-model", "prompt-caching", "reasoning", "structured-outputs", "safety-best-practices"] },
        "url": { "type": "string", "pattern": "^https://developers\\.openai\\.com/" },
        "final_url": { "type": "string", "pattern": "^https://developers\\.openai\\.com/" },
        "retrieved_at_utc": { "type": "string", "pattern": "^2026-08-(18|19)T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "content_type": { "const": "text/markdown; charset=utf-8" },
        "etag": { "type": ["string", "null"] },
        "last_modified": { "type": ["string", "null"] }
      }
    },
    "confirmedProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "api", "structured_outputs", "prompt_caching", "context_window_tokens", "maximum_input_tokens", "maximum_output_tokens", "standard_short_prices_nano_usd_per_token", "long_context_threshold_tokens", "long_context_input_multiplier", "long_context_output_multiplier", "planned_request_context_band"],
      "properties": {
        "model": { "const": "gpt-5.6-sol" },
        "api": { "const": "responses" },
        "structured_outputs": { "const": true },
        "prompt_caching": { "const": true },
        "context_window_tokens": { "const": 1050000 },
        "maximum_input_tokens": { "const": 922000 },
        "maximum_output_tokens": { "const": 128000 },
        "standard_short_prices_nano_usd_per_token": { "const": { "ordinary_input": 5000, "cache_read": 500, "cache_write": 6250, "output": 30000 } },
        "long_context_threshold_tokens": { "const": 272000 },
        "long_context_input_multiplier": { "const": 2 },
        "long_context_output_multiplier": { "const": 1.5 },
        "planned_request_context_band": { "const": "below-272000-conservative-standard-price-ceiling" }
      }
    },
    "catalogBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_fingerprint_sha256", "price_fingerprint_sha256", "catalog_context_limit_tokens", "catalog_disposition"],
      "properties": {
        "capability_fingerprint_sha256": { "const": "7faad3537392728deb5866fed0c0ce5582bc93e765940718139705cc2991f667" },
        "price_fingerprint_sha256": { "const": "77107d07be03e55121c4d1de092ff5efd3cef565aeaef8359c051824aca12726" },
        "catalog_context_limit_tokens": { "const": 272000 },
        "catalog_disposition": { "const": "unchanged-conservative-standard-price-ceiling-below-advertised-window" }
      }
    },
    "driftFollowUp": {
      "type": "object", "additionalProperties": false,
      "required": ["finding", "credential_profile_change", "profile_packet_blocked", "provider_request_packet_blocked", "required_authority"],
      "properties": {
        "finding": { "const": "latest-model-guidance-recommends-stable-privacy-preserving-safety_identifier-for-apps-serving-individual-end-users" },
        "credential_profile_change": { "const": "none-closed-provider-profile-unchanged" },
        "profile_packet_blocked": { "const": false },
        "provider_request_packet_blocked": { "const": true },
        "required_authority": { "const": "owner-or-accepted-plan-resolution-before-any-wp9-transport-qualification-request-manifest" }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "access_profile_id", "generation_id", "generation_ordinal", "revocation_epoch", "display_label", "target_derivation", "target_fingerprint_sha256", "target_encoding", "preflight_requirement"],
      "properties": {
        "mode": { "const": "new-only" },
        "access_profile_id": { "const": "openai-platform-ecd3de4b9fac443593347905970d942d" },
        "generation_id": { "const": "g-6eefeaf6e4a74273bf4ee69f02449f47" },
        "generation_ordinal": { "const": 1 },
        "revocation_epoch": { "const": 0 },
        "display_label": { "const": "OpenAI Platform API (M1 Slice 6)" },
        "target_derivation": { "const": "Infinium:<access_profile_id>:<generation_id>" },
        "target_fingerprint_sha256": { "const": "990e46a57687417a1a1865bab3b11823f3b37d35961fb8101e32a8977e2a4b67" },
        "target_encoding": { "const": "utf-8" },
        "preflight_requirement": { "const": "exact-CredReadW-ERROR_NOT_FOUND-or-stop-no-write" }
      }
    },
    "nativeBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_call_order", "exact_results", "exact_collision_order", "exact_collision_results", "maximum_calls", "enumeration", "fallback", "overwrite", "delete"],
      "properties": {
        "exact_call_order": { "const": ["CredReadW", "CredWriteW", "CredReadW", "CredFree"] },
        "exact_results": { "const": ["ERROR_NOT_FOUND", "success", "success", "released"] },
        "exact_collision_order": { "const": ["CredReadW", "CredFree"] },
        "exact_collision_results": { "const": ["success", "released"] },
        "maximum_calls": { "const": { "CredWriteW": 1, "CredReadW": 2, "CredDeleteW": 0, "CredFree": 1, "total": 4 } },
        "enumeration": { "const": "prohibited" },
        "fallback": { "const": "none" },
        "overwrite": { "const": "prohibited" },
        "delete": { "const": "not-authorized" }
      }
    },
    "m1EntrySurface": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "owner", "presentation", "masked", "paste_permitted", "renderer_receives_or_retains_secret", "manual_value", "readiness_deadline_seconds", "response_deadline_seconds", "readiness_requirements", "pre_readiness_input", "input_bound", "cleanup_requirements", "cancel_result"],
      "properties": {
        "purpose": { "const": "m1-native-boundary-production-enrollment-only-not-final-product-settings-ui" },
        "owner": { "const": "one-shot-credential-helper" },
        "presentation": { "const": "direct-helper-owned-native-modal" },
        "masked": { "const": true },
        "paste_permitted": { "const": true },
        "renderer_receives_or_retains_secret": { "const": false },
        "manual_value": { "const": "owner-owned-real-openai-api-key-only-after-exact-authorization-never-test-or-dummy-value" },
        "readiness_deadline_seconds": { "const": 10 },
        "response_deadline_seconds": { "const": 600 },
        "readiness_requirements": { "const": ["visible", "helper-process-owned", "same-session", "input-desktop", "not-cloaked", "on-monitor", "enabled", "edit-focused", "foreground", "active", "initially-and-currently-blank", "message-pump-active"] },
        "pre_readiness_input": { "const": "ignore-action-drain-and-clear-edit-content-before-readiness" },
        "input_bound": { "const": "live-character-length-1-through-2560-and-utf8-byte-length-1-through-2560-no-truncation" },
        "cleanup_requirements": { "const": ["set-native-edit-empty", "verify-native-edit-empty", "clear-managed-char-buffer", "clear-secret-bytes", "destroy-window-and-verify", "join-sta-thread", "terminate-contained-process-tree"] },
        "cancel_result": { "const": "typed-cancel-no-write-no-profile-activation-no-dispatch" }
      }
    },
    "futureProductUx": {
      "type": "object", "additionalProperties": false,
      "required": ["slice", "flow", "parenting", "secret_owner", "renderer_receives_or_retains_secret", "implemented_by_wp9"],
      "properties": {
        "slice": { "const": "M2" },
        "flow": { "const": "Settings -> Add/Replace API key -> WPF-parented helper-owned masked modal" },
        "parenting": { "const": "WPF-parented" },
        "secret_owner": { "const": "one-shot-credential-helper" },
        "renderer_receives_or_retains_secret": { "const": false },
        "implemented_by_wp9": { "const": false }
      }
    },
    "durableState": {
      "type": "object", "additionalProperties": false,
      "required": ["product_state_root_relative", "initial_state", "success_state", "verification_state", "required_intent_sequence", "active_unverified_request_gate", "cancel_state", "unavailable_or_ambiguous_state", "retention"],
      "properties": {
        "product_state_root_relative": { "const": "artifacts/m1-slice6/wp9-production-profile-state" },
        "initial_state": { "const": "pending-enrollment" },
        "success_state": { "const": "active-verified" },
        "verification_state": { "const": "available" },
        "required_intent_sequence": { "const": ["enroll:pending-enrollment->active-unverified", "verify:active-unverified->active-verified"] },
        "active_unverified_request_gate": { "const": "reject" },
        "cancel_state": { "const": "pending-enrollment-no-native-write" },
        "unavailable_or_ambiguous_state": { "const": "block-all-provider-requests-until-fresh-authorized-recovery" },
        "retention": { "const": "retain-exact-generation-through-wp11-no-delete-authority" }
      }
    },
    "releaseBuild": {
      "type": "object", "additionalProperties": false,
      "required": ["configuration", "target_framework", "source_commit", "build_command", "coordinator_relative_path", "coordinator_sha256", "helper_relative_path", "helper_sha256", "binary_inventory_pattern", "binary_inventory_file_count", "binary_inventory_sha256"],
      "properties": {
        "configuration": { "const": "Release" },
        "target_framework": { "const": "net10.0" },
        "source_commit": { "$ref": "#/$defs/gitSha" },
        "build_command": { "type": "string", "pattern": "^dotnet build Infinium\\.sln -c Release --no-restore --nologo --no-incremental -p:SourceRevisionId=[0-9a-f]{40}$" },
        "coordinator_relative_path": { "const": "src/Infinium.Coordinator/bin/Release/net10.0/Infinium.Coordinator.exe" },
        "coordinator_sha256": { "$ref": "#/$defs/sha256" },
        "helper_relative_path": { "const": "src/Infinium.Coordinator/bin/Release/net10.0/CredentialHelper/Infinium.CredentialHelper.exe" },
        "helper_sha256": { "$ref": "#/$defs/sha256" },
        "binary_inventory_pattern": { "const": "sorted-relative-path-lf-sha256-for-all-exe-dll-deps-json-and-runtimeconfig-json-under-coordinator-release-root" },
        "binary_inventory_file_count": { "type": "integer", "minimum": 0, "maximum": 500 },
        "binary_inventory_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["output_root_relative", "must_be_absent", "secret_permitted", "raw_target_permitted", "required_receipts", "typed_failure_receipt", "terminal_receipt_rule"],
      "properties": {
        "output_root_relative": { "const": "artifacts/m1-slice6/wp9-profile" },
        "must_be_absent": { "const": true },
        "secret_permitted": { "const": false },
        "raw_target_permitted": { "const": false },
        "required_receipts": { "const": ["profile-enrollment-evidence.json", "profile-enrollment-summary.txt", "authority-lock.json"] },
        "typed_failure_receipt": { "const": "profile-enrollment-failure.json" },
        "terminal_receipt_rule": { "const": "success-retains-three-required-receipts; every cancel-collision-timeout-native-or-evidence-failure-also-retains-typed-failure-receipt" }
      }
    },
    "stopConditions": {
      "type": "object", "additionalProperties": false,
      "required": ["missing_or_stale_acceptance", "expired", "dirty_or_wrong_candidate", "existing_target", "cancel", "native_failure", "partial_or_ambiguous_effect", "network_or_provider_activity", "unexpected_call"],
      "properties": {
        "missing_or_stale_acceptance": { "const": "stop-before-helper-launch" },
        "expired": { "const": "stop-before-helper-launch" },
        "dirty_or_wrong_candidate": { "const": "stop-before-helper-launch" },
        "existing_target": { "const": "stop-after-read-success-and-paired-free-no-write" },
        "cancel": { "const": "stop-no-write-no-dispatch" },
        "native_failure": { "const": "stop-no-retry" },
        "partial_or_ambiguous_effect": { "const": "stop-block-provider-request-require-fresh-recovery-authority" },
        "network_or_provider_activity": { "const": "stop-fail" },
        "unexpected_call": { "const": "stop-fail-no-retry" }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "ordinary_verifier_invocation", "credential_native_operation", "provider_operation", "qualification_request_manifest"],
      "properties": {
        "command": { "const": "powershell -NoProfile -ExecutionPolicy Bypass -File eng/run-m1-slice6-credential.ps1 -Operation EnrollOrVerifyProfile -AuthorizationManifest docs/plans/milestones/m1/slices/s6/wp9-production-profile-authorization.v3.json -CampaignManifest docs/plans/milestones/m1/slices/s6/m1-slice6-finite-campaign-authorization.v3.json -CampaignReviewedCandidate <c1.1-implementation-commit> -CampaignLedger artifacts/m1-slice6/wp9-profile/finite-campaign-ledger.v1.jsonl -ProductStateRoot artifacts/m1-slice6/wp9-production-profile-state -CoordinatorBinary <bound-coordinator-binary> -RuntimeAuthorityManifest <accepted-runtime-authority-manifest> -RuntimeAuthoritySha256 <accepted-runtime-authority-sha256> -OutputRoot artifacts/m1-slice6/wp9-profile" },
        "ordinary_verifier_invocation": { "const": "prohibited" },
        "credential_native_operation": { "const": "requires-exact-owner-acceptance-not-yet-granted" },
        "provider_operation": { "const": "prohibited" },
        "qualification_request_manifest": { "const": "not-materialized-by-this-packet" }
      }
    }
  }
}
