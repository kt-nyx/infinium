    "prepared_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "expires_at_utc": { "const": "2026-08-31T23:00:00.0000000Z" },
    "candidate_binding": { "$ref": "#/$defs/candidateBinding" },
    "predecessor_binding": { "$ref": "#/$defs/predecessorBinding" },
    "owner_authorization": { "$ref": "#/$defs/ownerAuthorization" },
    "provider_intent": { "$ref": "#/$defs/providerIntent" },
    "official_document_refresh": { "$ref": "#/$defs/officialDocumentRefresh" },
    "profile": { "$ref": "#/$defs/profile" },
    "native_boundary": { "$ref": "#/$defs/nativeBoundary" },
    "m1_entry_surface": { "$ref": "#/$defs/m1EntrySurface" },
    "future_product_ux": { "$ref": "#/$defs/futureProductUx" },
    "durable_state": { "$ref": "#/$defs/durableState" },
    "release_build": { "$ref": "#/$defs/releaseBuild" },
    "output": { "$ref": "#/$defs/output" },
    "stop_conditions": { "$ref": "#/$defs/stopConditions" },
    "execution": { "$ref": "#/$defs/execution" }
  },
  "$defs": {
