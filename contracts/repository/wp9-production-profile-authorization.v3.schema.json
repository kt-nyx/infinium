      "properties": {
        "wp8_template_schema": { "const": "infinium.repository.wp8-production-profile-authorization-template/1.0.0" },
        "wp8_template_packet_id": { "const": "infinium.m1-s6.wp8.pre-live-profile-authorization-template/v1" },
        "wp8_template_inheritance": { "const": "prohibited-materialized-fresh-exact-packet" },
        "research_0054_sha256": { "const": "bf585dee726ab386ca27570829e29ce51c3060a001e4a4749797357fd301c68a" }
      }
