{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infinium.dev/repository/wp4-credential-native-recovery.ad876b9a.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "manifest_id", "status", "effect_authority", "prepared_at_utc", "expires_at_utc", "binding", "disposable_namespace", "native_boundary", "limits", "cleanup_contract", "execution_command"],
  "properties": {
    "schema_identity": { "const": "infinium.repository.wp4-credential-native-recovery/1.1.0" },
    "manifest_id": { "const": "infinium.m1-s6.wp4.credential-native-recovery/df29a608-cc46-4151-bb0b-1a03acb1cdff" },
    "status": { "enum": ["draft-binding-pending", "ready-for-owner-acceptance"] },
    "effect_authority": { "const": "none-until-standing-cleanup-authority-is-bound-to-exact-reviewed-bytes" },
    "prepared_at_utc": { "type": "string", "format": "date-time" },
    "expires_at_utc": { "type": "string", "format": "date-time" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed_manifest_id", "failed_manifest_sha256", "failure_record_commit", "terminal_evidence_sha256", "prior_exact_absence_count", "consumed_lock_sha256", "close_ready_recovery_commit", "required_branch"],
      "properties": {
        "failed_manifest_id": { "const": "infinium.m1-s6.wp4.credential-native-authorization/ad876b9a-9f45-4eb4-8d12-5970d76dd4ea" },
        "failed_manifest_sha256": { "const": "7d1e8c35072c6676258c9cbcc47fd8833458878bf289728cc453e5e0942d35ce" },
        "failure_record_commit": { "const": "2efba7c96ce356c5d4687a27e115ff802ec6b42f" },
        "terminal_evidence_sha256": { "const": "cfaee3940cd780a5bcfbcbcf387124d7f7385b01a07f8f0f6fbe4439593a21e6" },
        "prior_exact_absence_count": { "const": 10 },
        "consumed_lock_sha256": { "const": "b47e0262937f86174ae1b790f4951fbf6fe6621d1f3a25c938990143514950b8" },
        "close_ready_recovery_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "required_branch": { "const": "codex/m1-s6" }
      }
    },
    "disposable_namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace_id", "reuse", "targets"],
      "properties": {
        "namespace_id": { "const": "m1-s6-wp4-native-ad876b9a-9f45-4eb4-8d12-5970d76dd4ea" },
        "reuse": { "const": "cleanup-only; never requalification; terminal after this recovery attempt" },
        "targets": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["alias", "access_profile_id", "generation_id", "target_fingerprint_sha256"],
              "properties": {
                "alias": { "const": "backup-new" },
                "access_profile_id": { "const": "m1s6-wp4-ad876b9a9f454eb48d125970d76dd4ea-backup-restore" },
                "generation_id": { "const": "g002" },
                "target_fingerprint_sha256": { "const": "d9221f7aac7ababf9e3efbf6ef69b03d2e9c8b0f51c1c552862958d5f3eff061" }
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["alias", "access_profile_id", "generation_id", "target_fingerprint_sha256"],
              "properties": {
                "alias": { "const": "fake-dispatch" },
                "access_profile_id": { "const": "m1s6-wp4-ad876b9a9f454eb48d125970d76dd4ea-fake-dispatch" },
                "generation_id": { "const": "g001" },
                "target_fingerprint_sha256": { "const": "c27212cc4f0720e9fd20f7a2aff397402257bd53ad6d568048b217ac3e3df963" }
              }
            }
          ],
          "items": false
        }
      }
    },
    "native_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_calls", "forbidden", "fallback", "ui", "provider"],
      "properties": {
        "allowed_calls": { "const": ["CredReadW", "CredDeleteW", "CredFree"] },
        "forbidden": { "const": ["CredWriteW", "CredEnumerateW", "any prefix/arbitrary target", "any alternate store"] },
        "fallback": { "const": "none" }, "ui": { "const": "none" }, "provider": { "const": "none" }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_clock_seconds", "targets", "CredReadW", "CredDeleteW", "CredFree", "total_native_calls", "attempts"],
      "properties": {
        "wall_clock_seconds": { "const": 120 }, "targets": { "const": 2 },
        "CredReadW": { "const": 6 }, "CredDeleteW": { "const": 2 },
        "CredFree": { "const": 2 }, "total_native_calls": { "const": 10 }, "attempts": { "const": 1 }
      }
    },
    "cleanup_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["success", "combined_absence", "ambiguity", "network_operations", "dns_operations", "provider_operations", "billable_operations"],
      "properties": {
        "success": { "const": "each fingerprint ends with exact ERROR_NOT_FOUND and canonical trace/free pairing" },
        "combined_absence": { "const": "combine this two-target terminal proof only with the immutable ten-target exact absence evidence bound above; all 12 namespace targets must then be proven absent" },
        "ambiguity": { "const": "stop immediately; no later native call; namespace remains blocked forever" },
        "network_operations": { "const": 0 }, "dns_operations": { "const": 0 },
        "provider_operations": { "const": 0 }, "billable_operations": { "const": 0 }
      }
    },
    "execution_command": { "type": "string", "minLength": 1 }
  }
}
