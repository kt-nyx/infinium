<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <RootNamespace>Infinium.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)TestRepository.cs" Link="TestRepository.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)BethesdaSemanticTestSnapshot.cs" Link="BethesdaSemanticTestSnapshot.cs" />
  </ItemGroup>
</Project>
