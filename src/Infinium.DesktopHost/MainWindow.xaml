<Window x:Class="Infinium.DesktopHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Infinium Desktop Diagnostics" Width="1050" Height="720"
        MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="CancelTransportButton" Grid.Row="0" Margin="8" Padding="10,6"
            HorizontalAlignment="Left" Content="Cancel active renderer operation"
            AutomationProperties.Name="Cancel active renderer operation" Click="OnCancelTransportClick" />
    <TextBlock x:Name="RuntimeNotice" Grid.Row="1" Margin="24" TextWrapping="Wrap"
               FontSize="16" AutomationProperties.Name="Desktop runtime status"
               Text="Starting the local diagnostic renderer…" />
    <wv2:WebView2 x:Name="Browser" Grid.Row="1" Visibility="Collapsed"
                  AutomationProperties.Name="Infinium diagnostic application"
                  Focusable="True" />
  </Grid>
</Window>
